{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "external_directory": {
      "*": "allow"
    },
    "edit": {
      "*": "ask",
      ".remediate-code/**": "allow",
      ".audit-tools/**": "allow"
    },
    "bash": {
      "*": "allow",
      "remediate-code": "allow",
      "remediate-code ensure*": "allow",
      "*remediate-code.mjs* ensure*": "allow",
      "remediate-code next-step*": "allow",
      "*remediate-code.mjs* next-step*": "allow",
      "remediate-code prepare-implement-dispatch*": "allow",
      "*remediate-code.mjs* prepare-implement-dispatch*": "allow",
      "remediate-code merge-implement-results*": "allow",
      "*remediate-code.mjs* merge-implement-results*": "allow",
      "remediate-code accept-node*": "allow",
      "*remediate-code.mjs* accept-node*": "allow",
      "remediate-code validate*": "allow",
      "*remediate-code.mjs* validate*": "allow",
      "*remediate-code.mjs": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "grep *": "allow",
      "Select-String *": "allow",
      "rm *": "deny"
    }
  },
  "agent": {
    "remediator": {
      "description": "Remediation orchestration agent for the /remediate-code workflow.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "external_directory": {
          "*": "allow"
        },
        "edit": {
          "*": "ask",
          ".remediate-code/**": "allow",
          ".audit-tools/**": "allow"
        },
        "bash": {
          "*": "allow",
          "remediate-code": "allow",
          "remediate-code ensure*": "allow",
          "*remediate-code.mjs* ensure*": "allow",
          "remediate-code next-step*": "allow",
          "*remediate-code.mjs* next-step*": "allow",
          "remediate-code prepare-implement-dispatch*": "allow",
          "*remediate-code.mjs* prepare-implement-dispatch*": "allow",
          "remediate-code merge-implement-results*": "allow",
          "*remediate-code.mjs* merge-implement-results*": "allow",
          "remediate-code accept-node*": "allow",
          "*remediate-code.mjs* accept-node*": "allow",
          "remediate-code validate*": "allow",
          "*remediate-code.mjs* validate*": "allow",
          "*remediate-code.mjs": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "grep *": "allow",
          "Select-String *": "allow",
          "rm *": "deny"
        },
        "remediator_*": "allow",
        "question": "allow",
        "task": "allow"
      }
    }
  }
}
