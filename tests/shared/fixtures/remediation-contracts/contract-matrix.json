{
  "contract_version": "zero-adapter-remediation-contract-matrix/v1",
  "immutable": true,
  "foundation_module": "remediation-contract-tests",
  "command_defaults": {
    "cwd": ".",
    "normalized_environment": {
      "CI": "1",
      "NO_COLOR": "1",
      "TZ": "UTC"
    }
  },
  "approved_defaults": {
    "session_intent": {
      "canonical_path": ".audit-tools/audit/session-config.json",
      "absent_result": {
        "status": "not_configured",
        "intent": {
          "review_mode": "attended",
          "observability": "standard"
        }
      },
      "configured_status": "configured",
      "accepted_keys": [
        "observability",
        "review_mode"
      ],
      "review_mode_values": [
        "attended",
        "autonomous"
      ],
      "observability_values": [
        "standard",
        "verbose"
      ],
      "invalid_present_behavior": "path-qualified-error-without-fallback",
      "maximum_filesystem_reads": 1
    },
    "remediation_planning": {
      "membership_source": "shared-content-coherence/findings-projection",
      "token_estimate_basis": "canonical-unique-physical-file-bytes-plus-finding-count",
      "token_estimate_effect": "advisory-only",
      "backend_fit": false,
      "transport_sizing": false
    }
  },
  "coherence_policy": {
    "evidence_classes": {
      "call_import_reference_adjacency": 70,
      "same_directory": 10,
      "shared_critical_flow": 60,
      "shared_file": 100,
      "shared_semantic_tag_or_same_lens": 30,
      "shared_unit": 80
    },
    "graph_kind_aliases": {
      "shared_file": [
        "cross_lens_same_file",
        "shared_file"
      ],
      "shared_unit": [
        "same_unit"
      ],
      "call_import_reference_adjacency": [
        "call_adjacent"
      ],
      "shared_critical_flow": [
        "same_flow"
      ],
      "shared_semantic_tag_or_same_lens": [
        "same_lens"
      ],
      "same_directory": [
        "same_dir"
      ]
    },
    "threshold": 60,
    "pair_score_rule": "sum-each-boolean-evidence-class-at-most-once",
    "candidate_order": [
      "score-desc",
      "min-item-id-code-unit-asc",
      "max-item-id-code-unit-asc"
    ],
    "merge_predicate": "roots-differ",
    "canonical_root": "lexicographically-smallest-minimum-member-id",
    "final_member_order": "item-id-code-unit-asc",
    "final_component_order": "minimum-member-id-code-unit-asc",
    "consumer_role": "projection-only",
    "capacity_or_annotation_veto": false,
    "golden_trace": {
      "eligible_candidates": [
        {
          "left": "a",
          "right": "c",
          "score": 120
        },
        {
          "left": "a",
          "right": "b",
          "score": 110
        },
        {
          "left": "d",
          "right": "e",
          "score": 70
        }
      ],
      "merge_decisions": [
        "merge",
        "merge",
        "merge"
      ],
      "components": [
        [
          "a",
          "b",
          "c"
        ],
        [
          "d",
          "e"
        ]
      ]
    }
  },
  "gate_profiles": [
    {
      "id": "whole-repository-v1",
