 const git = (args, timeout) => gitIn(ROOT, args, timeout);
 
+// The directory whose git state a check must read when the check is about
+// THIS SESSION's position relative to a remote — never ROOT unconditionally.
+// CLAUDE_PROJECT_DIR always names the main checkout; a session working in a
+// linked worktree has its OWN HEAD, which can disagree with the main
+// checkout's HEAD in either direction. Reading ROOT there reports a stale-main
+// verdict for the wrong tree (open-bugs, 2026-10-06: a worktree level with
+// `origin/main` still read "N commit(s) BEHIND" because the main checkout's
+// local HEAD was the one actually behind). Fail open to ROOT whenever the
+// payload cwd is missing, gone, or not a worktree of this same repository —
+// this mirrors the stale-agent-worktrees leg below, which already trusts
+// payload.cwd for the session's own tree.
+function resolveSessionGitDir() {
+  const cwd = typeof payload?.cwd === 'string' && payload.cwd ? payload.cwd : null;
+  if (!cwd || !existsSync(cwd)) return ROOT;
+  const probe = gitIn(cwd, ['rev-parse', '--is-inside-work-tree'], 5_000);
+  return probe.ok && probe.stdout === 'true' ? cwd : ROOT;
+}
+const SESSION_GIT_DIR = resolveSessionGitDir();
+
