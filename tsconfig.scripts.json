{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "audit-tools/shared": ["./src/shared/index.ts"],
      "audit-tools/shared/*": ["./src/shared/*.ts"]
    },
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.js",
    "wrapper/**/*.mjs",
    "wrapper/**/*.js",
    ".claude/hooks/**/*.mjs",
    "dispatch/**/*.mjs",
    "audit-code.mjs",
    "remediate-code.mjs"
  ]
}
