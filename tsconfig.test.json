{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "audit-tools/shared": ["./src/shared/index.ts"],
      "audit-tools/shared/*": ["./src/shared/*.ts"]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "tests"]
}
