+
+describe("session config schema versioning", () => {
+  test("detects version mismatch and logs warning", async () => {
+    const warnSpy = vi.spyOn(console, "warn").mockImplementation(() => {});
+    try {
+      const { REPO_SESSION_INTENT_SCHEMA_VERSION } = await import(
+        "../../src/shared/types/sessionConfig.js"
+      );
+
+      // Config with mismatched version
+      const outdatedVersion = "audit-tools/session-config/v0";
+      await writeFile(
+        join(root, "session-config.json"),
+        JSON.stringify({ schema_version: outdatedVersion }),
+      );
+
+      const eff = await loadRemediateSessionConfig({
+        root,
+        artifactsFirst: false,
+        ambient: ambient(),
+      });
+
+      // Should still load even with version mismatch
+      expect(eff).toBeDefined();
+
+      // Should have logged warning
+      expect(warnSpy).toHaveBeenCalled();
+      const warnMsg = warnSpy.mock.calls[0]?.[0]?.toString() ?? "";
+      expect(warnMsg).toContain("schema version mismatch");
+      expect(warnMsg).toContain(outdatedVersion);
+      expect(warnMsg).toContain(REPO_SESSION_INTENT_SCHEMA_VERSION);
+    } finally {
+      warnSpy.mockRestore();
+    }
+  });
+
+  test("treats missing schema_version as v1 (initial version)", async () => {
+    const warnSpy = vi.spyOn(console, "warn").mockImplementation(() => {});
+    try {
+      // Config without schema_version (pre-versioning format)
+      await writeFile(
+        join(root, "session-config.json"),
+        JSON.stringify({ synthesis: { narrative: true } }),
+      );
+
+      const eff = await loadRemediateSessionConfig({
+        root,
+        artifactsFirst: false,
+        ambient: ambient(),
+      });
+
+      // Should load without warning (missing = v1 is treated as current)
+      expect(eff).toBeDefined();
+      expect(eff?.synthesis).toEqual({ narrative: true });
+      expect(warnSpy).not.toHaveBeenCalled();
+    } finally {
+      warnSpy.mockRestore();
+    }
+  });
+
+  test("no warning when schema_version matches current version", async () => {
+    const warnSpy = vi.spyOn(console, "warn").mockImplementation(() => {});
+    try {
+      const { REPO_SESSION_INTENT_SCHEMA_VERSION } = await import(
+        "../../src/shared/types/sessionConfig.js"
+      );
+
+      await writeFile(
+        join(root, "session-config.json"),
+        JSON.stringify({
+          schema_version: REPO_SESSION_INTENT_SCHEMA_VERSION,
+          synthesis: { narrative: true },
+        }),
+      );
+
+      const eff = await loadRemediateSessionConfig({
+        root,
+        artifactsFirst: false,
+        ambient: ambient(),
+      });
+
+      expect(eff).toBeDefined();
+      expect(warnSpy).not.toHaveBeenCalled();
+    } finally {
+      warnSpy.mockRestore();
+    }
+  });
+});
