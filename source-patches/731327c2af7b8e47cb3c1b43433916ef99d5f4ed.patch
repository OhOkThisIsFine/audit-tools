+// ---------------------------------------------------------------------------
+// CP-NODE-2-f01 obligation 3 / CDC-012: state.closing_plan.custom_command trust
+// boundary. custom_command is spawned at close.ts:845-846 with no allowlist
+// check. The finding requires the decision to be RECORDED — either (a) the
+// spawn is routed through CP-NODE-4's `isAllowedAnchorCommand` gate
+// (src/shared/tooling/allowlistedExec.ts), or (b) an explicit exemption naming
+// close.ts:845-846 with its rationale is recorded in the source. Resolution by
+// omission (neither) is forbidden — this contract test fails on silence.
+// ---------------------------------------------------------------------------
+
+describe("close.ts source — custom_command trust boundary is RECORDED (CP-NODE-2-f01 / CDC-012)", () => {
+  const CLOSE_TS_PATH = join(__dirname, "..", "..", "src", "remediate", "phases", "close.ts");
+
+  /**
+   * The decision is recorded when the text around the 'custom' action branch
+   * contains EITHER evidence of a gate call (isAllowedAnchorCommand) OR an
+   * exemption comment that both names the site (close.ts:845-846) and reads as
+   * an exemption/rationale, not an incidental mention.
+   */
+  function customCommandTrustDecisionRecorded(src: string): boolean {
+    const anchor = src.indexOf('action === "custom"');
+    if (anchor === -1) return false;
+    const window = src.slice(Math.max(0, anchor - 1200), anchor + 600);
+    const hasGate = /isAllowedAnchorCommand\(/.test(window);
+    const hasExemption =
+      /exemption/i.test(window) && /close\.ts:845-846/.test(window);
+    return hasGate || hasExemption;
+  }
+
+  it("sanity: the checker locates the real 'custom' action branch in close.ts", () => {
+    const src = readFileSync(CLOSE_TS_PATH, "utf8");
+    expect(src).toContain('action === "custom"');
+  });
+
+  it("the shipped close.ts records the trust-boundary decision (gate or exemption) for custom_command", () => {
+    const src = readFileSync(CLOSE_TS_PATH, "utf8");
+    expect(customCommandTrustDecisionRecorded(src)).toBe(true);
+  });
+
+  it("RED: recognizes a gated-spawn branch as satisfying the check", () => {
+    const gated = `
+      } else if (action === "custom" && state.closing_plan!.custom_command?.length) {
+        if (!isAllowedAnchorCommand(state.closing_plan!.custom_command)) {
+          throw new Error("refused");
+        }
+        run(state.closing_plan!.custom_command[0], state.closing_plan!.custom_command.slice(1));
+      }
+    `;
+    expect(customCommandTrustDecisionRecorded(gated)).toBe(true);
+  });
+
+  it("RED: neither a gate nor a recorded exemption fails the check", () => {
+    const neither = `
+      } else if (action === "custom" && state.closing_plan!.custom_command?.length) {
+        // no gate, no exemption comment at all
+        run(state.closing_plan!.custom_command[0], state.closing_plan!.custom_command.slice(1));
+      }
+    `;
+    expect(customCommandTrustDecisionRecorded(neither)).toBe(false);
+  });
+
+  it("RED: a bare mention of the citation without exemption language does not satisfy the check", () => {
+    const incidental = `
+      // see close.ts:845-846 for details
+      } else if (action === "custom" && state.closing_plan!.custom_command?.length) {
+        run(state.closing_plan!.custom_command[0], state.closing_plan!.custom_command.slice(1));
+      }
+    `;
+    expect(customCommandTrustDecisionRecorded(incidental)).toBe(false);
+  });
+});
