+// ---------------------------------------------------------------------------
+// INV-remediate-phases-11: close.ts carries no closingResult.status==="success"
+// literal comparison outside closingActionCompleted itself. closingActionCompleted
+// is the single-sourced completion classification (COR-fb656e3f) the verification
+// trace, the report-level verdict, and the artifact-cleanup gate all key on; a
+// second hand-rolled `=== "success"` comparison elsewhere is the exact class of
+// drift that classification exists to prevent (CP-NODE-2-f01).
+// ---------------------------------------------------------------------------
+
+describe("close.ts source — INV-remediate-phases-11: single-sourced completion classification", () => {
+  const CLOSE_TS_PATH = join(__dirname, "..", "..", "src", "remediate", "phases", "close.ts");
+
+  /** The one legitimate declaration site, stripped before scanning for strays. */
+  const CLOSING_ACTION_COMPLETED_FN = /export function closingActionCompleted\([\s\S]*?\n\}\n/;
+
+  /**
+   * True when a `closingResult.status === "success"` (or `'success'`) literal
+   * comparison exists ANYWHERE in `src` outside closingActionCompleted's own body.
+   */
+  function hasStrayStatusComparison(src: string): boolean {
+    const withoutFn = src.replace(CLOSING_ACTION_COMPLETED_FN, "");
+    return /closingResult\.status\s*===\s*["']success["']/.test(withoutFn);
+  }
+
+  it("sanity: the stripped region really is closingActionCompleted and really contains the comparison", () => {
+    const src = readFileSync(CLOSE_TS_PATH, "utf8");
+    const fnMatch = src.match(CLOSING_ACTION_COMPLETED_FN);
+    expect(fnMatch, "closingActionCompleted must exist in close.ts").not.toBeNull();
+    expect(fnMatch![0]).toContain("export function closingActionCompleted");
+    expect(fnMatch![0]).toMatch(/closingResult\.status\s*===\s*"success"/);
+  });
+
+  it("the shipped close.ts carries no stray closingResult.status==='success' comparison", () => {
+    const src = readFileSync(CLOSE_TS_PATH, "utf8");
+    expect(hasStrayStatusComparison(src)).toBe(false);
+  });
+
+  it("RED: the check detects a reintroduced literal comparison outside closingActionCompleted", () => {
+    const src = readFileSync(CLOSE_TS_PATH, "utf8");
+    const regressed = src.replace(
+      "export function closingActionCompleted",
+      `function bogusDuplicateCheck(closingResult: ClosingResult) { return closingResult.status === "success"; }\nexport function closingActionCompleted`,
+    );
+    expect(hasStrayStatusComparison(regressed)).toBe(true);
+  });
+});
+
+// ---------------------------------------------------------------------------
+// INV-remediate-phases-12: runClosePhase does not preview-gate 'merge-to-base'
+// or 'custom' — PREVIEW_ACTIONS is exactly {commit, push, open-pr, publish}, so
+// both run immediately on the first next-step call even when pre_authorized is
+// entirely unset (CP-NODE-2-f01 obligation 3 — custom_command trust boundary
+// depends on this: it is NOT gated behind an operator confirmation step).
+// ---------------------------------------------------------------------------
+
+describe("runClosePhase — INV-remediate-phases-12: 'merge-to-base' and 'custom' run immediately (no preview) with pre_authorized unset", () => {
+  const REPO_DIR = scratchDir(".test-phases-inv-12-repo");
+  const ARTIFACTS_DIR = join(REPO_DIR, ".audit-tools", "remediation");
+  const BASE_OPTIONS = { root: REPO_DIR, artifactsDir: ARTIFACTS_DIR };
+
+  function makeClosingState(overrides: Record<string, unknown> = {}) {
+    return makeState({
+      status: "closing",
+      plan: {
+        plan_id: "P-INV12",
+        findings: [],
+        blocks: [],
+        project_type: "unknown",
+        candidate_closing_actions: ["none"],
+      },
+      closing_plan: { action: "none" },
+      ...overrides,
+    });
+  }
+
+  beforeEach(async () => {
+    await rm(REPO_DIR, { recursive: true, force: true });
+    await mkdir(ARTIFACTS_DIR, { recursive: true });
+    execSync("git init", { cwd: REPO_DIR });
+    execSync("git config user.email test@test.com", { cwd: REPO_DIR });
+    execSync("git config user.name Test", { cwd: REPO_DIR });
+    writeFileSync(join(REPO_DIR, "init.txt"), "init");
+    execSync("git add . && git commit -m init", { cwd: REPO_DIR });
+  });
+
+  afterEach(async () => {
+    await rm(REPO_DIR, { recursive: true, force: true });
+  });
+
+  it("action='custom' with pre_authorized UNSET actually spawns custom_command (no preview pause)", async () => {
+    const marker = join(REPO_DIR, "custom-ran.txt");
+    const state = makeClosingState({
+      closing_plan: {
+        action: "custom",
+        // pre_authorized deliberately absent — proves 'custom' is not gated on it.
+        custom_command: [
+          process.execPath,
+          "-e",
+          `require("fs").writeFileSync(${JSON.stringify(marker)}, "ran")`,
+        ],
+      },
+    });
+    const next = await runClosePhase(state, BASE_OPTIONS);
+    // Reached complete in one call — never paused at a confirmation preview.
+    expect(next.status).toBe("complete");
+    expect(next.closing_plan!.closing_action_preview).toBeUndefined();
+    // The command genuinely executed (not merely "not blocked").
+    expect(existsSync(marker)).toBe(true);
+  });
+
+  it("action='merge-to-base' with pre_authorized UNSET is not preview-gated (reaches complete, not a preview pause)", async () => {
+    const state = makeClosingState({
+      closing_plan: { action: "merge-to-base" }, // pre_authorized deliberately absent
+    });
+    const next = await runClosePhase(state, BASE_OPTIONS);
+    // merge-to-base is absent from PREVIEW_ACTIONS, so it runs straight to
+    // execution — no recorded base sidecar in this fixture means the merge
+    // itself comes back 'skipped', but the run must still reach 'complete'
+    // in one call, never pause on a confirmation preview.
+    expect(next.status).toBe("complete");
+    expect(next.closing_plan!.closing_action_preview).toBeUndefined();
+  });
+});
