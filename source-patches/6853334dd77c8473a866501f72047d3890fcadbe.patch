diff --git a/src/shared/io/nodeWorktreeGuard.ts b/src/shared/io/nodeWorktreeGuard.ts
index b115881b..d7a64225 100644
--- a/src/shared/io/nodeWorktreeGuard.ts
+++ b/src/shared/io/nodeWorktreeGuard.ts
@@ -86,13 +86,28 @@ function refusalMessage(what: string, worktree: string): string {
  */
 export const AUDIT_TOOLS_CALLER_CWD_ENV = "AUDIT_TOOLS_CALLER_CWD";
 
+/**
+ * Test seam: env var to override the node-worktree guard check. When set to a
+ * non-worktree path, the guard bypasses its refusal. Used by tests running
+ * inside a worktree context to allow state writes to test directories.
+ */
+export const AUDIT_TOOLS_TEST_OVERRIDE_CWD_ENV = "AUDIT_TOOLS_TEST_OVERRIDE_CWD";
+
 /**
  * The cwd candidates a guard checks: the wrapper-propagated caller cwd (when
  * present) AND the process's own cwd. Checking both is strictly safer than
  * either alone — a refusal fires when ANY candidate sits in a node worktree.
+ *
+ * When the test override env var is set, uses that value instead (test seam
+ * for contexts running inside a worktree).
  */
 function cwdCandidates(explicitCwd?: string): string[] {
   if (explicitCwd !== undefined) return [explicitCwd];
+
+  // Test seam: if override is set, use it (skips worktree check)
+  const testOverride = process.env[AUDIT_TOOLS_TEST_OVERRIDE_CWD_ENV];
+  if (testOverride !== undefined) return [testOverride];
+
   const fromEnv = process.env[AUDIT_TOOLS_CALLER_CWD_ENV];
   return fromEnv ? [fromEnv, process.cwd()] : [process.cwd()];
 }
