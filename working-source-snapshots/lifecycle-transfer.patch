+  const actual = await original<typeof import('node:fs/promises')>();
+  return { ...actual,
+    open: (async (...args: Parameters<typeof actual.open>) => {
+      if (hook.readOwner && String(args[0]).endsWith('race.lock')) hook.readOwner();
+      return actual.open(...args);
+    }) as typeof actual.open,
+    writeFile: (async (...args: Parameters<typeof actual.writeFile>) => {
+      if (hook.claim && String(args[0]).endsWith('.steal')) await hook.claim();
+      return actual.writeFile(...args);
+    }) as typeof actual.writeFile,
+    unlink: (async (...args: Parameters<typeof actual.unlink>) => {
+      if (hook.unlink && String(args[0]).endsWith('race.lock')) await hook.unlink();
+      return actual.unlink(...args);
+    }) as typeof actual.unlink,
+  };
+});
+import { readFile } from 'node:fs/promises';
+import { acquireLock, releaseLock, withFileLock, FileLockTimeoutError } from '../../src/shared/io/fileLock.js';
+import { RunLogger } from '../../src/shared/observability/runLog.js';
+function gate() { let resolve!: () => void; const promise = new Promise<void>(done => { resolve = done; }); return { resolve, promise }; }
+
+test('a delayed reaper never deletes the successor admitted by another reaper', async () => {
+  await withTempDir(async (dir: string) => {
+    const path = join(dir, 'race.lock');
+    const dead = await abandonedLock(path);
+    if (!await automaticRecoveryAvailable(path)) {
+      await expect(acquireLock(path, 0)).rejects.toBeInstanceOf(FileLockTimeoutError);
+      expect(await readFile(path, 'utf8')).toBe(dead); return;
+    }
+    const paused = gate(), resume = gate();
+    hook.claim = async () => { hook.claim = undefined; paused.resolve(); await resume.promise; };
+    const slow = acquireLock(path, 300).then(value => ({ value }), (error: unknown) => ({ error }));
+    await paused.promise;
+    try {
+      await withFileLock(path, async assertOwnership => {
+        const successor = await readFile(path, 'utf8');
+        const reread = gate();
+        hook.readOwner = () => { hook.readOwner = undefined; reread.resolve(); };
+        resume.resolve();
+        await Promise.race([reread.promise, slow.then(() => { throw new Error('Delayed reaper never reread successor'); })]);
+        expect(await slow).toHaveProperty('error.name', 'FileLockTimeoutError');
+        await assertOwnership();
+        expect(await readFile(path, 'utf8')).toBe(successor);
+      }, 1000);
+    } finally { resume.resolve(); hook.claim = undefined; hook.readOwner = undefined; await slow; }
+  });
+});
+
