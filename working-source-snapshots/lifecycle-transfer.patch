+    const unknown = JSON.stringify({ contract_version: "remediate-code-state/v2", status: "implementing", plan: { plan_id: "legacy" } });
+    await writeFile(join(artifactsDir, "state.json"), unknown);
+    await expect(decideNextStep({ root, artifactsDir })).rejects.toThrow();
+    expect(await readFile(join(artifactsDir, "state.json"), "utf8")).toBe(unknown);
+  });
+
+  it("does not silently recreate a deleted checkpoint from preserved issued evidence", async () => {
