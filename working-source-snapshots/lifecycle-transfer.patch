+  await withTempDir(async (dir: string) => {
+    const path = join(dir, 'race.lock'), log = join(dir, 'events.jsonl');
+    const dead = await abandonedLock(path);
+    hook.unlink = async () => { throw Object.assign(new Error('synthetic unlink refusal'), { code: 'EPERM' }); };
+    try {
+      await expect(acquireLock(path, 0, new RunLogger(log))).rejects.toBeInstanceOf(FileLockTimeoutError);
+      expect(await readFile(path, 'utf8')).toBe(dead);
+      expect(await readFile(log, 'utf8')).not.toContain('stale_lock_removed');
+    } finally { hook.unlink = undefined; }
+  });
+});
+
+test('five actual processes recover one exited owner with at most one callback active', async () => {
+  await withTempDir(async (dir: string) => {
+    const path = join(dir, 'race.lock'), dead = await abandonedLock(path);
+    if (!await automaticRecoveryAvailable(path)) {
+      await expect(acquireLock(path, 0)).rejects.toBeInstanceOf(FileLockTimeoutError);
+      expect(await readFile(path, 'utf8')).toBe(dead); return;
+    }
+    let active = 0, maximum = 0, entries = 0;
+    const workers = Array.from({ length: 5 }, () => {
+      const ready = gate();
+      const child = spawnHidden(process.execPath, ['--import', 'tsx/esm', fileURLToPath(new URL('./fixtures/file-lock-owner-worker.mjs', import.meta.url)), 'contend', path], {
+        stdio: ['ignore', 'ignore', 'pipe', 'ipc'],
+      });
+      let stderr = '';
+      child.stderr?.on('data', chunk => { stderr += String(chunk); });
+      child.on('message', message => {
+        if (message === 'ready') ready.resolve();
+        if (message === 'entered') {
+          entries++; active++; maximum = Math.max(maximum, active);
+          setTimeout(() => { if (child.connected) child.send('release'); }, 10);
+        }
+        if (message === 'leaving') active--;
+      });
+      const exit = new Promise<void>((resolve, reject) => {
+        child.on('error', reject);
+        child.on('exit', code => code === 0 ? resolve() : reject(new Error(`Owned racer exit ${code}: ${stderr}`)));
+      });
+      return { child, ready: Promise.race([ready.promise, exit.then(() => { throw new Error('Racer exited before ready'); })]), exit };
+    });
+    const watchdog = setTimeout(() => { for (const worker of workers) worker.child.kill(); }, 15_000);
+    try {
+      await Promise.all(workers.map(worker => worker.ready));
+      for (const worker of workers) worker.child.send('go');
+      await Promise.all(workers.map(worker => worker.exit));
+      expect(entries).toBe(5); expect(maximum).toBe(1); expect(active).toBe(0);
+    } finally {
+      for (const worker of workers) if (worker.child.exitCode === null && worker.child.signalCode === null) worker.child.kill();
