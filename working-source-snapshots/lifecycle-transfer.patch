+/** Real CLI adapters over fixed checkpoint evidence, with no provider or analyzer execution. */
+import { test, expect, vi } from "vitest";
+import { readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { fixedAuditFlowRun, fixedAuditInspectionRun, writeAuditInspectionSubmission } from "./helpers/lifecycleFixture.js";
+import { withTempDir } from "../shared/fileLockTestSupport.mjs";
+import { issueTasks, acceptSubmission } from "../../src/shared/engine/taskLifecycle.js";
+import { drawAuditRun } from "../../src/audit/lifecycle/auditRun.js";
+import { cmdControl, cmdRetryTask } from "../../src/audit/cli/lifecycleControlCommand.js";
+import { cmdExplainTask } from "../../src/audit/cli/explainTaskCommand.js";
+import { cmdRequeue } from "../../src/audit/cli/requeueCommand.js";
+import { cmdForceSynthesis } from "../../src/audit/cli/forceSynthesisCommand.js";
+import { cmdIntake } from "../../src/audit/cli/intakeCommand.js";
+import { cmdSynthesize } from "../../src/audit/cli/synthesizeCommand.js";
+import { cmdImportExternalAnalyzer } from "../../src/audit/cli/importExternalAnalyzerCommand.js";
+
+async function capture(command: () => Promise<void>) {
+  const log = vi.spyOn(console, "log").mockImplementation(() => {});
+  try { await command(); expect(log).toHaveBeenCalledTimes(1); return JSON.parse(String(log.mock.calls[0]![0])); }
+  finally { log.mockRestore(); }
+}
+
+test("control and exact-attempt retry use the authoritative checkpoint without replacing task premises", async () => {
+  await withTempDir(async (root: string) => {
+    const f = await fixedAuditInspectionRun(root), argv = ["--artifacts-dir", f.artifactsDir];
+    const [issued] = await issueTasks(f.store, ["inspect-0"], f.policy);
+    await capture(() => cmdControl([...argv, "--control", "paused", "--reason", "Operator pause"]));
+    expect((await f.store.read()).control).toBe("paused");
+    await expect(issueTasks(f.store, ["inspect-1"], f.policy)).rejects.toThrow(/paused/);
+    await capture(() => cmdControl([...argv, "--control", "active", "--reason", "Operator resumes"]));
+    const retried = await capture(() => cmdRetryTask([...argv, "--task-id", issued!.spec.id, "--attempt", "1", "--reason", "Abandoned host attempt"]));
+    expect(retried).toEqual({ task_id: issued!.spec.id, attempt: 2 });
+    const current = (await f.store.read()).tasks[issued!.spec.id]!;
+    expect(current.spec).toEqual(issued!.spec); expect(current.issued!.result_path).not.toBe(issued!.result_path);
+    const before = await f.store.read();
+    await expect(cmdRetryTask([...argv, "--task-id", issued!.spec.id, "--attempt", "1", "--reason", "Stale retry"])).rejects.toThrow();
+    expect(await f.store.read()).toEqual(before);
+  });
+});
+
+test("control and retry argument failures cannot mutate run control or task attempts", async () => {
+  await withTempDir(async (root: string) => {
+    const f = await fixedAuditInspectionRun(root), argv = ["--artifacts-dir", f.artifactsDir], before = await f.store.read();
+    await expect(cmdControl([...argv, "--control", "stopped", "--reason", "Invalid"])).rejects.toThrow(/control must/);
+    await expect(cmdControl([...argv, "--control", "paused"])).rejects.toThrow(/reason/);
+    await expect(cmdRetryTask([...argv, "--task-id", "inspect-0", "--attempt", "0", "--reason", "Invalid"])).rejects.toThrow(/Retry requires/);
+    expect(await f.store.read()).toEqual(before);
+  });
+});
+
+test("explain-task and requeue report accepted scope and remaining work without replanning", async () => {
+  await withTempDir(async (root: string) => {
+    const f = await fixedAuditInspectionRun(root), argv = ["--artifacts-dir", f.artifactsDir];
+    const [task] = await issueTasks(f.store, ["inspect-0"], f.policy);
+    await acceptSubmission(f.store, await writeAuditInspectionSubmission(f.store, task!), f.policy);
+    const before = await f.store.read();
+    const explained = await capture(() => cmdExplainTask([...argv, "--task-id", "inspect-0"]));
+    expect(explained.required_scope_complete).toBe(true); expect(explained.task).toEqual(before.tasks["inspect-0"]);
+    expect(explained.accepted_payload.file_coverage).toEqual([{ path: "a.ts", total_lines: 1 }]);
+    const remaining = await capture(() => cmdRequeue(argv));
+    expect(remaining.task_count).toBe(1); expect(remaining.note).toMatch(/immutable/);
+    await expect(cmdExplainTask([...argv, "--task-id", "unknown"])).rejects.toThrow(/Unknown task_id/);
+    expect(await f.store.read()).toEqual(before);
+  });
+});
+
+test("force-synthesis writes only an explicitly incomplete projection and preserves final evidence", async () => {
+  await withTempDir(async (root: string) => {
+    const f = await fixedAuditInspectionRun(root), before = await f.store.read();
+    await writeFile(join(f.artifactsDir, "audit-report.md"), "Preserved report bytes");
+    const result = await capture(() => cmdForceSynthesis(["--artifacts-dir", f.artifactsDir]));
+    expect(result.complete).toBe(false);
+    expect(await readFile(result.partial_report, "utf8")).toMatch(/Incomplete diagnostic projection[\s\S]*not a completed audit/);
+    expect(await readFile(join(f.artifactsDir, "audit-report.md"), "utf8")).toBe("Preserved report bytes");
+    expect(await f.store.read()).toEqual(before);
+  });
+});
+
+test.each([["intake", cmdIntake], ["synthesize", cmdSynthesize]] as const)("%s follows deterministic readiness and cannot issue or consume host work", async (_name, command) => {
+  await withTempDir(async (root: string) => {
+    const f = await fixedAuditFlowRun(root), argv = ["--root", root, "--artifacts-dir", f.artifactsDir];
+    expect((await capture(() => command(argv))).stopped).toBe("host");
+    expect(Object.values((await f.store.read()).tasks).some(task => task.status === "issued")).toBe(false);
+    const full = await drawAuditRun(f.store, "full"), task = full.tasks[0]!;
+    await writeFile(join(f.artifactsDir, task.result_path), "not a result envelope");
+    const before = await f.store.read();
+    expect((await capture(() => command(argv))).stopped).toBe("host");
+    expect(await f.store.read()).toEqual(before);
+    expect(await readFile(join(f.artifactsDir, task.result_path), "utf8")).toBe("not a result envelope");
+  });
+});
+
+test("external analyzer import refuses to change pinned inputs through the CLI", async () => {
+  await withTempDir(async (root: string) => {
+    const f = await fixedAuditInspectionRun(root), before = await f.store.read();
+    const argv = ["--root", root, "--artifacts-dir", f.artifactsDir];
+    await expect(cmdImportExternalAnalyzer(argv)).rejects.toThrow(/Supply --external-analyzer-results/);
+    await expect(cmdImportExternalAnalyzer([...argv, "--external-analyzer-results", join(root, "unused.json")])).rejects.toThrow(/pinned at run creation/);
+    expect(await f.store.read()).toEqual(before);
+  });
+});
