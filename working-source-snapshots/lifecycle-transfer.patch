+// Exercise the real Windows executable probe independently of installed Python.
+// This scope is synchronous and only discovers and admits commands: the inert fixture
+// file must never be spawned. Restore process state before any await or cleanup.
+function withWindowsPythonPath(path: string, check: () => void): void {
+  const platform = Object.getOwnPropertyDescriptor(process, "platform")!;
+  const previousPath = process.env.PATH;
+  try {
+    Object.defineProperty(process, "platform", { value: "win32" });
+    process.env.PATH = path;
+    check();
+  } finally {
+    Object.defineProperty(process, "platform", platform);
+    if (previousPath === undefined) delete process.env.PATH;
+    else process.env.PATH = previousPath;
+  }
+}
