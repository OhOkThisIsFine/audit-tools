+import { z } from "zod";
+
+/** Permit one transport BOM without changing immutable raw evidence or replay identity. */
+export function parseLifecycleJSON(text: string): unknown {
+  return JSON.parse(text.startsWith("\uFEFF") ? text.slice(1) : text) as unknown;
+}
+import { isAbsolute } from "node:path";
+
+const identity = z.string().min(1).max(240).regex(/^[A-Za-z0-9][A-Za-z0-9_.:-]*$/).refine(value => !["constructor", "prototype", "__proto__"].includes(value), "Reserved identity");
