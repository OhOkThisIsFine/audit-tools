+    import { once } from "node:events";
+    const { writeStepContract } = await import(${JSON.stringify(writerUrl)});
+    const { withFileLock } = await import(${JSON.stringify(lockUrl)});
+    const [root, artifactsDir, lockPath] = process.argv.slice(1);
