+import type { DrawPolicy, IssuedTask, RunStore, TaskDefinition, TaskSpec, TaskSubmission } from "../../src/shared/engine/taskLifecycleTypes.js";
+
+type Domain = { reductions: number };
+const spec = (id: string, files: string[], deps: TaskSpec["depends_on"] = []): TaskSpec => ({
+  id, kind: "coverage", phase: "preparing", depends_on: deps, inputs: {},
+  subject: { root: id, files }, completion: "complete",
+});
+const subject = (value: unknown): { root: string; files: string[] } => {
+  const v = value as { root: string; files: string[] };
+  if (!v || typeof v.root !== "string" || !Array.isArray(v.files) || !v.files.every(f => typeof f === "string")) throw new Error("Invalid coverage subject");
+  return v;
+};
+const payload = (value: unknown): { files: string[] } => {
+  const v = value as { files: string[] };
+  if (!v || !Array.isArray(v.files) || !v.files.every(f => typeof f === "string")) throw new Error("Invalid coverage payload");
+  return v;
+};
+function policy(initial: TaskSpec[]): DrawPolicy<Domain> {
+  const definition: TaskDefinition<Domain> = {
+    kind: "coverage", phase: "preparing", completion: "complete", execution: "host", effect: "read_only",
+    parseSubject: subject, parsePayload: payload, render: task => `Inspect ${subject(task.spec.subject).files.join(",")}`,
+    validate: async (task, value) => ({ errors: payload(value).files.some(f => !subject(task.spec.subject).files.includes(f)) ? ["outside scope"] : [] }),
+    requiredScopeComplete: (task, context) => {
+      const root = subject(task.spec.subject).root;
+      const covered = new Set(Object.values(context.state.tasks)
+        .filter(t => t.accepted && subject(t.spec.subject).root === root)
+        .flatMap(t => payload(context.acceptedPayloads.get(t.spec.id)).files));
+      return !!task.accepted && subject(task.spec.subject).files.every(f => covered.has(f));
+    },
+    reduce: (task, value, context) => {
+      const s = subject(task.spec.subject);
+      const remaining = s.files.filter(f => !payload(value).files.includes(f));
+      const addTasks = remaining.length && remaining.length < s.files.length ? [{ ...spec(`${task.spec.id}-remaining`, remaining, [{ task_id: task.spec.id, requires: "accepted_evidence" }]), subject: { ...s, files: remaining } }] : [];
+      return { domain: { reductions: context.state.domain.reductions + 1 }, addTasks };
+    },
+  };
+  return {
+    definitions: new Map([[definition.kind, definition]]),
+    parseDomain: value => {
+      if (typeof (value as Domain)?.reductions !== "number") throw new Error("Invalid domain");
+      return value as Domain;
+    },
+    initialTasks: () => initial,
+    phaseTransition: async () => null,
+    acceptanceGuard: async () => [],
+  };
+}
+async function setup(dir: string, p: DrawPolicy<Domain>) {
+  const io = createLifecycleIO(dir);
+  const source = await io.writeArtifact({ frozen: true });
+  const initialState = createRunState({ run_id: "run-1", mode: "audit", source, domain: { reductions: 0 } }, p);
+  return createRunStore({ directory: dir, initialState, parseDomain: p.parseDomain });
+}
+async function submit(store: RunStore<Domain>, task: IssuedTask, files: string[], outcome: TaskSubmission["outcome"] = "complete") {
+  const value: TaskSubmission = { contract_version: "audit-tools-task-result/v1", run_id: task.run_id, task_id: task.spec.id, attempt: task.attempt, binding_sha256: task.binding_sha256, outcome, payload: { files } };
+  await writeFile(join(store.io.directory, task.result_path), JSON.stringify(value));
+  return task.result_path;
+}
