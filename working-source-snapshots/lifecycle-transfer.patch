+// sites-pinned: tests/remediate/remediate-state-invariants.test.ts, tests/remediate/pinned-lifecycle-entrypoint.test.ts
+/** Domain facts for remediation. All task status, issue identity and acceptance live in RunState. */
+import { z } from "zod";
+import { SessionIntentV1Schema } from "audit-tools/shared";
+import { parsePlanningState } from "../contractPipeline/planningLifecycle.js";
+import { parseIntakeState, type IntakeDomain } from "../steps/taskLifecycleIntake.js";
+import type { LandingDomain } from "./taskLifecycleFacts.js";
+
+export interface RemediationDomain extends IntakeDomain, LandingDomain {
+  started_at: string;
+  session_intent: z.infer<typeof SessionIntentV1Schema>;
+}
+const DomainShape = z.object({
+  root: z.string().min(1), artifactsDir: z.string().min(1),
+  started_at: z.string().datetime(), session_intent: SessionIntentV1Schema,
+  run_start_dirty: z.array(z.string()), run_start_tree: z.string().min(1),
+  run_start_dirty_encoding: z.literal("git-z/v1"),
+  source_files: z.array(z.object({ path: z.string().min(1), sha256: z.string().regex(/^[a-f0-9]{64}$/u) }).strict()),
+  conformance_review: z.boolean(), planning: z.unknown(), intake: z.unknown(),
+}).strict();
+export function parseRemediationDomain(value: unknown): RemediationDomain {
+  const parsed = DomainShape.parse(value);
+  return { ...parsed, planning: parsePlanningState(parsed.planning), intake: parseIntakeState(parsed.intake) };
+}
