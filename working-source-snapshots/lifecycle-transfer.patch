index 00000000..56a578e7
--- /dev/null
+++ b/tests/remediate/pinned-workflow-golden.test.ts
@@ -0,0 +1,102 @@
+/** Real entrypoint and Git candidates; fixed semantic replies and no provider calls. */
+import { expect, test } from "vitest";
+import { readFile, rm, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { createLifecycleEntryFixture, oneUnitPlan } from "./helpers/lifecycleEntryFixture.js";
+import { readRunContext } from "../../src/shared/engine/taskLifecycleStore.js";
+import { execFileSyncHidden, spawnSyncHidden } from "../helpers/spawn.mjs";
+import { FINAL_VERIFICATION_TASK_ID, resolvedFinalVerification } from "../../src/remediate/steps/taskLifecycleClose.js";
+
+const oracle = JSON.parse(await readFile(new URL("../fixtures/pinned-workflow-golden/expected.json", import.meta.url), "utf8")).remediation;
+
+const greetingCheck = "node check-greeting.mjs";
+
+test.each([{ greeting: "hello", passes: true }, { greeting: "wrong", passes: false }])("golden remediation: merged-tree behavior $greeting through reviewed plan, isolated candidate and serialized landing", async ({ greeting, passes }) => {
+  let gateCalls = 0, observedHead = "", targetRoot = "";
+  const f = await createLifecycleEntryFixture({
+    verificationCommand: greetingCheck,
+    finalGateRunner: async argv => {
+      gateCalls++;
+      observedHead = execFileSyncHidden("git", ["rev-parse", "HEAD"], { cwd: targetRoot, encoding: "utf8" }).trim();
+      // Observe and execute the declared synthetic command on the merged tree.
+      const result = spawnSyncHidden(argv[0]!, argv.slice(1), { cwd: targetRoot, encoding: "utf8" });
+      return { status: result.status, error: result.error, stdout: result.stdout, stderr: result.stderr };
+    },
+  });
+  targetRoot = f.root;
+  const candidateRoot = `${f.root}-candidate`;
+  try {
+    await writeFile(join(f.root, "check-greeting.mjs"), "import assert from 'node:assert/strict';\nimport { greeting } from './index.js';\nassert.equal(greeting(), 'hello');\n");
+    f.git("add", "check-greeting.mjs");
+    f.git("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "Pin synthetic greeting assertion");
+    const requestBytes = await readFile(join(f.root, "request.md"), "utf8");
+    const plan = oneUnitPlan();
+    // Candidate syntax is not merged-tree behavioral acceptance.
+    plan.units[0]!.required_tests = ["node --check index.js"];
+    await f.approvePlan(plan);
+    const issued = await f.issued("remediation.prepare_candidate"), pinned = await f.state();
+    expect(pinned.phase).toBe("executing");
+    expect(Object.values(pinned.tasks).filter(task => task.spec.kind === "remediation.land_candidate" && task.status === "issued")).toEqual([]);
+    const basisBytes = await f.store.lifecycle().io.readArtifact(pinned.basis!);
+    const implementationBinding = issued.issued;
+    await f.next();
+    expect((await f.issued("remediation.prepare_candidate")).issued).toEqual(implementationBinding);
+    f.git("worktree", "add", "--detach", candidateRoot, "HEAD");
+    const gitCandidate = (...args: string[]) => execFileSyncHidden("git", args, { cwd: candidateRoot, encoding: "utf8" }).trim();
+    await writeFile(join(candidateRoot, "index.js"), `export function greeting() { return '${greeting}'; }\n`);
+    gitCandidate("add", "index.js");
+    gitCandidate("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "Preserve greeting behavior");
+    const candidate = gitCandidate("rev-parse", "HEAD");
+    await f.reply({ status: "candidate", candidate_commit: candidate, worktree: candidateRoot,
+      obligation_evidence: [{ obligation_id: "R1", evidence: ["index.js preserves the greeting export and hello result"] }] }, "remediation.prepare_candidate");
+    expect(gateCalls).toBe(0);
+    const landing = await f.issued("remediation.land_candidate");
+    expect(Object.values((await f.state()).tasks).filter(task => task.spec.kind === "remediation.land_candidate" && task.status === "issued")).toHaveLength(1);
+    f.git("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "cherry-pick", candidate);
+    const landedHead = f.git("rev-parse", "HEAD").trim();
+    await f.reply({ status: "landed", landed_commit: landedHead,
+      obligation_evidence: [{ obligation_id: "R1", evidence: ["Landed only the reviewed index.js change"] }] }, "remediation.land_candidate");
+    const complete = await f.state(), context = await readRunContext(f.store.lifecycle());
+    const finalEvidence = context.acceptedPayloads.get(FINAL_VERIFICATION_TASK_ID) as { gate: { passed: boolean }; observation: { head: string } };
+    expect(observedHead).toBe(landedHead);
+    expect(finalEvidence.observation.head).toBe(landedHead);
+    if (!passes) {
+      expect(finalEvidence.gate.passed).toBe(false);
+      expect(resolvedFinalVerification(context)).toBeUndefined();
+      expect(complete.phase).toBe("finalizing");
+      expect(complete.deliverables?.report).toBeUndefined();
+      expect(complete.deliverables?.outcomes).toBeUndefined();
+      expect((await f.issued("remediation.final_repair_decision")).spec.kind).toBe("remediation.final_repair_decision");
+      const calls = gateCalls;
+      await f.next();
+      expect(gateCalls).toBe(calls);
+      expect((await readRunContext(f.store.lifecycle())).state.tasks).toEqual(complete.tasks);
+      return;
+    }
+    const verified = resolvedFinalVerification(context)!;
+    expect(complete.deliverables?.report).toBeDefined();
+    expect(complete.deliverables?.outcomes).toBeDefined();
+    const report = await f.store.lifecycle().io.readArtifact(complete.deliverables!.report!);
+    const outcomes = await f.store.lifecycle().io.readArtifact(complete.deliverables!.outcomes!);
+    expect(report).toContain("merged-tree");
+    expect(outcomes).toMatchObject({ execution_outcomes: [{ unit_id: "U1", status: "resolved", landed_files: ["index.js"] }] });
+    await f.next();
+    expect(await f.state()).toEqual(complete);
+    expect(await f.store.lifecycle().io.readArtifact(complete.deliverables!.report!)).toEqual(report);
+    const observed = {
+      phase: complete.phase,
+      implementation_ids: Object.values(complete.tasks).filter(task => task.spec.kind === "remediation.prepare_candidate").map(task => task.spec.id),
+      landing_ids: Object.values(complete.tasks).filter(task => task.spec.kind === "remediation.land_candidate").map(task => task.spec.id),
+      write_scope: (landing.spec.subject as { unit: { allowed_files: string[] } }).unit.allowed_files,
+      final_gate: verified.payload.gate, final_gate_calls: gateCalls,
+      source_unchanged: await readFile(join(f.root, "request.md"), "utf8") === requestBytes,
+      basis_unchanged: JSON.stringify(await f.store.lifecycle().io.readArtifact(complete.basis!)) === JSON.stringify(basisBytes),
+    };
+    expect(observed).toEqual(oracle);
+    expect(complete.source).toEqual(pinned.source);
+    expect(complete.tasks[issued.spec.id]!.spec).toEqual(issued.spec);
+  } finally {
+    await rm(candidateRoot, { recursive: true, force: true });
+    await f.dispose();
+  }
+});
