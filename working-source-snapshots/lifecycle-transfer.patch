index 00000000..4226908f
--- /dev/null
+++ b/src/audit/lifecycle/auditPolicy.ts
@@ -0,0 +1,110 @@
+// sites-pinned: tests/audit/accepted-lineage-projection.test.ts, tests/audit/pinned-preparation-boundary.test.ts, tests/audit/finalization-convergence.test.ts, tests/audit/pipeline-integration.test.ts
+import { z } from "zod";
+import { join } from "node:path";
+import { AuditFindingsReportSchema, SynthesisNarrativeSchema, RunLogger, AGENT_FEEDBACK_FILENAME, readOptionalTextFile, parseReflectionsNdjson, reportDiscardedReflections } from "../../shared/index.js";
+import type { DrawPolicy, TaskDefinition, TaskSpec, ReadContext } from "../../shared/engine/taskLifecycleTypes.js";
+import { AuditTaskSchema } from "../types.js";
+import type { ArtifactBundle } from "../io/artifacts.js";
+import { EXECUTOR_RUNNERS } from "../orchestrator/executorRunners.js";
+import { checkFileIntegrity } from "../orchestrator/fileIntegrity.js";
+import { runSynthesisNarrativeExecutor } from "../orchestrator/synthesisExecutors.js";
+import { renderSynthesisNarrativePrompt } from "../reporting/synthesisNarrativePrompt.js";
+import { parseAuditDomain, inspectionSpec, inspectionSurface, projectAuditBundle, projectCompletedInspectionResults, type AuditDomain } from "./auditDomain.js";
+import { runtimeDefinition, runtimeTask } from "./runtimeTask.js";
+import { inspectionDefinition } from "./inspectionTasks.js";
+import { preparationDefinition, preparationReviewDefinition, preparationTask } from "./preparationTasks.js";
+
+function finishSpec(kind: "synthesis" | "narrative" | "report", inputs: TaskSpec["inputs"], predecessor?: string): TaskSpec {
+  return { id: `audit.finalize.${kind}`, kind: `audit.${kind}`, phase: "finalizing", completion: "complete",
+    subject: {}, depends_on: predecessor ? [{ task_id: predecessor, requires: "completed_required_scope" }] : [], inputs };
+}
+function accepted(context: ReadContext<AuditDomain>, id: string): boolean { return context.state.tasks[id]?.status === "accepted"; }
+function finalDefinition(kind: "synthesis" | "narrative" | "report"): TaskDefinition<AuditDomain> {
+  return {
+    kind: `audit.${kind}`, phase: "finalizing", completion: "complete", execution: kind === "narrative" ? "host" : "deterministic", effect: "read_only",
+    parseSubject: value => z.object({}).strict().parse(value),
+    parsePayload: value => kind === "narrative" ? SynthesisNarrativeSchema.parse(value) : value,
+    render: (task, context) => kind === "narrative"
+      ? renderSynthesisNarrativePrompt((context.acceptedPayloads.get("audit.finalize.synthesis") as { bundle: ArtifactBundle }).bundle.audit_findings!, join(context.state.domain.artifacts_dir, task.inputs.bundle!.path))
+      : `Produce the immutable ${kind} from accepted evidence only.`,
+    ...(kind === "narrative" ? {} : { runDeterministic: async (task, io) => {
+      let bundle = await io.readArtifact(task.inputs.bundle!) as ArtifactBundle;
+      if (kind === "synthesis") bundle = (await EXECUTOR_RUNNERS.synthesis_executor!(bundle, {
+        options: { root: (await io.readArtifact(task.source) as { source_root: string }).source_root },
+        log: RunLogger.disabled(), correlationId: task.run_id, obligation: task.spec.id,
+      })).updated;
+      if (!bundle.audit_findings || !bundle.audit_report) throw new Error("Finalization lacks a complete findings and report pair.");
+      return { outcome: "complete" as const, payload: { bundle } };
+    } }),
+    validate: async (_task, payload, context, submission) => {
+      if (submission.outcome !== "complete") return { errors: ["Finalization requires a complete output."] };
+      if (kind !== "narrative") {
+        const bundle = (payload as { bundle: ArtifactBundle }).bundle;
+        AuditFindingsReportSchema.parse(bundle.audit_findings);
+        if (typeof bundle.audit_report !== "string") return { errors: ["Missing report text."] };
+        return { errors: [] };
+      }
+      const prior = context.acceptedPayloads.get("audit.finalize.synthesis") as { bundle: ArtifactBundle };
+      const updated = runSynthesisNarrativeExecutor(prior.bundle, SynthesisNarrativeSchema.parse(payload), { auditRead: prior.bundle.audit_findings?.audit_read ?? null }).updated;
+      return { errors: [], normalizedPayload: { bundle: updated } };
+    },
+    reduce: (task, payload, context) => {
+      const bundle = (payload as { bundle: ArtifactBundle }).bundle;
+      const next = kind === "synthesis" ? finishSpec(context.state.domain.narrative_enabled ? "narrative" : "report", { bundle: { task_id: task.spec.id, output: "bundle" } }, task.spec.id)
+        : kind === "narrative" ? finishSpec("report", { bundle: { task_id: task.spec.id, output: "bundle" } }, task.spec.id) : undefined;
+      return { ...(next ? { addTasks: [next] } : {}), outputs: { bundle, findings: bundle.audit_findings, report: bundle.audit_report } };
+    },
+    requiredScopeComplete: task => task.status === "accepted" && task.accepted?.outcome === "complete",
+  };
+}
+
+export function createAuditPolicy(deadline?: { at: number }): DrawPolicy<AuditDomain> {
+  const definitions = new Map([preparationDefinition(deadline), preparationReviewDefinition(), inspectionDefinition(), inspectionDefinition(true),
+    runtimeDefinition(), finalDefinition("synthesis"), finalDefinition("narrative"), finalDefinition("report")].map(definition => [definition.kind, definition]));
+  return {
+    definitions, parseDomain: parseAuditDomain,
+    initialTasks: () => [preparationTask("intake")],
+    phaseTransition: async (context, io) => {
+      const state = context.state;
+      const required = Object.values(state.tasks).filter(task => task.spec.phase === state.phase && task.spec.required !== false);
+      if (required.some(task => !definitions.get(task.spec.kind)!.requiredScopeComplete(task, context))) return null;
+      if (state.phase === "preparing") {
+        if (!accepted(context, "audit.prepare.seal")) return null;
+        const sealed = context.acceptedPayloads.get("audit.prepare.seal") as { basis: NonNullable<typeof state.basis>; plan: NonNullable<AuditDomain["initial_plan"]> };
+        await io.readArtifact(sealed.basis);
+        const plan = z.array(AuditTaskSchema).parse(await io.readArtifact(sealed.plan));
+        const tasks: TaskSpec[] = await Promise.all(plan.map(async (task, index) => ({ ...inspectionSpec(task, sealed.basis), order: index, inputs: { basis: sealed.basis, initial_plan: sealed.plan,
+          ...(task.coverage_policy === "selective" ? { surface: await io.writeArtifact(inspectionSurface(task)) } : {}) } })));
+        if (state.domain.preparation.runtime_validation_tasks?.tasks.length) tasks.push(runtimeTask(await io.writeArtifact(state.domain.preparation), tasks));
+        return { phase: "executing", basis: sealed.basis, addTasks: tasks };
+      }
+      if (state.phase === "executing") {
+        // Pin the completed-root analytical view for synthesis without rewriting raw acceptance.
+        const projected = { ...projectAuditBundle(context), audit_results: projectCompletedInspectionResults(context) };
+        // Optional worker diagnostics are captured once at the execution boundary.
+        // Later appends cannot mutate a finalization task's input or completed report.
+        const feedback = await readOptionalTextFile(join(state.domain.artifacts_dir, AGENT_FEEDBACK_FILENAME));
+        const inputs: TaskSpec["inputs"] = {};
+        if (feedback !== undefined) {
+          const parsed = parseReflectionsNdjson(feedback);
+          projected.agent_reflections = parsed.reflections;
+          reportDiscardedReflections(parsed.discarded, "audit-code");
+          inputs.feedback = await io.writeText(feedback);
+        }
+        inputs.bundle = await io.writeArtifact(projected);
+        return { phase: "finalizing", addTasks: [finishSpec("synthesis", inputs)] };
+      }
+      if (state.phase === "finalizing" && accepted(context, "audit.finalize.report")) {
+        const outputs = state.tasks["audit.finalize.report"]!.accepted!.outputs;
+        return { phase: "complete", deliverables: { findings: outputs.findings!, report: outputs.report! } };
+      }
+      return null;
+    },
+    acceptanceGuard: async (_task, _observation, context) => {
+      const manifest = context.state.domain.preparation.repo_manifest;
+      if (!manifest) return [];
+      const integrity = await checkFileIntegrity(context.state.domain.source_root, manifest);
