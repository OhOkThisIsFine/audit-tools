+  await withTempDir("cleanup-held-", async (root) => {
+    const dir = await legacy(root);
+    const lockPath = artifactTreeLockPath(dir);
+    for (const suffix of [".steal", ".reap", ".future-control"]) await writeFile(`${lockPath}${suffix}`, "preserve recovery control");
+    const removed: string[] = [];
+    boundary.beforeRemove = async (path) => {
+      if (!path.startsWith(dir)) return;
+      expect(path, "never recursively delete the held root").not.toBe(dir);
+      expect(await readFile(lockPath, "utf8")).not.toBe("");
+      await expect(withFileLock(lockPath, async () => {}, 0)).rejects.toBeInstanceOf(FileLockTimeoutError);
