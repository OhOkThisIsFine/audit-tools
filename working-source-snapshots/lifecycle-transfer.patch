+test("push corroborates the pinned push URL even when the fetch URL contains an older commit", async () => {
+  const f = await pushFixture();
+  f.git("commit", "--allow-empty", "-qm", "synthetic current head");
+  execFileSync("git", ["--git-dir", f.b, "fetch", f.root, `HEAD:refs/heads/${f.branch}`], { encoding: "utf8", stdio: "pipe" });
+  f.git("remote", "set-url", "--push", "origin", f.b);
+  const task = (await f.run()).tasks[0]!;
+  expect((await f.submit(task, pushSuccess)).status).toBe("accepted");
+});
