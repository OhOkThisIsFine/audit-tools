+test("common orchestration pins every fine task before dispatch and reemits the same outstanding attempts", async () => {
+  await withRun(async ({store,policy}) => {
+    const before = await store.read();
+    expect(before.phase).toBe("executing");
+    expect(Object.keys(before.tasks)).toEqual(["inspect-0", "inspect-1"]);
+    const first = await advanceRun(store,policy,{draw:"full",maxExecutions:16});
+    expect(first.tasks).toHaveLength(2);
+    expect(first.tasks.every(task => task.spec.kind === "audit.inspection")).toBe(true);
+    const again = await advanceRun(store,policy,{draw:"full",maxExecutions:16});
+    expect(again.tasks.map(task => [task.spec.id,task.attempt,task.binding_sha256])).toEqual(first.tasks.map(task => [task.spec.id,task.attempt,task.binding_sha256]));
+    expect((await store.read()).basis).toEqual(before.basis);
+  });
+});
+
+test("accepted inspections drain synthesis and report without inventing runtime evidence", async () => {
+  await withRun(async ({store,policy}) => {
+    const first = await advanceRun(store,policy,{draw:"full",maxExecutions:16});
+    for (const task of first.tasks) {
+      const path = await writeAuditInspectionSubmission(store,task);
+      expect((await acceptSubmission(store,path,policy)).status).toBe("accepted");
+    }
+    await advanceRun(store,policy,{draw:"full",maxExecutions:16});
+    const state = await store.read();
+    expect(state.phase).toBe("complete");
+    expect(state.tasks["audit.finalize.synthesis"]?.status).toBe("accepted");
+    expect(state.tasks["audit.finalize.report"]?.status).toBe("accepted");
+    expect(Object.values(state.tasks).some(task => task.spec.kind === "audit.runtime_validation")).toBe(false);
+    expect(state.deliverables?.findings).toBeDefined();
+    expect(state.deliverables?.report).toBeDefined();
+    const report = await store.io.readArtifact(state.deliverables!.findings!);
+    expect(report).toMatchObject({findings:[]});
+    const checkpoint = await readFile(join(store.io.directory,"run-state.json"),"utf8");
+    await advanceRun(store,policy,{draw:"full",maxExecutions:16});
+    expect(await readFile(join(store.io.directory,"run-state.json"),"utf8")).toBe(checkpoint);
+  });
+});
