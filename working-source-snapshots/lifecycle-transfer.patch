@@ -0,0 +1,118 @@
+/** Fixed contract oracle, not a live audit or a snapshot update mechanism. */
+import { expect, test } from "vitest";
+import { mkdtemp, mkdir, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { cmdNextStep } from "../../src/audit/cli/nextStepCommand.js";
+import { acceptAuditSubmission, auditStore, drawAuditRun } from "../../src/audit/lifecycle/auditRun.js";
+import { inspectionScopeComplete, inspectionSubject } from "../../src/audit/lifecycle/auditDomain.js";
+import { readRunContext } from "../../src/shared/engine/taskLifecycleStore.js";
+import { hashContent } from "../../src/shared/hash.js";
+import { promotedAuditFindingsPath, promotedAuditReportPath } from "../../src/shared/io/auditToolsPaths.js";
+import type { AuditFindingsReport } from "../../src/shared/types/finding.js";
+import type { IssuedTask } from "../../src/shared/engine/taskLifecycleTypes.js";
+import { seedPreparation } from "./helpers/preparationLifecycleFixture.js";
+import { satisfyFunctionalPreflight } from "../helpers/functionalPreflightFixture.js";
+
+const oracle = JSON.parse(await readFile(new URL("../fixtures/pinned-workflow-golden/expected.json", import.meta.url), "utf8")).audit;
+const at = "2026-01-01T00:00:00Z";
+const source = "export function value() {\n  return 1;\n}\n";
+
+test("golden audit: selected preparation through real next-step, partial resume, and immutable final report", async () => {
+  const root = await mkdtemp(join(tmpdir(), "audit-workflow-golden-"));
+  try {
+    await mkdir(join(root, "src"));
+    for (const path of ["src/a.ts", "src/b.ts"]) await writeFile(join(root, path), source);
+    const f = await seedPreparation(root, {
+      repo_manifest: { repository: { name: "golden" }, generated_at: at, files: ["src/a.ts", "src/b.ts"].map(path => ({ path, language: "typescript", size_bytes: Buffer.byteLength(source), hash: hashContent(source) })) },
+      file_disposition: { files: ["src/a.ts", "src/b.ts"].map(path => ({ path, status: "included" as const })) },
+      unit_manifest: { units: [{ unit_id: "source", name: "Source", files: ["src/a.ts", "src/b.ts"], required_lenses: ["correctness"] }] },
+      surface_manifest: { surfaces: [] }, critical_flows: { flows: [] }, risk_register: { items: [] },
+      graph_bundle: { graphs: {} }, docs_digest: { generated_at: at, docs: [] },
+      design_assessment: { generated_at: at, findings: [] },
+    }, "intent");
+    await satisfyFunctionalPreflight(root, f.artifactsDir);
+    const assignments = new Set<string>();
+    const next = async () => {
+      await cmdNextStep(["--root", root, "--artifacts-dir", f.artifactsDir]);
+      const checkpoint = await auditStore(f.artifactsDir).read();
+      if (checkpoint.phase === "complete") return [];
+      const workload = JSON.parse(await readFile(join(f.artifactsDir, "task-workload.json"), "utf8")) as { tasks: IssuedTask[] };
+      for (const task of workload.tasks) assignments.add(`${task.spec.id}:${task.attempt}`);
+      return workload.tasks;
+    };
+    const write = async (task: IssuedTask, payload: unknown, outcome: "partial" | "complete" = "complete") => {
+      const path = join(f.artifactsDir, task.result_path);
+      await writeFile(path, JSON.stringify({ contract_version: "audit-tools-task-result/v1", run_id: task.run_id, task_id: task.spec.id, attempt: task.attempt, binding_sha256: task.binding_sha256, outcome, payload }));
+      return path;
+    };
+    const [intent] = await next();
+    expect(intent!.spec.id).toBe("audit.prepare.review.intent");
+    await acceptAuditSubmission(f.artifactsDir, await write(intent!, {
+      schema_version: "intent-checkpoint/v1", confirmed_at: at, confirmed_by: "host", scope_summary: "src/a.ts and src/b.ts", intent_summary: "Fixed synthetic coverage",
+      lens_selection: { include: ["correctness", "maintainability", "tests", "observability"] }, design_review: { answered_at: at, ceiling: { rung: "shallow" }, conceptual_depth: "shallow" },
+    }));
+    const reviews = await next();
+    expect(reviews.map(task => (task.spec.subject as { lane: string }).lane).sort()).toEqual(["conceptual", "contract"]);
+    const beforeReviews = await f.store.read();
+    expect(beforeReviews.phase).toBe("preparing");
+    expect(beforeReviews.basis).toBeUndefined();
+    expect(Object.values(beforeReviews.tasks).filter(task => task.spec.phase === "executing")).toEqual([]);
+    for (const task of reviews) await acceptAuditSubmission(f.artifactsDir, await write(task, { review: { mode: "independent", reason: "Fixed independent synthetic reviewer payload, not semantic proof" }, result: [] }));
+    const fine = await next();
+    expect(fine.map(task => ({ lens: inspectionSubject(task.spec).task.lens, paths: inspectionSubject(task.spec).task.file_paths })).sort((a, b) => a.lens.localeCompare(b.lens))).toEqual(oracle.initial_scopes);
+    const parent = fine.find(task => inspectionSubject(task.spec).task.lens === "correctness")!;
+    const pinned = await f.store.read(), basisBytes = await f.store.io.readArtifact(pinned.basis!);
+    const pinnedSpecs = Object.fromEntries(Object.entries(pinned.tasks).map(([id, task]) => [id, task.spec]));
+    const result = (paths: string[]) => ({ file_coverage: paths.map(path => ({ path, total_lines: 3 })), findings: [], reviewed_clean: true });
+    for (const task of fine.filter(task => task !== parent)) await acceptAuditSubmission(f.artifactsDir, await write(task, result(["src/a.ts", "src/b.ts"])));
+    const partialPath = await write(parent, result(["src/a.ts"]), "partial");
+    const beforePlan = await f.store.read();
+    const deterministic = await drawAuditRun(auditStore(f.artifactsDir), "deterministic", 16);
+    expect(deterministic.tasks).toEqual([]);
+    expect(await f.store.read()).toEqual(beforePlan);
+    expect(await readFile(partialPath, "utf8")).toContain('"outcome":"partial"');
+    await acceptAuditSubmission(f.artifactsDir, partialPath);
+    const partial = await f.store.read(), acceptedParent = partial.tasks[parent.spec.id]!.accepted!;
+    expect(inspectionScopeComplete(parent.spec.id, await readRunContext(f.store))).toBe(false);
+    expect(partial.phase).toBe("executing");
+    expect(partial.deliverables).toBeUndefined();
+    await expect(readFile(promotedAuditReportPath(f.artifactsDir))).rejects.toMatchObject({ code: "ENOENT" });
+    expect((await acceptAuditSubmission(f.artifactsDir, partialPath)).status).toBe("duplicate");
+    const [residual] = await next();
+    expect(inspectionSubject(residual!.spec).task.file_paths).toEqual(oracle.residual_paths);
+    expect(residual!.spec.depends_on).toEqual([{ task_id: parent.spec.id, requires: "accepted_evidence" }]);
+    expect(await next()).toEqual([residual]);
+    await acceptAuditSubmission(f.artifactsDir, await write(residual!, result(["src/b.ts"])));
+    await next();
+    const completed = await f.store.read(), context = await readRunContext(f.store);
+    const report = await f.store.io.readArtifact(completed.deliverables!.findings!) as AuditFindingsReport;
+    const observed = {
+      preparation_lanes: Object.values(completed.tasks).filter(task => task.spec.kind === "audit.preparation-review").map(task => (task.spec.subject as { lane: string }).lane).sort(),
+      initial_scopes: fine.map(task => ({ lens: inspectionSubject(task.spec).task.lens, paths: inspectionSubject(task.spec).task.file_paths })).sort((a, b) => a.lens.localeCompare(b.lens)),
+      residual_paths: inspectionSubject(residual!.spec).task.file_paths,
+      accepted_file_observations: [parent, residual!].flatMap(task => (context.acceptedPayloads.get(task.spec.id) as { file_coverage: Array<{ path: string }> }).file_coverage.map(file => file.path)).sort(),
+      parent_outcome: completed.tasks[parent.spec.id]!.accepted!.outcome,
+      phase: completed.phase, audited_file_count: report.summary.audited_file_count, findings: report.findings,
+      charter_status: completed.domain.preparation.charter_register?.status,
+      new_host_assignments: assignments.size,
+      completed_resume_executions: (await drawAuditRun(auditStore(f.artifactsDir), "full", 16)).executions,
+    };
+    expect(observed).toEqual(oracle);
+    expect(inspectionScopeComplete(parent.spec.id, context)).toBe(true);
+    expect(completed.tasks[parent.spec.id]!.accepted).toEqual(acceptedParent);
+    for (const [id, spec] of Object.entries(pinnedSpecs)) expect(completed.tasks[id]!.spec).toEqual(spec);
+    expect(completed.basis).toEqual(pinned.basis);
+    expect(await f.store.io.readArtifact(completed.basis!)).toEqual(basisBytes);
+    expect(JSON.parse(await readFile(promotedAuditFindingsPath(f.artifactsDir), "utf8"))).toEqual(report);
+    const reportBytes = await readFile(promotedAuditReportPath(f.artifactsDir), "utf8");
+    expect(reportBytes).toBe(await f.store.io.readArtifact(completed.deliverables!.report!));
+    for (const path of ["src/a.ts", "src/b.ts"]) expect(await readFile(join(root, path), "utf8")).toBe(source);
+    // Authoritative corruption is not permission to resurrect work or trust a stale display.
+    await writeFile(join(f.artifactsDir, acceptedParent.raw.path), "{\"forged\":true}");
+    const checkpointBytes = await readFile(join(f.artifactsDir, "run-state.json"), "utf8");
+    await expect(next()).rejects.toThrow();
+    expect(await readFile(join(f.artifactsDir, "run-state.json"), "utf8")).toBe(checkpointBytes);
+    expect(await readFile(promotedAuditReportPath(f.artifactsDir), "utf8")).toBe(reportBytes);
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
