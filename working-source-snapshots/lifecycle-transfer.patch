+async function snapshotFixture(root: string, artifactsDir: string) {
+  const physicalRoot = await realpath(root);
+  const key = hashContent(`${physicalRoot}\0${await realpath(artifactsDir)}`).slice(0, 12);
+  const snapshotDir = join(process.env.AUDIT_CODE_STATE_DIR!, "snapshots", key);
+  const tree = join(snapshotDir, "tree");
+  await mkdir(tree, { recursive: true });
+  await writeFile(join(tree, "source.txt"), "frozen source");
+  await symlink(physicalRoot, join(tree, "dependency"), process.platform === "win32" ? "junction" : "dir");
+  await writeFile(runSnapshotPath(artifactsDir), JSON.stringify({
+    schema_version: "audit-run-snapshot/v1", repository_root: physicalRoot,
+    source_root: tree, kind: "copy", pins: [], linked: ["dependency"], since: {},
+  }));
+  return { snapshotDir, tree };
+}
