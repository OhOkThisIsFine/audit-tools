+import { test, expect } from "vitest";
+import { mkdtemp, mkdir, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createRunState, issueTasks, acceptSubmission, advanceRun, retryTask } from "../../src/shared/engine/taskLifecycle.js";
+import { createLifecycleIO, createRunStore, readRunContext } from "../../src/shared/engine/taskLifecycleStore.js";
+import type { IssuedTask, TaskSubmission } from "../../src/shared/engine/taskLifecycleTypes.js";
+import { createAuditPolicy } from "../../src/audit/lifecycle/auditPolicy.js";
+import { parseAuditDomain, inspectionSpec, inspectionScopeComplete } from "../../src/audit/lifecycle/auditDomain.js";
+import { hashContent } from "../../src/shared/hash.js";
+
+async function fixture(run: (directory: string) => Promise<void>) {
+  const directory = await mkdtemp(join(tmpdir(), "audit-lifecycle-"));
+  try { await run(directory); } finally { await rm(directory, { recursive: true, force: true }); }
+}
+async function seed(directory: string) {
+  await writeFile(join(directory, "a.ts"), "export const a = 1;\n");
+  await writeFile(join(directory, "b.ts"), "export const b = 2;\n");
+  const io = createLifecycleIO(directory);
+  const source = await io.writeArtifact({ source_root: directory, repository_root: directory, artifacts_dir: directory, options: {} });
+  const basis = await io.writeArtifact({ source, question: "fixed A/B inspection" });
+  const policy = createAuditPolicy();
+  const domain = { repository_root: directory, source_root: directory, artifacts_dir: directory, preparation: {
+    repo_manifest: { repository: { name: "fixed" }, generated_at: "2026-01-01T00:00:00Z", files: [
+      { path: "a.ts", language: "typescript", hash: hashContent("export const a = 1;\n"), size_bytes: 20 },
+      { path: "b.ts", language: "typescript", hash: hashContent("export const b = 2;\n"), size_bytes: 20 },
+    ] },
+  }, line_index: { "a.ts": 1, "b.ts": 1 }, narrative_enabled: false };
+  const state = createRunState({ run_id: "fixed-run", mode: "audit", source, domain }, { ...policy, initialTasks: () => [] });
+  const spec = inspectionSpec({ task_id: "inspect-ab", unit_id: "fixed", pass_id: "base", lens: "correctness", file_paths: ["a.ts", "b.ts"], file_line_counts: { "a.ts": 1, "b.ts": 1 }, rationale: "fixed scope", priority: "low" }, basis);
+  state.phase = "executing"; state.basis = basis; state.tasks[spec.id] = { spec, status: "pending", attempt: 0 };
+  const store = createRunStore({ directory, initialState: state, parseDomain: parseAuditDomain });
+  await store.read();
+  return { store, policy };
+}
+async function submit(directory: string, task: IssuedTask, paths: string[], outcome: TaskSubmission["outcome"]) {
+  const envelope: TaskSubmission = { contract_version: "audit-tools-task-result/v1", run_id: task.run_id, task_id: task.spec.id, attempt: task.attempt, binding_sha256: task.binding_sha256,
+    outcome, payload: { file_coverage: paths.map(path => ({ path, total_lines: 1 })), findings: [], reviewed_clean: true } };
+  await mkdir(join(directory, task.result_path, ".."), { recursive: true });
+  await writeFile(join(directory, task.result_path), JSON.stringify(envelope));
+}
+
+test("A/B partial coverage adds only B residual and resume does not rewrite or duplicate A", async () => fixture(async directory => {
+  const { store, policy } = await seed(directory);
+  const [parent] = await issueTasks(store, ["inspect-ab"], policy);
+  await submit(directory, parent!, ["a.ts"], "partial");
+  await acceptSubmission(store, parent!.result_path, policy);
+  const first = await store.read();
+  const originalAcceptance = JSON.stringify(first.tasks["inspect-ab"]!.accepted);
+  expect(inspectionScopeComplete("inspect-ab", await readRunContext(store))).toBe(false);
+  const residuals = Object.values(first.tasks).filter(task => task.spec.id.includes(":residual:"));
+  expect(residuals).toHaveLength(1);
+  expect((residuals[0]!.spec.subject as any).task.file_paths).toEqual(["b.ts"]);
+  expect(residuals[0]!.spec.depends_on).toEqual([{ task_id: "inspect-ab", requires: "accepted_evidence" }]);
+  const resumed = createRunStore({ directory, parseDomain: parseAuditDomain });
+  expect((await acceptSubmission(resumed, parent!.result_path, policy)).status).toBe("duplicate");
+  const step = await advanceRun(resumed, policy, { draw: "full", maxExecutions: 8 });
+  expect(step.tasks.map(task => task.spec.id)).toEqual([residuals[0]!.spec.id]);
+  const [residual] = step.tasks;
+  await submit(directory, residual!, ["b.ts"], "complete");
+  await acceptSubmission(resumed, residual!.result_path, policy);
+  expect(inspectionScopeComplete("inspect-ab", await readRunContext(resumed))).toBe(true);
+  expect(JSON.stringify((await resumed.read()).tasks["inspect-ab"]!.accepted)).toBe(originalAcceptance);
+  expect(Object.keys((await resumed.read()).tasks).filter(id => id.includes(":residual:"))).toHaveLength(1);
+}));
+
+test("wrong outcome, out-of-scope coverage, changed source and accepted retry fail closed", async () => fixture(async directory => {
+  const { store, policy } = await seed(directory);
+  const [task] = await issueTasks(store, ["inspect-ab"], policy);
+  await submit(directory, task!, ["a.ts"], "complete");
+  await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toThrow("requires outcome partial");
+  await submit(directory, task!, ["outside.ts"], "partial");
+  await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toThrow("outside issued scope");
+  await submit(directory, task!, ["a.ts", "b.ts"], "complete");
+  await writeFile(join(directory, "a.ts"), "changed\n");
+  await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toThrow("Pinned source changed");
+  await writeFile(join(directory, "a.ts"), "export const a = 1;\n");
+  await acceptSubmission(store, task!.result_path, policy);
+  await expect(retryTask(store, task!.spec.id, { expectedAttempt: 1, reason: "not allowed", disposition: "abandoned" }, policy)).rejects.toThrow("accepted tasks cannot be retried");
+}));
