+ it("waits for explicit operator evidence without automatically reseeding blocked work",async()=>{const f=await blocked(),before=await f.store.read();for(let i=0;i<3;i++){const step=await advanceRun(f.store,f.policy,{draw:"full",maxExecutions:10});expect(step.tasks).toEqual([f.triage]);}expect((await f.store.read()).tasks).toEqual(before.tasks);});
