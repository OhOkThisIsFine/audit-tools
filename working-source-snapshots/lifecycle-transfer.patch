+// sites-pinned: tests/remediate/contract-pipeline-lifecycle.test.ts, tests/remediate/executable-plan-safety.test.ts
+/** Planning is domain policy over shared task acceptance, not a receipt-file state machine. */
+import { readFile } from "node:fs/promises";
+import { z } from "zod";
+import { FindingSchema, hashContent, stableStringify } from "audit-tools/shared";
+import type { ArtifactRef, ReadContext, TaskDefinition, TaskSpec } from "../../shared/engine/taskLifecycleTypes.js";
+import { ReviewDeclarationSchema, reviewIndependenceIssue, type ReviewRequirement } from "../../shared/types/reviewIndependence.js";
+import { computeIntakeRiskSignal, findingRiskEvidence, distinctAffectedFiles, decompositionRiskEvidence, escalateRiskSignal, adversarialDepthForTier } from "../riskSignal.js";
+import { renderPlanAuthorPrompt, renderPlanReviewPrompt } from "../steps/contractPipelinePrompts.js";
+import {
+  PlanSourceSchema, PlanSubmissionSchema, CanonicalPlanSchema, CritiqueSchema, CriticSchema,
+  PlanJudgeSchema, PlanRiskDecisionSchema, PlanCounterexampleSchema, executionPlanIssues, executionPlanRevision,
+  normalizeExecutionPlanPaths, captureExecutionContext, executionPlanContextIssues,
+  type PlanSource, type CanonicalPlan, type PlanReviewHistory, type PlanReviewRole, type PlanCounterexample,
+} from "./executionPlan.js";
+
+const digest = z.string().regex(/^[a-f0-9]{64}$/u);
+const PlanningContextSchema = z.object({
+  contract_version: z.literal("remediate-code-planning-context/v1"),
+  findings: z.array(FindingSchema),
+  mergeMap: z.array(z.tuple([z.string(), z.string()])),
+  phantomPathsRemoved: z.array(z.tuple([z.string(), z.array(z.string())])),
+}).strict();
+export type PlanningContext = z.infer<typeof PlanningContextSchema>;
+export const PlanOwnerDecisionSchema = z.object({
+  revision_sha256: digest, confirmed_by: z.literal("host"), approved_unit_ids: z.array(z.string()),
+  declined_units: z.array(z.object({ id: z.string(), reason: z.string().trim().min(1) }).strict()),
+  deferred_findings: z.array(z.object({ finding_id: z.string(), reason: z.string().trim().min(1) }).strict()).default([]),
+}).strict();
+const ReviewPayloadSchema = z.object({ review: ReviewDeclarationSchema, result: z.unknown() }).strict();
+const SubjectSchema = z.object({ round: z.number().int().nonnegative(), revision: digest.optional(), requirement: z.enum(["independent", "degraded_allowed"]).optional(), reason: z.string().optional() }).strict();
+type ReviewPayload = z.infer<typeof ReviewPayloadSchema>;
+export interface PlanningState {
+  source: PlanSource;
+  canonical?: CanonicalPlan;
+  history: PlanReviewHistory;
+  /** The counter is policy's finite repair bound, not an attempt/acceptance ledger. */
+  round: number;
+  reviewRequirement?: "independent" | "degraded_allowed";
+}
+export interface PlanningDomain { planning: PlanningState }
+export function parsePlanningState(value: unknown): PlanningState {
+  return z.object({ source: PlanSourceSchema, canonical: CanonicalPlanSchema.optional(), round: z.number().int().nonnegative(),
+    reviewRequirement: z.enum(["independent", "degraded_allowed"]).optional(),
+    history: z.object({ counterexamples: z.array(PlanCounterexampleSchema), accepted_ids: z.array(z.string()), repair_rounds: z.number().int().nonnegative(), repair_revision: digest.optional(), repair_reason: z.string().optional() }).strict(),
+  }).strict().parse(value);
+}
+const prefix = "remediation.plan.";
+const taskId = (role: string, round: number) => `${prefix}${round}.${role}`;
+function spec(role: string, round: number, source: ArtifactRef, dependency?: string, revision?: string, requirement?: ReviewRequirement, selectedContext?: ArtifactRef): TaskSpec {
+  return { id: taskId(role, round), kind: `${prefix}${role}`, phase: "preparing", completion: "complete",
+    depends_on: dependency ? [{ task_id: dependency, requires: "completed_required_scope" }] : [],
+    inputs: { source, ...(selectedContext ? { selected_context: selectedContext } : {}), ...(dependency ? { predecessor: { task_id: dependency, output: "result" } } : {}) },
+    subject: { round, ...(revision ? { revision } : {}), ...(requirement && requirement !== "ordinary" ? { requirement } : {}) } };
+}
+export function initialPlanningState(source: PlanSource, reviewRequirement?: "independent" | "degraded_allowed"): PlanningState {
+  return { source: PlanSourceSchema.parse(source), history: { counterexamples: [], accepted_ids: [], repair_rounds: 0 }, round: 0, reviewRequirement: reviewRequirement === "independent" ? "independent" : planningReviewRequirement(source) };
+}
+function planningReviewRequirement(source: PlanSource, canonical?: CanonicalPlan): "independent" | "degraded_allowed" {
+  let signal = computeIntakeRiskSignal({ affectedFiles: distinctAffectedFiles(source.findings), goals: [source.request?.text, source.intent?.intent_summary].filter((s): s is string => !!s) });
+  const findings = findingRiskEvidence(source.findings);
+  if (findings) signal = escalateRiskSignal(signal, findings);
+  if (canonical) {
+    const evidence = decompositionRiskEvidence({ moduleCount: canonical.plan.units.length, fileScopes: canonical.plan.units.flatMap(u => u.allowed_files) });
+    if (evidence) signal = escalateRiskSignal(signal, evidence);
+  }
+  return adversarialDepthForTier(signal.tier) === "light" ? "degraded_allowed" : "independent";
+}
+export function initialPlanningTasks(source: ArtifactRef): TaskSpec[] { return [spec("author", 0, source)]; }
+function payload<D extends PlanningDomain>(ctx: ReadContext<D>, role: string, round = ctx.state.domain.planning.round): unknown {
+  return ctx.acceptedPayloads.get(taskId(role, round));
+}
+function review<D extends PlanningDomain>(ctx: ReadContext<D>, role: PlanReviewRole): ReviewPayload {
+  return ReviewPayloadSchema.parse(payload(ctx, role));
+}
+function ownerRequired(plan: CanonicalPlan, source: PlanSource): boolean { return !!source.request || plan.plan.source_dispositions.some(d => d.status === "deferred"); }
+function ownerIssues(raw: unknown, canonical: CanonicalPlan): string[] {
+  const decision = PlanOwnerDecisionSchema.parse(raw);
+  const ids = canonical.plan.units.map(u => u.id);
+  const covered = [...decision.approved_unit_ids, ...decision.declined_units.map(u => u.id)];
+  const errors: string[] = [];
+  if (decision.revision_sha256 !== canonical.revision_sha256 || covered.length !== ids.length || new Set(covered).size !== ids.length || covered.some(id => !ids.includes(id))) errors.push("Owner choices must cover every unit exactly once for this revision.");
+  const approved = new Set(decision.approved_unit_ids);
+  for (const unit of canonical.plan.units) if (approved.has(unit.id) && unit.dependencies.some(id => !approved.has(id))) errors.push(`Approved unit ${unit.id} depends on a declined unit; approve its prerequisites or explicitly decline the dependent.`);
+  const deferred = canonical.plan.source_dispositions.filter(d => d.status === "deferred").map(d => d.finding_id);
+  if (new Set(decision.deferred_findings.map(d => d.finding_id)).size !== decision.deferred_findings.length || decision.deferred_findings.length !== deferred.length || deferred.some(id => !decision.deferred_findings.some(d => d.finding_id === id))) errors.push("Every deferred finding needs exactly one explicit owner decision.");
+  return errors;
+}
+function reviewIssues<D extends PlanningDomain>(role: PlanReviewRole, raw: ReviewPayload, ctx: ReadContext<D>, requirement: ReviewRequirement): string[] {
+  const { canonical, history } = ctx.state.domain.planning;
+  if (!canonical) return ["No accepted canonical plan exists."];
+  const errors: string[] = [];
+  const independence = reviewIndependenceIssue(requirement, raw.review);
+  if (independence) errors.push(independence);
+  const reqIds = new Set(canonical.plan.requirements.map(r => r.id));
+  const unitIds = new Set(canonical.plan.units.map(u => u.id));
+  if (role !== "judge") {
+    const entries = role === "critique" ? CritiqueSchema.parse(raw.result).issues : CriticSchema.parse(raw.result).counterexamples;
+    if (new Set(entries.map(e => e.id)).size !== entries.length) errors.push("Review issue identities must be unique.");
+    for (const e of entries) if (e.requirement_ids.some(id => !reqIds.has(id)) || e.unit_ids.some(id => !unitIds.has(id))) errors.push(`Review issue ${e.id} references missing plan entities.`);
+  } else {
+    const judge = PlanJudgeSchema.parse(raw.result);
+    const critic = CriticSchema.parse(review(ctx, "critic").result);
+    const ids = new Set([...history.accepted_ids, ...critic.counterexamples.map(e => e.id)]);
+    const exactly = (given: string[], expected: Set<string>) => given.length === expected.size && new Set(given).size === given.length && given.every(id => expected.has(id));
+    if (!exactly(judge.classifications.map(e => e.counterexample_id), ids)) errors.push("Judge must classify every current/previously accepted counterexample exactly once.");
+    if (!exactly(judge.requirement_assessments.map(e => e.requirement_id), reqIds)) errors.push("Judge must assess every requirement exactly once.");
+    if (!exactly(judge.disposition_assessments.map(e => e.finding_id), new Set(canonical.plan.source_dispositions.map(e => e.finding_id)))) errors.push("Judge must assess every source disposition exactly once.");
+    if (canonical.plan.request_disposition && !judge.request_disposition_assessment) errors.push("Judge must assess the evidence-backed request disposition.");
+    if (judge.verdict === "approved" && (judge.classifications.some(e => e.classification === "accepted") || judge.requirement_assessments.some(e => e.verdict !== "satisfied") || judge.disposition_assessments.some(e => e.verdict !== "satisfied") || judge.request_disposition_assessment?.verdict === "insufficient")) errors.push("An approval cannot contain unresolved counterexamples or insufficient evidence.");
+  }
+  return errors;
+}
+
+/** Authority is derived from coordinator-accepted evidence, never an editable approval marker. */
+export function approvedPlanning<D extends PlanningDomain>(ctx: ReadContext<D>): { canonical: CanonicalPlan; source: PlanSource; approvedTaskId: string; counterexamples: PlanCounterexample[]; ownerDecision?: z.infer<typeof PlanOwnerDecisionSchema> } | undefined {
+  const { canonical, source } = ctx.state.domain.planning;
+  if (!canonical || canonical.source_sha256 !== hashContent(stableStringify(source))) return undefined;
+  try {
+    const author = ctx.state.tasks[taskId("author", ctx.state.domain.planning.round)];
+    if (author?.status !== "accepted" || author.accepted?.outcome !== "complete" || stableStringify(payload(ctx, "author")) !== stableStringify(canonical)) return undefined;
+    for (const role of ["critique", "critic", "judge"] as const) {
+      const record = ctx.state.tasks[taskId(role, ctx.state.domain.planning.round)];
+      if (record?.status !== "accepted" || record.accepted?.outcome !== "complete" || SubjectSchema.parse(record.spec.subject).revision !== canonical.revision_sha256) return undefined;
+      if (reviewIssues(role, review(ctx, role), ctx, role === "judge" ? "independent" : ctx.state.domain.planning.reviewRequirement ?? "independent").length) return undefined;
+    }
+    const critique = CritiqueSchema.parse(review(ctx, "critique").result);
+    const judge = PlanJudgeSchema.parse(review(ctx, "judge").result);
+    if (critique.verdict !== "approved" || critique.issues.some(e => e.blocking) || judge.verdict !== "approved") return undefined;
+    if (ownerRequired(canonical, source) && ownerIssues(payload(ctx, "owner"), canonical).length) return undefined;
+    const residuals = judge.classifications.filter(e => e.classification === "residual_risk").map(e => e.counterexample_id);
+    if (residuals.length) {
+      const risk = PlanRiskDecisionSchema.parse(payload(ctx, "risk"));
+      if (risk.revision_sha256 !== canonical.revision_sha256 || residuals.some(id => !risk.accepted_counterexample_ids.includes(id))) return undefined;
+    }
+    const approvedTaskId = taskId(residuals.length ? "risk" : "judge", ctx.state.domain.planning.round);
+    const accepted = ctx.state.tasks[approvedTaskId];
+    if (accepted?.status !== "accepted" || accepted.accepted?.outcome !== "complete") return undefined;
+    const examples = new Map(ctx.state.domain.planning.history.counterexamples.map(e => [e.id, e]));
+    for (const entry of CriticSchema.parse(review(ctx, "critic").result).counterexamples) examples.set(entry.id, entry);
+    return { canonical, source, approvedTaskId, counterexamples: [...examples.values()], ...(ownerRequired(canonical, source) ? { ownerDecision: PlanOwnerDecisionSchema.parse(payload(ctx, "owner")) } : {}) };
+  } catch { return undefined; }
+}
+
+export function createPlanningDefinitions<D extends PlanningDomain>(options: { root: string; selectedContext?: (ctx: ReadContext<D>) => PlanningContext | undefined }): Map<string, TaskDefinition<D>> {
+  const definitions = new Map<string, TaskDefinition<D>>();
+  const sourceIssues = async (ctx: ReadContext<D>): Promise<string[]> => {
+    const errors: string[] = [];
+    for (const entry of ctx.state.domain.planning.source.sources) {
+      try { if (hashContent(await readFile(entry.path, "utf8")) !== entry.sha256) errors.push(`Agreed source changed: ${entry.path}. Start a new run; preserve this checkpoint.`); }
+      catch { errors.push(`Agreed source missing: ${entry.path}. Restore its original bytes.`); }
+    }
+    return errors;
+  };
+  for (const role of ["author", "owner", "critique", "critic", "judge", "risk"] as const) {
+    const definition: TaskDefinition<D> = {
+      kind: `${prefix}${role}`, phase: "preparing", completion: "complete", execution: "host", effect: "read_only",
+      parseSubject: value => SubjectSchema.parse(value),
+      parsePayload: value => role === "author" ? PlanSubmissionSchema.parse(value) : role === "owner" ? PlanOwnerDecisionSchema.parse(value) : role === "risk" ? PlanRiskDecisionSchema.parse(value) : ReviewPayloadSchema.parse(value),
+      render(task, ctx) {
+        const p = ctx.state.domain.planning;
+        let input = `Accepted source:\n${JSON.stringify(p.source)}\nAccepted plan:\n${JSON.stringify(p.canonical ?? null)}`;
+        if (task.inputs.selected_context) {
+          const selected = PlanningContextSchema.parse(options.selectedContext?.(ctx));
+          // Compare the same canonical artifact bytes produced by lifecycle IO.
+          // A derived view cannot silently replace the context bound at issuance.
+          if (hashContent(`${stableStringify(selected)}\n`) !== task.inputs.selected_context.sha256) throw new Error("Accepted planning context differs from its bound immutable input.");
+          input += `\nAccepted derived finding context:\n${JSON.stringify(selected)}\nUse these accepted grounding and merged-evidence observations when assessing the source claims. They do not replace original source payloads or grant write scope.`;
+        }
+        const protocol = `\nReturn your domain result as payload in the shared audit-tools-task-result/v1 envelope for this task, not as a separate sidecar. Only the coordinator may accept it. Output: ${task.result_path}.`;
+        if (role === "author") return renderPlanAuthorPrompt({ root: options.root, source: p.source, canonical: p.canonical, history: p.history, sourcePath: "the accepted source below", planPath: "the accepted plan below", outputPath: task.result_path, reason: p.history.repair_reason }) + input + protocol;
+        if (role === "owner") return `Present the concrete execution units, boundaries and unresolved choices to the operator. Batch questions, preserve existing permissions, and never silently discard requested work. Record explicit choices as {revision_sha256,confirmed_by:"host",approved_unit_ids:[],declined_units:[{id,reason}],deferred_findings:[{finding_id,reason}]}. For an empty request, explicitly confirm its evidence-backed disposition.\n${input}${protocol}`;
+        if (role === "risk") return `Ask the operator to accept or repair residual risks. Never infer risk acceptance from the judge. Return {revision_sha256,confirmed_by:"host",accepted_counterexample_ids:[]}.\nJudge: ${JSON.stringify(payload(ctx, "judge"))}\n${input}${protocol}`;
+        return renderPlanReviewPrompt({ role, root: options.root, sourcePath: "the accepted source below", planPath: "the accepted plan below", canonical: p.canonical!, history: p.history, priorReviewPaths: [], requirement: SubjectSchema.parse(task.spec.subject).requirement! }) + `\nPrior reviews: ${JSON.stringify({ critique: payload(ctx, "critique"), critic: payload(ctx, "critic") })}\n${input}\nPayload must be {review:{mode:"independent"|"degraded"|"unavailable",reason},result:<role result>}. The outer shared task binding binds this declaration to the issued prompt.${protocol}`;
