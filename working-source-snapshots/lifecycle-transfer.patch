+// sites-pinned: tests/shared/task-lifecycle-store.test.ts, tests/audit/fold-lock-ownership.test.ts
+import { mkdir, readFile, realpath } from "node:fs/promises";
+import { dirname, join, relative, resolve } from "node:path";
+import { createLockedJsonStore, siblingLockPath, SKIP_WRITE } from "../io/lockedJsonStore.js";
+import { isFileMissingError, writeFileAtomic } from "../io/json.js";
+import { assertWithinRoot, resolveWithinRoot } from "../io/pathContainment.js";
+import { assertNotNodeWorktreeCwd } from "../io/nodeWorktreeGuard.js";
+import { resolveContainedSourcePath } from "../io/sourcePath.js";
+import { hashContent } from "../hash.js";
+import { stableStringify } from "../stableStringify.js";
+import { bindingHolds, phaseOrder, taskAssignment } from "./taskLifecycleInternals.js";
+import { ArtifactRefSchema, RunStateSchema, TaskSubmissionSchema, parseLifecycleJSON } from "./taskLifecycleSchema.js";
+import type { ArtifactRef, LifecycleIO, ReadContext, RunState, RunStore, TaskSubmission } from "./taskLifecycleTypes.js";
+
+/** Resolve only canonical run-relative paths and reject symlink escapes before creating children. */
+export async function lifecyclePath(directory: string, path: string, createParents = false): Promise<string> {
+  ArtifactRefSchema.shape.path.parse(path);
+  const root = resolve(directory);
+  const full = assertWithinRoot(root, path, { allowRoot: false });
+  if (createParents) {
+    await mkdir(root, { recursive: true });
+    const realRoot = await realpath(root);
+    let cursor = root;
+    for (const part of relative(root, dirname(full)).split(/[\\/]/).filter(Boolean)) {
+      cursor = join(cursor, part);
+      try { await mkdir(cursor); } catch (error) {
+        if (!(typeof error === "object" && error !== null && "code" in error && error.code === "EEXIST")) throw error;
+      }
+      if (resolveWithinRoot(realRoot, await realpath(cursor)) === null) throw new Error(`Lifecycle path escapes run directory: ${path}`);
+    }
+  }
+  const existing = resolveContainedSourcePath(root, path);
+  if (existing) return existing;
+  try {
+    await realpath(full);
+    throw new Error(`Lifecycle path is not a contained regular file: ${path}`);
+  } catch (error) {
+    if (!isFileMissingError(error)) throw error;
+  }
+  const parent = await realpath(dirname(full));
+  if (resolveWithinRoot(await realpath(root), parent) === null) throw new Error(`Lifecycle path escapes run directory: ${path}`);
+  return full;
+}
+
+export function createLifecycleIO(directory: string): LifecycleIO {
+  const root = resolve(directory);
+  const readText = async (ref: ArtifactRef): Promise<string> => {
+    ArtifactRefSchema.parse(ref);
+    let bytes: Buffer;
+    try { bytes = await readFile(await lifecyclePath(root, ref.path)); } catch (error) {
+      if (isFileMissingError(error)) throw new Error(`Missing authoritative evidence ${ref.path}; preserve the run and restore its original bytes.`, { cause: error });
+      throw error;
+    }
+    if (hashContent(bytes) !== ref.sha256) throw new Error(`Artifact integrity failure: modified evidence ${ref.path}; preserve the run and restore its original bytes.`);
+    return bytes.toString("utf8");
+  };
+  const write = async (text: string, suffix: string): Promise<ArtifactRef> => {
+    const contentDigest = hashContent(text);
+    const ref = { path: `artifacts/${contentDigest}.${suffix}`, sha256: contentDigest };
+    const path = await lifecyclePath(root, ref.path, true);
+    try {
+      const existing = await readFile(path);
+      if (hashContent(existing) !== contentDigest) throw new Error(`Artifact integrity failure: refusing to replace modified evidence ${ref.path}`);
+    } catch (error) {
+      if (!isFileMissingError(error)) throw error;
+      await writeFileAtomic(path, text);
+    }
+    return ref;
+  };
+  return {
+    directory: root,
+    readText,
+    readArtifact: async ref => parseLifecycleJSON(await readText(ref)),
+    writeArtifact: value => write(`${stableStringify(value)}\n`, "json"),
+    writeText: value => write(value, "txt"),
+  };
+}
+
+export interface RunStoreOptions<Domain> {
+  directory: string;
+  checkpointPath?: string;
+  initialState?: RunState<Domain>;
+  parseDomain(value: unknown): Domain;
+}
+export function createRunStore<Domain>(options: RunStoreOptions<Domain>): RunStore<Domain> {
+  const io = createLifecycleIO(options.directory);
+  const checkpoint = options.checkpointPath ?? "run-state.json";
+  ArtifactRefSchema.shape.path.parse(checkpoint);
+  const path = assertWithinRoot(io.directory, checkpoint, { allowRoot: false });
+  let allowInitial = true;
+  const parse = (raw: unknown): RunState<Domain> => {
+    const value = raw === undefined && allowInitial ? options.initialState : raw;
+    if (value === undefined) throw new Error("Missing run checkpoint; an explicit new run is required. Preserve existing evidence.");
+    const parsed = RunStateSchema.parse(value);
+    return { ...parsed, domain: options.parseDomain(parsed.domain) } as RunState<Domain>;
+  };
+  const backing = createLockedJsonStore<RunState<Domain>>({
+    path, lockPath: siblingLockPath(path), parse, validate: value => { parse(value); },
+  });
+  let initialization: Promise<void> | undefined;
+  const initialize = async (): Promise<void> => {
+    if (options.initialState !== undefined && allowInitial) assertNotNodeWorktreeCwd("initialize shared run checkpoint");
+    await lifecyclePath(io.directory, checkpoint, true);
+    if (options.initialState === undefined) return;
+    initialization ??= (async () => {
+      await backing.mutate(async current => {
+        await verifyReferences(io, current);
+        if (current.run_id !== options.initialState!.run_id || current.mode !== options.initialState!.mode) throw new Error("Run directory already contains a different run; choose an explicit fresh directory");
+        try { await readFile(path); return SKIP_WRITE; }
+        catch (error) { if (!isFileMissingError(error)) throw error; }
+        return current;
+      });
+    })();
+    try { await initialization; allowInitial = false; }
+    catch (error) { initialization = undefined; throw error; }
+  };
+  return {
+    io,
+    async read() {
+      await initialize();
+      const state = await backing.read();
+      await verifyReferences(io, state);
+      return state;
+    },
+    async mutate(fn) {
+      assertNotNodeWorktreeCwd("mutate shared run checkpoint");
+      await initialize();
+      return backing.mutate(async current => {
+        await verifyReferences(io, current);
+        const next = await fn(structuredClone(current));
+        parse(next);
+        assertImmutableHistory(current, next);
+        await verifyReferences(io, next);
+        return stableStringify(current) === stableStringify(next) ? SKIP_WRITE : next;
+      });
+    },
+  };
+}
+
+async function verifyReferences<Domain>(io: LifecycleIO, state: RunState<Domain>): Promise<void> {
+  const refs: ArtifactRef[] = [state.source, ...(state.basis ? [state.basis] : []), ...Object.values(state.deliverables ?? {})];
+  for (const task of Object.values(state.tasks)) {
+    for (const input of Object.values(task.spec.inputs)) if ("path" in input) refs.push(input);
+    if (task.issued) refs.push(task.issued.prompt, ...Object.values(task.issued.inputs), ...(task.issued.basis ? [task.issued.basis] : []));
+    for (const { issued } of task.retry_history ?? []) refs.push(issued.prompt, ...Object.values(issued.inputs), ...(issued.basis ? [issued.basis] : []));
+    if (task.accepted) refs.push(task.accepted.raw, ...Object.values(task.accepted.outputs), ...(task.accepted.normalized ? [task.accepted.normalized] : []));
+  }
+  const unique = new Map(refs.map(ref => [`${ref.path}:${ref.sha256}`, ref]));
+  for (const ref of unique.values()) await io.readText(ref);
+  for (const task of Object.values(state.tasks)) {
+    if (task.issued && !bindingHolds(taskAssignment(state, task), await io.readText(task.issued.prompt))) throw new Error(`Issued prompt binding mismatch for ${task.spec.id}; preserve the run.`);
+    for (const receipt of task.retry_history ?? []) {
+      const previous = taskAssignment(state, { ...task, attempt: receipt.from_attempt, issued: receipt.issued });
+      if (!bindingHolds(previous, await io.readText(receipt.issued.prompt))) throw new Error(`Historical prompt binding mismatch for ${task.spec.id} attempt ${receipt.from_attempt}; preserve the run.`);
+    }
+  }
+}
+
+export async function readRunContext<Domain>(store: RunStore<Domain>, supplied?: RunState<Domain>): Promise<ReadContext<Domain>> {
+  const state = supplied ?? await store.read();
+  if (supplied) await verifyReferences(store.io, state);
+  const acceptedPayloads = new Map<string, unknown>();
+  const acceptedSubmissions = new Map<string, TaskSubmission>();
+  for (const [id, task] of Object.entries(state.tasks)) {
+    if (!task.accepted) continue;
+    const raw = TaskSubmissionSchema.parse(parseLifecycleJSON(await store.io.readText(task.accepted.raw))) as TaskSubmission;
+    if (raw.run_id !== state.run_id || raw.task_id !== id || raw.attempt !== task.attempt || raw.binding_sha256 !== task.issued?.binding_sha256 || raw.outcome !== task.accepted.outcome) throw new Error(`Accepted evidence identity mismatch for ${id}`);
+    const normalized = task.accepted.normalized ? TaskSubmissionSchema.parse(await store.io.readArtifact(task.accepted.normalized)) as TaskSubmission : raw;
+    if (normalized.run_id !== raw.run_id || normalized.task_id !== raw.task_id || normalized.attempt !== raw.attempt || normalized.binding_sha256 !== raw.binding_sha256 || normalized.outcome !== raw.outcome) throw new Error(`Normalized evidence identity mismatch for ${id}`);
+    acceptedSubmissions.set(id, normalized);
+    acceptedPayloads.set(id, normalized.payload);
+  }
+  return { state, acceptedPayloads, acceptedSubmissions };
+}
+
+/** The store itself rejects mutation of already-issued premises or accepted history. */
+function assertImmutableHistory<Domain>(before: RunState<Domain>, after: RunState<Domain>): void {
+  const same = (a: unknown, b: unknown): boolean => stableStringify(a) === stableStringify(b);
+  if (before.run_id !== after.run_id || before.mode !== after.mode || !same(before.source, after.source)) throw new Error("Run identity and frozen source are immutable");
+  if (before.basis && !same(before.basis, after.basis)) throw new Error("Pinned basis is immutable");
+  if (phaseOrder.indexOf(after.phase) < phaseOrder.indexOf(before.phase) || phaseOrder.indexOf(after.phase) > phaseOrder.indexOf(before.phase) + 1) throw new Error("Illegal lifecycle phase transition");
+  if (before.control === "cancelled" && after.control !== "cancelled") throw new Error("Cancelled run cannot resume");
+  for (const [id, task] of Object.entries(before.tasks)) {
+    const next = after.tasks[id];
+    if (!next || !same(task.spec, next.spec)) throw new Error(`Immutable task spec changed: ${id}`);
+    if (next.attempt < task.attempt || next.attempt > task.attempt + 1) throw new Error(`Invalid attempt transition: ${id}`);
+    const history = task.retry_history ?? [], nextHistory = next.retry_history ?? [];
+    if (nextHistory.length < history.length || !same(history, nextHistory.slice(0, history.length))) throw new Error(`Retry history is immutable: ${id}`);
+    if (task.issued && next.attempt === task.attempt + 1) {
+      const receipt = nextHistory[history.length];
+      if (next.status !== "issued" || !next.issued || nextHistory.length !== history.length + 1 ||
+          receipt?.from_attempt !== task.attempt || receipt.to_attempt !== next.attempt || !same(receipt.issued, task.issued)) throw new Error(`Retry requires an appended exact prior-attempt receipt: ${id}`);
+    } else if (nextHistory.length !== history.length) throw new Error(`Retry history can append only with a new attempt: ${id}`);
+    if (task.accepted && !same(task, next)) throw new Error(`Accepted task history is immutable: ${id}`);
+    if (task.issued && next.attempt === task.attempt && !same(task.issued, next.issued)) throw new Error(`Issued assignment is immutable: ${id}`);
+    if (task.issued && next.issued && next.attempt > task.attempt && !same(task.issued.inputs, next.issued.inputs)) throw new Error(`Retry cannot change resolved inputs: ${id}`);
+  }
+}
