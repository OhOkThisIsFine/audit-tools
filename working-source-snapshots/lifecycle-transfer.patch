+}
+
+/** Direct CLI and normal folding share the same exact attempt-bound ingestion. */
+export async function acceptAuditSubmission(directory: string, suppliedPath: string) {
+  const store = auditStore(directory);
+  const path = resolve(suppliedPath);
+  const state = await store.read();
+  const task = Object.values(state.tasks).find(record => record.issued && resolve(directory, record.issued.result_path) === path);
