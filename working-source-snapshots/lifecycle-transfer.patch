+// sites-pinned: tests/audit/accepted-lineage-projection.test.ts, tests/audit/host-ingest-grounding.test.ts, tests/audit/host-handoff.test.ts, tests/audit/ready-inspection-access.test.ts, tests/audit/lifecycle-audit-parity.test.ts
+import { join } from "node:path";
+import { z } from "zod";
+import { groundFinding, stableStringify } from "../../shared/index.js";
+import type { TaskDefinition } from "../../shared/engine/taskLifecycleTypes.js";
+import { WorkerFindingSchema, WORKER_REFUSED_FINDING_VERDICTS, WORKER_REFUSED_LOCATION_FIELDS } from "../contracts/workerSchemas.js";
+import { findingContractPromptLines } from "../contracts/findingContractPrompt.js";
+import { AuditResultSchema, lensDefinition } from "../types.js";
+import { sourceTreeInstruction } from "../io/runSnapshot.js";
+import { validateOneAuditResult, formatAuditResultIssues } from "../validation/auditResults.js";
+import { verificationContractFailure, verificationContractPromptLines } from "../validation/verificationContract.js";
+import { buildSelectiveDeepeningTasks } from "../orchestrator/selectiveDeepening/index.js";
+import { architectureDiscoveryTasks } from "../orchestrator/architectureDiscovery.js";
+import { LENS_VERIFICATION_TAG } from "../orchestrator/selectiveDeepening/shared.js";
+import {
+  InspectionSubjectSchema, inspectionSubject, inspectionSpec, inspectionScopeComplete,
+  projectAuditBundle, projectCompletedInspectionResults, residualInspectionSpec, bindAddedInspectionSurfaces, type AuditDomain,
+} from "./auditDomain.js";
+
+const WorkerInspectionSchema = z.object({
+  file_coverage: z.array(z.object({ path: z.string().min(1), total_lines: z.number().int().nonnegative() }).strict()),
+  findings: z.array(WorkerFindingSchema),
+  reviewed_clean: z.boolean().optional(),
+  verification: z.unknown().optional(),
+}).strict();
+
+function parseWorkerInspection(value: unknown): z.infer<typeof WorkerInspectionSchema> {
+  const findings = (value as { findings?: unknown } | null)?.findings;
+  if (Array.isArray(findings)) for (const [index, finding] of findings.entries()) {
+    if (!finding || typeof finding !== "object") continue;
+    for (const [field, message] of Object.entries(WORKER_REFUSED_FINDING_VERDICTS)) if (field in finding) throw new Error(`Finding contract: findings[${index}].${field}: ${message}`);
+    if (Array.isArray(finding.affected_files)) for (const [locationIndex, location] of finding.affected_files.entries()) {
+      if (!location || typeof location !== "object") continue;
+      for (const [field, message] of Object.entries(WORKER_REFUSED_LOCATION_FIELDS)) if (field in location) throw new Error(`Finding contract: findings[${index}].affected_files[${locationIndex}].${field}: ${message}`);
+    }
+  }
+  const parsed = WorkerInspectionSchema.safeParse(value);
+  if (!parsed.success) throw new Error(`Inspection/finding contract: ${parsed.error.issues.map(issue => `${issue.path.map((part, index) => typeof part === "number" ? `[${part}]` : `${index ? "." : ""}${part}`).join("")}: ${issue.message}`).join("; ")}`);
+  return parsed.data;
+}
+
+export function inspectionDefinition(selective = false): TaskDefinition<AuditDomain> {
+  return {
+    kind: selective ? "audit.selective-inspection" : "audit.inspection",
+    phase: "executing", completion: selective ? "selective" : "complete", execution: "host", effect: "read_only",
+    parseSubject: value => InspectionSubjectSchema.parse(value),
+    // Tool-enriched accepted values have an AuditResult shape; only raw ingress goes through the worker projection.
+    parsePayload: parseWorkerInspection,
+    render: (issued, context) => {
+      const task = inspectionSubject(issued.spec).task;
+      const lens = lensDefinition(task.lens);
+      const steward = task.tags?.includes(LENS_VERIFICATION_TAG);
+      const { file_paths, file_line_counts: _counts, file_metrics: _metrics, ...compact } = task;
+      const surface = issued.inputs.surface;
+      if (selective && !surface) throw new Error("Selective inspection requires an immutable ranked surface input.");
+      return [
+        "Perform this bounded audit against the immutable pinned basis. Do not change source or the question.",
+        sourceTreeInstruction(context.state.domain.source_root),
+        `Assignment: ${stableStringify(selective ? { ...compact, surface_file_count: file_paths.length } : task)}`,
+        ...(selective ? [`Read the complete ranked surface and pinned counts from ${join(context.state.domain.artifacts_dir, surface!.path)}. Select relevant files without copying the entire surface into this prompt.`] : []),
+        lens ? `Lens guidance: ${lens.focus}\nDo not report under this lens: ${lens.do_not_report}` : `Custom lens: ${task.lens}; no canonical guidance is registered. Follow the explicit assignment without claiming a built-in lens definition.`,
+        selective ? "Choose the relevant files on the assigned surface. Declare only files actually reviewed; no whole-surface claim is required."
+          : "Review every assigned file. If only a subset is completed, return outcome partial and only those completed files. The tool creates the exact remaining task; never claim unperformed coverage.",
+        "Each file_coverage entry contains exactly path and total_lines and covers that complete file. Counts describe scope, not proof that the file was understood.",
+        "Payload contains file_coverage, findings, and reviewed_clean: true only when no findings were found. Do not supply task identity or grounding; the tool derives both.",
+        "Do not supply a `grounding` field or a `verification_status` field; these verdicts are tool-computed at ingest.",
+        ...findingContractPromptLines(),
+        ...(steward ? verificationContractPromptLines() : ["Do not supply verification metadata on this ordinary inspection task."]),
+      ].join("\n\n");
+    },
+    validate: async (issued, raw, context, submission) => {
+      const payload = WorkerInspectionSchema.parse(raw);
+      const task = inspectionSubject(issued.spec).task;
+      const errors: string[] = [];
+      const covered = new Set<string>();
+      for (const file of payload.file_coverage) {
+        if (!task.file_paths.includes(file.path)) errors.push(`Coverage outside issued scope: ${file.path}`);
+        if (covered.has(file.path)) errors.push(`Duplicate coverage: ${file.path}`);
+        covered.add(file.path);
+        if (file.total_lines !== task.file_line_counts?.[file.path]) errors.push(`Wrong pinned line count: ${file.path}`);
+      }
+      if (covered.size === 0) errors.push("No-progress inspection must remain blocked; it cannot generate an identical residual.");
+      const complete = selective || task.file_paths.every(path => covered.has(path));
+      if (submission.outcome !== (complete ? "complete" : "partial")) errors.push(`This coverage requires outcome ${complete ? "complete" : "partial"}.`);
+      const steward = task.tags?.includes(LENS_VERIFICATION_TAG) ?? false;
+      if (steward !== (payload.verification !== undefined)) errors.push(steward ? "Lens steward verification is required." : "Verification was not requested for this task.");
+      if (steward) {
+        const failure = verificationContractFailure(payload.verification, { lens: task.lens, file_line_counts: task.file_line_counts ?? {} }, payload);
+        if (failure) errors.push(failure);
+      }
+      // construction-site: AuditResult
+      const result = AuditResultSchema.parse({
+        task_id: task.task_id, unit_id: task.unit_id, pass_id: task.pass_id, lens: task.lens,
+        file_coverage: payload.file_coverage,
+        // construction-site: Finding (validated worker fields become canonical findings before grounding)
+        findings: payload.findings.map(finding => ({ ...finding, lens: finding.lens ?? task.lens, evidence_lane: "per-file-lane" })),
+        ...(payload.reviewed_clean === undefined ? {} : { reviewed_clean: payload.reviewed_clean }),
+        ...(payload.verification === undefined ? {} : { verification: payload.verification }),
+        run_id: issued.run_id,
+      });
+      const knownPaths = new Set(context.state.domain.preparation.repo_manifest?.files.map(file => file.path) ?? []);
+      for (const finding of result.findings) await groundFinding(context.state.domain.source_root, finding, undefined, knownPaths);
+      // Subset validation is deliberate: lifecycle completion below, not a fake full-coverage assertion, owns the remainder.
+      const inspectedTask = { ...task, coverage_policy: "selective" as const };
+      errors.push(...validateOneAuditResult(result, [inspectedTask], { lineIndex: context.state.domain.line_index })
+        .filter(issue => issue.severity === "error").map(issue => formatAuditResultIssues([issue])));
+      return { errors, normalizedPayload: result };
+    },
+    reduce: (issued, normalized, context) => {
+      const result = AuditResultSchema.parse(normalized);
+      const basis = context.state.basis;
+      if (!basis) throw new Error("Cannot accept inspection without a sealed basis.");
+      const covered = new Set(result.file_coverage.map(file => file.path));
+      const residual = selective ? undefined : residualInspectionSpec(issued.spec, covered, basis);
+      const projected = projectAuditBundle(context);
+      const results = projectCompletedInspectionResults(context, result);
+      const followups = buildSelectiveDeepeningTasks({
+        existingTasks: projected.audit_tasks ?? [], results,
+        lineIndex: context.state.domain.line_index,
+        externalAnalyzerResults: projected.external_analyzer_results,
+      });
+      const existing = new Set((projected.audit_tasks ?? []).map(task => task.task_id));
+      const discoveries = architectureDiscoveryTasks({ ...projected, audit_results: results }, context.state.domain.line_index).filter(task => !existing.has(task.task_id));
+      const additions = [...new Map([...followups, ...discoveries].map(task => [task.task_id, task])).values()].map(task => inspectionSpec(task, basis, [{ task_id: issued.spec.id, requires: "accepted_evidence" }]));
+      const surfaceOutputs = bindAddedInspectionSurfaces(additions, issued.spec.id);
+      return { addTasks: [...(residual ? [residual] : []), ...additions], outputs: { evidence: result, ...surfaceOutputs } };
+    },
+    requiredScopeComplete: (task, context) => inspectionScopeComplete(task.spec.id, context),
+  };
+}
