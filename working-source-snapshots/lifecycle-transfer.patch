+/** Fixed accepted evidence through the real lifecycle; no provider or runtime command runs. */
+import { test, expect, vi } from "vitest";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { acceptSubmission, advanceRun, issueTasks, readyTasks } from "../../src/shared/engine/taskLifecycle.js";
+import { readRunContext } from "../../src/shared/engine/taskLifecycleStore.js";
+import type { IssuedTask, ReadContext } from "../../src/shared/engine/taskLifecycleTypes.js";
+import { inspectionSpec, inspectionSubject, isInspectionTask, projectAuditBundle, projectCompletedInspectionResults, type AuditDomain } from "../../src/audit/lifecycle/auditDomain.js";
+import { runtimeTask } from "../../src/audit/lifecycle/runtimeTask.js";
+import { drawAuditRun } from "../../src/audit/lifecycle/auditRun.js";
+import { architectureDiscoveryTasks } from "../../src/audit/orchestrator/architectureDiscovery.js";
+import { EXECUTOR_RUNNERS } from "../../src/audit/orchestrator/executorRunners.js";
+import { DEEPENING_TAG } from "../../src/audit/orchestrator/selectiveDeepening/shared.js";
+import type { AuditResult, Finding } from "../../src/audit/types.js";
+import { fixedAuditInspectionRun, writeAuditInspectionSubmission } from "./helpers/lifecycleFixture.js";
+
+type Fixture = Awaited<ReturnType<typeof fixedAuditInspectionRun>>;
+const residualFinding: Finding = {
+  id: "RESIDUAL-FINDING", title: "Residual validation boundary", category: "correctness", lens: "correctness",
+  severity: "high", confidence: "medium", summary: "The second file retains an independently observed validation defect.",
+  affected_files: [{ path: "b.ts", quoted_text: 'export const value = "b.ts";' }], evidence: ["b.ts:1"],
+};
+async function submit(f: Fixture, task: IssuedTask, paths: string[], findings: Finding[] = [], outcome: "complete" | "partial" = "complete") {
+  const path = await writeAuditInspectionSubmission(f.store, task, paths, outcome);
+  const absolute = join(f.artifactsDir, path);
+  const submission = JSON.parse(await readFile(absolute, "utf8"));
+  submission.payload.findings = findings;
+  submission.payload.reviewed_clean = findings.length === 0;
+  await writeFile(absolute, JSON.stringify(submission));
+  await acceptSubmission(f.store, path, f.policy);
+}
+async function finishBase(f: Fixture, partial: boolean, findings: Finding[] = []) {
+  const [base] = await issueTasks(f.store, ["inspect-0"], f.policy);
+  await submit(f, base!, partial ? ["a.ts"] : ["a.ts", "b.ts"], partial ? [] : findings, partial ? "partial" : "complete");
+  if (partial) {
+    const before = await readRunContext(f.store);
+    expect(projectAuditBundle(before).audit_results).toHaveLength(1);
+    expect(projectCompletedInspectionResults(before)).toEqual([]);
+    expect(followupTasks(before)).toEqual([]);
+    const residual = readyTasks(before, f.policy).find(task => inspectionSubject(task).parent_task_id === base!.spec.id)!;
+    const [issued] = await issueTasks(f.store, [residual.id], f.policy);
+    await submit(f, issued!, ["b.ts"], findings);
+  }
+}
+function followupTasks(context: ReadContext<AuditDomain>) {
+  return Object.values(context.state.tasks).filter(record => isInspectionTask(record.spec))
+    .map(record => inspectionSubject(record.spec).task).filter(task => task.tags?.includes(DEEPENING_TAG))
+    .sort((a, b) => a.task_id.localeCompare(b.task_id));
+}
+
+test.each([
+  { name: "high-risk clean", lens: "correctness", finding: false },
+  { name: "security steward", lens: "security", finding: false },
+  { name: "finding follow-up", lens: "correctness", finding: true },
+])("runtime preserves whole-versus-residual $name follow-up identity and scope", async ({ lens, finding }) => {
+  const roots: string[] = [];
+  const report = { results: [{ task_id: "fixed-runtime", status: "confirmed" as const, summary: "Fixed successful observation" }] };
+  const runner = vi.spyOn(EXECUTOR_RUNNERS, "runtime_validation_executor").mockImplementation(async bundle => ({
+    updated: { ...bundle, runtime_validation_report: report }, artifacts_written: [], progress_summary: "Fixed observation only",
+  }));
+  try {
+    const outcomes = [];
+    for (const partial of [false, true]) {
+      const root = await mkdtemp(join(tmpdir(), "accepted-lineage-runtime-")); roots.push(root);
+      const f = await fixedAuditInspectionRun(root, { groups: [["a.ts", "b.ts"]], taskOverrides: { priority: "high", lens } });
+      const planned = { runtime_validation_tasks: { tasks: [{ id: "fixed-runtime", kind: "unit-risk-check" as const,
+        target_paths: ["a.ts", "b.ts"], reason: "Fixed observation", priority: "low" as const }] } };
+      const bundle = await f.store.io.writeArtifact(planned);
+      await f.store.mutate(async state => {
+        const base = state.tasks["inspect-0"]!;
+        state.domain.preparation.runtime_validation_tasks = planned.runtime_validation_tasks;
+        const spec = runtimeTask(bundle, [base.spec]); state.tasks[spec.id] = { spec, status: "pending", attempt: 0 };
+        return state;
+      });
+      await finishBase(f, partial, finding ? [residualFinding] : []);
+      const before = await readRunContext(f.store);
+      const accepted = [...before.acceptedPayloads.entries()];
+      const bodies = await Promise.all(Object.values(before.state.tasks).filter(record => record.accepted)
+        .map(async record => ({ ref: record.accepted!.raw, bytes: await f.store.io.readText(record.accepted!.raw) })));
+      const draw = await advanceRun(f.store, f.policy, { draw: "deterministic", maxExecutions: 1 });
+      expect(draw.executions).toBe(1); expect(draw.state.tasks["audit.runtime-validation"]!.status).toBe("accepted");
+      const after = await readRunContext(f.store);
+      for (const [id, payload] of accepted) expect(after.acceptedPayloads.get(id)).toEqual(payload);
+      for (const body of bodies) expect(await f.store.io.readText(body.ref)).toBe(body.bytes);
+      expect(projectAuditBundle(after).audit_results).toHaveLength(partial ? 2 : 1);
+      outcomes.push(followupTasks(after));
+    }
+    expect(outcomes[0]!.length).toBeGreaterThan(0);
+    expect(outcomes[1]).toEqual(outcomes[0]);
+    expect(runner).toHaveBeenCalledTimes(2);
+  } finally { runner.mockRestore(); await Promise.all(roots.map(root => rm(root, { recursive: true, force: true }))); }
+});
+
+test("final synthesis attributes the complete accepted architecture lineage, not its clean partial parent", async () => {
+  const root = await mkdtemp(join(tmpdir(), "accepted-lineage-synthesis-"));
+  try {
+    const f = await fixedAuditInspectionRun(root, { groups: [["a.ts", "b.ts"]] });
+    const source: Finding = { id: "SOURCE-DISCOVERY", title: "Shared ownership assumption", category: "architecture", lens: "architecture",
+      severity: "high", confidence: "medium", summary: "The two modules disagree on ownership.",
+      affected_files: [{ path: "a.ts" }, { path: "b.ts" }], evidence: ["Fixed accepted preparation finding"] };
+    let followupId = "";
+    await f.store.mutate(async state => {
+      state.domain.preparation.design_assessment = { generated_at: "2026-01-01T00:00:00Z", findings: [], contract_findings: [source] };
+      const [task] = architectureDiscoveryTasks(state.domain.preparation, state.domain.line_index);
+      followupId = task!.task_id;
+      const spec = inspectionSpec(task!, state.basis!); state.tasks[spec.id] = { spec, status: "pending", attempt: 0 };
+      return state;
+    });
+    await finishBase(f, false);
+    const [parent] = await issueTasks(f.store, [followupId], f.policy);
+    await submit(f, parent!, ["a.ts"], [], "partial");
+    const partialContext = await readRunContext(f.store);
+    const parentRecord = partialContext.state.tasks[followupId]!.accepted!;
+    const parentBytes = await f.store.io.readText(parentRecord.raw);
+    expect(partialContext.state.phase).toBe("executing");
+    const residual = readyTasks(partialContext, f.policy).find(task => inspectionSubject(task).parent_task_id === followupId)!;
+    const [issued] = await issueTasks(f.store, [residual.id], f.policy);
+    await submit(f, issued!, ["b.ts"], [{ ...residualFinding, lens: "architecture", severity: "medium" }]);
+    const rawResults = projectAuditBundle(await readRunContext(f.store)).audit_results!;
+    expect(rawResults.find(result => result.task_id === followupId)!.findings).toEqual([]);
+    expect(rawResults.find(result => result.task_id === residual.id)!.findings[0]!.id).toBe("RESIDUAL-FINDING");
+    const complete = await drawAuditRun(f.store, "full", 16);
+    expect(complete.stopped).toBe("complete");
+    const findings = await f.store.io.readArtifact(complete.state.deliverables!.findings!) as { findings: Finding[] };
+    const discovery = findings.findings.find(finding => finding.title === source.title)!;
+    expect(discovery).toBeDefined();
+    const attribution = discovery.evidence!.filter(entry => entry.startsWith("Independent follow-up"));
+    expect(attribution).toHaveLength(1);
+    expect(attribution[0]).toContain("RESIDUAL-FINDING");
+    expect(attribution[0]).not.toContain("No additional finding reported");
+    expect(findings.findings.some(finding => finding.title === residualFinding.title)).toBe(true);
+    expect(await f.store.io.readText(parentRecord.raw)).toBe(parentBytes);
+    expect(complete.state.tasks[followupId]!.accepted).toEqual(parentRecord);
+    const after = await readRunContext(f.store);
+    expect(projectAuditBundle(after).audit_results).toEqual(rawResults);
+    expect((after.acceptedPayloads.get(followupId) as AuditResult).findings).toEqual([]);
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
