+// sites-pinned: tests/remediate/remediation-outcomes.test.ts, tests/remediate/outcomes-roundtrip.test.ts
+/** Read-only reports over the accepted ledger. No projected item can grant work. */
+import { renderPromptCommand, type ReadContext } from "audit-tools/shared";
+import { approvedPlanning } from "../contractPipeline/planningLifecycle.js";
+import { acceptedIntent, intakeCoverage } from "../steps/taskLifecycleIntake.js";
+import { LandingPayloadSchema, LandingSubjectSchema, LANDING_TASK_KIND, FINAL_LANDING_TASK_KIND, TriagePayloadSchema } from "../steps/dispatch/taskLifecycleLanding.js";
+import type { RemediationDomain } from "./taskLifecycleDomain.js";
+import type { RemediationState } from "./reportTypes.js";
+import type { RemediationItemState } from "./types.js";
+
+export function projectRemediationState(ctx: ReadContext<RemediationDomain>): RemediationState {
+  const domain = ctx.state.domain, approved = approvedPlanning(ctx), canonical = approved?.canonical ?? domain.planning.canonical;
+  const intent = acceptedIntent(ctx);
+  const view: RemediationState = {
+    contract_version: "remediate-code-state/v2",
+    status: ctx.state.phase === "complete" ? "complete" : ctx.state.phase === "finalizing" ? "closing" : ctx.state.phase === "executing" ? "implementing" : "planning",
+    started_at: domain.started_at,
+    run_start_dirty: [...domain.run_start_dirty], run_start_dirty_encoding: domain.run_start_dirty_encoding,
+    closing_plan: { action: intent?.closing_action ?? "none", ...(intent?.closing_custom_command ? { custom_command: intent.closing_custom_command } : {}), pre_authorized: true },
+    conformance_review: { run_id: ctx.state.run_id, enabled: domain.conformance_review },
+  };
+  if (!canonical) return view;
+  const facts = domain.intake.project_facts;
+  const test = domain.intake.verification_command ?? (Array.isArray(facts.commands.test) ? renderPromptCommand(facts.commands.test as string[]) : undefined);
+  const e2e = Array.isArray(facts.commands.e2e) ? renderPromptCommand(facts.commands.e2e as string[]) : undefined;
+  view.plan = {
+    ...canonical.plan, findings: domain.intake.source.findings, request: domain.planning.source.request,
+    audit_read: domain.planning.source.audit_read, review_revision_sha256: canonical.revision_sha256,
+    review_counterexamples: approved?.counterexamples ?? domain.planning.history.counterexamples,
+    project_type: facts.project_type, candidate_closing_actions: facts.candidate_closing_actions,
+    ...(test ? { test_command: test, test_command_source: domain.intake.verification_command ? "explicit" : "project_facts" } : {}),
+    ...(e2e ? { e2e_command: e2e, e2e_command_source: "project_facts" } : {}),
+  };
+  const items: Record<string, RemediationItemState> = {};
+  const declined = new Map(approved?.ownerDecision?.declined_units.map(unit => [unit.id, unit.reason]) ?? []);
+  for (const unit of canonical.plan.units) {
+    const item: RemediationItemState = { unit_id: unit.id, status: "pending" };
+    if (declined.has(unit.id)) { item.status = "deemed_inappropriate"; item.failure_reason = declined.get(unit.id); }
+    let record = ctx.state.tasks[`land:${unit.id}`];
+    const visited = new Set<string>();
+    while (record && !visited.has(record.spec.id)) {
+      visited.add(record.spec.id);
+      if (record.spec.kind !== LANDING_TASK_KIND || record.status !== "accepted") break;
+      const payload = LandingPayloadSchema.parse(ctx.acceptedPayloads.get(record.spec.id));
+      const subject = LandingSubjectSchema.parse(record.spec.subject);
+      item.rework_count = subject.repair_round ?? 0;
+      if (payload.status === "landed" || payload.status === "resolved_no_change") {
+        item.status = payload.verified ? payload.status === "landed" ? "resolved" : "resolved_no_change" : "blocked";
+        item.host_result_evidence = payload.status === "landed" ? payload.obligation_evidence.flatMap(entry => entry.evidence) : payload.evidence;
+        if (payload.status === "landed") item.host_landed_commit = payload.landed_commit;
+        if (payload.verified) {
+          item.host_landed_files = payload.verified.changed_files;
+          item.conformance_review = payload.verified.conformance_review;
+        }
+        delete item.failure_reason; break;
+      }
+      item.status = payload.status === "blocked" ? "blocked" : "needs_clarification";
+      item.failure_reason = payload.status === "blocked" ? payload.failure_reason : payload.question;
+      const triage = ctx.state.tasks[`${record.spec.id}:triage`];
+      if (triage?.status !== "accepted") break;
+      const decision = TriagePayloadSchema.parse(ctx.acceptedPayloads.get(triage.spec.id));
+      if (decision.action !== "retry") {
+        item.status = decision.action === "ignore" ? "ignored" : "blocked";
+        item.failure_reason = decision.rationale;
+        if (decision.action === "halt") view.closing_context = "user_halted";
+        break;
+      }
+      const repair = ctx.state.tasks[`${triage.spec.id}:repair:land`];
+      if (!repair) break;
+      const repairSubject = LandingSubjectSchema.parse(repair.spec.subject);
+      if (repairSubject.parent_task !== record.spec.id || repairSubject.decision_task !== triage.spec.id) break;
+      record = repair;
+    }
+    items[unit.id] = item;
+  }
+  // Explicit final repair landings enrich the same source/unit report, never rewrite earlier accepted facts.
+  for (const record of Object.values(ctx.state.tasks)) {
+    if (record.spec.kind !== FINAL_LANDING_TASK_KIND || record.status !== "accepted") continue;
+    const subject = LandingSubjectSchema.parse(record.spec.subject), payload = LandingPayloadSchema.parse(ctx.acceptedPayloads.get(record.spec.id));
+    const item = items[subject.unit.id];
+    if (!item || (payload.status !== "landed" && payload.status !== "resolved_no_change") || !payload.verified) continue;
+    item.status = payload.status === "landed" ? "resolved" : "resolved_no_change";
+    item.host_result_evidence = [...(item.host_result_evidence ?? []), ...(payload.status === "landed" ? payload.obligation_evidence.flatMap(entry => entry.evidence) : payload.evidence)];
+    item.host_landed_files = [...new Set([...(item.host_landed_files ?? []), ...payload.verified.changed_files])];
+    if (payload.status === "landed") item.host_landed_commit = payload.landed_commit;
+    if (payload.verified.conformance_review) item.conformance_review = payload.verified.conformance_review;
+    item.rework_count = (item.rework_count ?? 0) + 1;
+    delete item.failure_reason;
+  }
+  view.items = items;
+  view.applied_edit_surface = [...new Set(Object.values(items).flatMap(item => item.host_landed_files ?? []))].sort();
+  view.plan_coverage = intakeCoverage(ctx, canonical.plan.units);
+  view.finding_dispositions = Object.fromEntries((domain.intake.decision?.declined ?? []).map(entry => [entry.finding_id, { status: "declined", reason: entry.reason }]));
+  const deferrals = approved?.ownerDecision?.deferred_findings;
+  if (deferrals?.length) view.owner_deferred_reasons = Object.fromEntries(deferrals.map(entry => [entry.finding_id, entry.reason]));
+  return view;
+}
