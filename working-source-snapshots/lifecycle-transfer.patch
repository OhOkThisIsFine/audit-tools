+// sites-pinned: tests/shared/task-lifecycle-errors.test.ts, tests/audit/host-ingest-issue-codes.test.ts
+import type { IngestionCheckId } from "../submission/submissionClassifier.js";
+
+export type LifecycleSubmissionErrorCode =
+  | "submission_missing"
+  | "submission_malformed"
+  | "submission_contract_invalid"
+  | "result_validation_failed"
+  | "workload_stale"
+  | "duplicate_result"
+  | "submission_io_error"
+  | "run_stopped";
+
+/** Repair diagnostics only. The checkpoint remains the sole acceptance authority. */
+export class LifecycleSubmissionError extends Error {
+  readonly code: LifecycleSubmissionErrorCode;
+  readonly check: IngestionCheckId;
+  readonly task_id?: string;
+  readonly result_path: string;
+
+  constructor(message: string, detail: {
+    code: LifecycleSubmissionErrorCode;
+    check: IngestionCheckId;
+    task_id?: string;
+    result_path: string;
+    cause?: unknown;
+  }) {
+    super(message, detail.cause === undefined ? undefined : { cause: detail.cause });
+    this.name = "LifecycleSubmissionError";
+    this.code = detail.code;
+    this.check = detail.check;
+    this.task_id = detail.task_id;
+    this.result_path = detail.result_path;
+  }
+}
