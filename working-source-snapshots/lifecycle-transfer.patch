+          if (submitted.base_revision_sha256 !== (p.canonical?.revision_sha256 ?? null)) errors.push("The submission's base revision is stale.");
+          if (p.round > 8) errors.push("The review-repair bound is spent; explicitly start a new preparation run or cancel.");
+          let plan;
+          try { plan = normalizeExecutionPlanPaths(options.root, submitted.plan); } catch (error) { return { errors: [...errors, String(error)] }; }
+          errors.push(...executionPlanIssues(options.root, p.source, plan));
+          const retired = new Map(submitted.retired_requirements.map(r => [r.id, r]));
+          for (const previous of p.canonical?.plan.requirements ?? []) if (!plan.requirements.some(r => r.id === previous.id)) {
+            const decision = retired.get(previous.id);
+            if (!decision) errors.push(`Requirement ${previous.id} disappeared without an explicit retirement reason.`);
+            else if (decision.replaced_by.some(id => !plan.requirements.some(r => r.id === id))) errors.push(`Requirement ${previous.id} has a missing replacement.`);
+          }
+          for (const id of p.history.accepted_ids) {
+            const example = p.history.counterexamples.find(entry => entry.id === id);
+            if (!example) { errors.push(`Accepted counterexample ${id} has no retained evidence.`); continue; }
+            const associated = plan.units.filter(unit => example.unit_ids.includes(unit.id) ||
+              unit.requirement_ids.some(requirement => example.requirement_ids.includes(requirement)));
+            // Disposition-only repairs must not invent execution work. The judge
+            // still classifies every accepted counterexample against fresh evidence.
+            if (associated.length && !associated.some(unit => unit.addresses_counterexample_ids.includes(id))) errors.push(`Accepted counterexample ${id} must remain addressed by its associated execution work.`);
+          }
+          let context;
+          try { context = await captureExecutionContext(options.root, plan); } catch (error) { return { errors: [...errors, String(error)] }; }
+          for (const unit of plan.units) for (const path of unit.read_paths) if (context.some(c => c.path === path.replace(/\/$/u, "") && c.sha256 === null)) errors.push(`Unit ${unit.id} read context ${path} does not exist.`);
+          const sourceHash = hashContent(stableStringify(p.source));
+          const canonical: CanonicalPlan = { contract_version: "remediate-code-executable-plan/v1", source_sha256: sourceHash, revision_sha256: executionPlanRevision(plan, sourceHash, context), context_files: context, plan };
+          return { errors, normalizedPayload: canonical, observation: { canonical, sources: p.source.sources } };
+        }
+        if (!p.canonical) return { errors: [...errors, "No accepted canonical plan exists."] };
+        errors.push(...await executionPlanContextIssues(options.root, p.canonical));
+        if (role === "owner") errors.push(...ownerIssues(raw, p.canonical));
+        else if (role === "risk") {
+          const risk = PlanRiskDecisionSchema.parse(raw);
+          const judge = PlanJudgeSchema.parse(review(ctx, "judge").result);
