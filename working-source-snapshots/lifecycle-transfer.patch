+// sites-pinned: tests/shared/obligation-not-applicable-is-inert.test.ts
+/**
+ * Read-only vocabulary for previously written audit display artifacts.
+ *
+ * This is not lifecycle state and contains no scheduling or mutation logic.
+ * New runs use RunState and TaskRecord exclusively. Retained only so existing
+ * wrapper/artifact readers can describe historical displays without treating
+ * their contents as authority for the current run.
+ */
+import { z } from "zod";
+
+export const ObligationStateSchema = z.enum([
+  "missing", "present", "stale", "blocked", "satisfied", "not_applicable",
+]);
+export type ObligationState = z.infer<typeof ObligationStateSchema>;
+export const ObligationSchema = z.object({
+  id: z.string(),
+  state: ObligationStateSchema,
+  reason: z.string().optional(),
+}).strict();
+export type Obligation = z.infer<typeof ObligationSchema>;
