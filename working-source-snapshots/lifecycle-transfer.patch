@@ -0,0 +1,193 @@
+import { afterEach, expect, test } from "vitest";
+import { readFile, rm, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import type { ExecutableChangePlan, Finding } from "audit-tools/shared";
+import { buildAuditFindingsReport, buildAuditReportModel } from "../../src/audit/reporting/synthesis.js";
+import { readRunContext } from "../../src/shared/engine/taskLifecycleStore.js";
+import { approvedPlanning, type PlanningContext } from "../../src/remediate/contractPipeline/planningLifecycle.js";
+import { createIntakeEntryFixture } from "./helpers/intakeEntryFixture.js";
+import { createExecutablePlanFixture } from "./helpers/executablePlanFixture.js";
+
+const roots: string[] = [];
+afterEach(async () => { await Promise.all(roots.splice(0).map(root => rm(root, { recursive: true, force: true }))); });
+const independent = (result: unknown) => ({ review: { mode: "independent", reason: "Separate boundary-regression reviewer" }, result });
+/** Compare the labelled prompt payload semantically; artifact JSON uses canonical key order. */
+function renderedPlanningContext(prompt: string): PlanningContext {
+  const blocks = [...prompt.matchAll(/^Accepted derived finding context:\r?\n([^\r\n]+)\r?$/gmu)];
+  expect(blocks).toHaveLength(1);
+  return JSON.parse(blocks[0]![1]!) as PlanningContext;
+}
+function finding(id: string, overrides: Partial<Finding> = {}): Finding {
+  return { id, title: "Preserve greeting output", category: "greeting", severity: "high", confidence: "high",
+    lens: "correctness", summary: "The greeting behavior needs review", affected_files: [{ path: "index.js" }],
+    evidence: ["index.js:1 exports greeting"], ...overrides };
+}
+
+/** Separate source reports keep cross-lens merging at the remediation intake boundary under test. */
+async function intakeWithFindings(findings: Finding[]) {
+  const f = await createIntakeEntryFixture(); roots.push(f.root);
+  const reports = findings.map((entry, index) => buildAuditFindingsReport(buildAuditReportModel({ results: [{
+    task_id: `task-${index}`, unit_id: `unit-${index}`, pass_id: `pass-${index}`, lens: entry.lens,
+    file_coverage: [], findings: [entry],
+  }] }), null));
+  const paths = reports.map((_report, index) => join(f.root, `source-${index}.json`));
+  await Promise.all(reports.map((report, index) => writeFile(paths[index]!, JSON.stringify(report))));
+  await f.next({ input: paths });
+  await f.confirm({ source_type: "structured_audit", affected_files: [] });
+  return { ...f, paths, originals: reports.flatMap(report => report.findings) };
+}
+
+test.each(["merged", "ungrounded"] as const)("accepted %s finding context reaches planning without rewriting originals", async mode => {
+  const inputs = mode === "merged" ? [
+    finding("F-first", { affected_files: [{ path: "index.js" }, { path: "phantom.js" }], evidence: ["index.js:1 primary greeting evidence"] }),
+    finding("F-second", { lens: "security", evidence: ["index.js:1 absorbed second-lens evidence"] }),
+  ] : [finding("F-ungrounded", { evidence: ["An ungrounded high-level claim without any source citation"] })];
+  const f = await intakeWithFindings(inputs);
+  const state = await f.state(), filter = state.domain.intake.filter!;
+  expect(filter.survivors).toHaveLength(1);
+  const survivor = filter.survivors[0]!;
+  expect(survivor.evidence_grounded).toBe(mode === "merged");
+  if (mode === "merged") {
+    expect(filter.mergeMap).toHaveLength(1);
+    expect(survivor.evidence).toContain("index.js:1 absorbed second-lens evidence");
+    expect(survivor.affected_files).toEqual([{ path: "index.js" }]);
+  } else expect(survivor.confidence).toBe("low");
+  expect(state.domain.intake.source.findings).toEqual(f.originals);
+  expect(state.domain.planning.source.findings).toEqual(f.originals.filter(original => original.id === survivor.id));
+  const contextRef = (await f.issued()).issued!.inputs.selected_context!;
+  expect(contextRef).toBeDefined();
+  const selectedContext = await f.store.lifecycle().io.readArtifact(contextRef);
+  expect(selectedContext).toEqual({ contract_version: "remediate-code-planning-context/v1", findings: [survivor], mergeMap: filter.mergeMap, phantomPathsRemoved: filter.phantomPathsRemoved });
+  const authorContext = renderedPlanningContext(await f.prompt());
+  expect(authorContext).toEqual(selectedContext);
+  expect(authorContext.findings).toEqual([survivor]);
+
+  const plan: ExecutableChangePlan = { plan_id: state.run_id, objective: "Review the grounded greeting claim",
+    non_goals: [], requirements: [], units: [], source_dispositions: [{
+      finding_id: survivor.id, status: "deferred", reason: "Wait for the owner dependency", evidence: ["index.js:1 reviewed existing greeting"],
+    }] };
+  await f.reply({ base_revision_sha256: null, plan, retired_requirements: [] }, "remediation.plan.author");
+  await f.reply({ revision_sha256: (await f.state()).domain.planning.canonical!.revision_sha256, confirmed_by: "host",
+    approved_unit_ids: [], declined_units: [], deferred_findings: [{ finding_id: survivor.id, reason: "Wait for the owner dependency" }],
+  }, "remediation.plan.owner");
+  expect((await f.issued()).spec.kind).toBe("remediation.plan.critique");
+  expect((await f.issued()).issued!.inputs.selected_context).toEqual(contextRef);
+  const critiqueContext = renderedPlanningContext(await f.prompt());
+  expect(critiqueContext).toEqual(selectedContext);
+  expect(critiqueContext.findings).toEqual([survivor]);
+  expect((await f.state()).domain.intake.source.findings).toEqual(f.originals);
+  expect((await f.state()).domain.intake.filter).toEqual(filter);
+  for (const [index, path] of f.paths.entries()) {
+    expect(JSON.parse(await readFile(path, "utf8")).findings).toEqual([f.originals[index]]);
+  }
+});
+
+test.each(["source", "request", "mixed"] as const)("a %s disposition repairs accepted criticism without inventing implementation", async mode => {
+  const original = finding("F-disposition", { affected_files: [{ path: "request.txt" }], evidence: ["request.txt:1 requested greeting"] });
+  const other = { ...original, id: "F-executable", title: "Add the requested greeting" };
+  const f = await createExecutablePlanFixture(mode === "request" ? [] : mode === "mixed" ? [original, other] : [original], { author: false }); roots.push(f.root);
+  const requirements = mode === "mixed" ? [{ ...f.plan.requirements[0]!, source_finding_ids: [other.id] }] : [];
+  const units = mode === "mixed" ? [{ ...f.plan.units[0]!, source_finding_ids: [other.id] }] : [];
+  const plan: ExecutableChangePlan = { plan_id: f.source.plan_id, objective: "Record the existing behavior accurately",
+    non_goals: [], requirements, units, source_dispositions: mode !== "request" ? [{
+      finding_id: original.id, status: "already_fixed", reason: "Original explanation", evidence: ["Original evidence needs correction"],
+    }] : [], ...(mode === "request" ? { request_disposition: {
+      status: "already_satisfied" as const, reason: "Original explanation", evidence: ["Original evidence needs correction"],
+    } } : {}) };
+  const assessment = (verdict: "satisfied" | "insufficient") => ({
+    requirement_assessments: requirements.map(requirement => ({ requirement_id: requirement.id, verdict: "satisfied", evidence: ["The separate executable requirement remains satisfied"] })),
+    disposition_assessments: mode !== "request" ? [{ finding_id: original.id, verdict, evidence: ["Checked source evidence"] }] : [],
+    ...(mode === "request" ? { request_disposition_assessment: { verdict, evidence: ["Checked request evidence"] } } : {}),
+  });
+  await f.submitPlan(plan);
+  await f.submitReview(await f.owner(), { verdict: "approved", issues: [] });
+  await f.submitReview(await f.next(), { counterexamples: [{
+    id: "CE-disposition", claim: "The no-change rationale cites the wrong evidence", reproduction_steps: ["Compare the rationale with request.txt"],
+    expected: "A precise evidence-backed disposition", actual: "The reason is not supported", requirement_ids: [], unit_ids: [],
+  }] });
+  await f.submitReview(await f.next(), { verdict: "needs_repair",
+    classifications: [{ counterexample_id: "CE-disposition", classification: "accepted", rationale: "Correct the cited evidence" }],
+    ...assessment("insufficient"),
+  });
+  const before = await f.store.read();
+  const revised: ExecutableChangePlan = { ...plan,
+    source_dispositions: plan.source_dispositions.map(entry => ({ ...entry, reason: "Corrected explanation", evidence: ["request.txt:1 specifies the bounded greeting"] })),
+    ...(plan.request_disposition ? { request_disposition: { ...plan.request_disposition, reason: "Corrected explanation", evidence: ["request.txt:1 specifies the bounded greeting"] } } : {}),
+  };
+  await f.submitPlan(revised);
+  expect(approvedPlanning(await readRunContext(f.store))).toBeUndefined();
+  await f.submitReview(await f.owner(), { verdict: "approved", issues: [] });
+  await f.submitReview(await f.next(), { counterexamples: [] });
+  const judge = await f.next();
+  const approval = { verdict: "approved", classifications: [], ...assessment("satisfied") };
+  await expect(f.submitReview(judge, approval)).rejects.toThrow(/every current\/previously accepted counterexample/);
+  await f.submitReview(judge, { ...approval, classifications: [{
+    counterexample_id: "CE-disposition", classification: "repaired", rationale: "The revised disposition now cites the actual source",
+  }] });
+  const after = await f.store.read();
+  expect(approvedPlanning(await readRunContext(f.store))?.canonical.plan.units).toEqual(units);
+  expect(Object.values(after.tasks).filter(task => task.spec.phase === "executing")).toEqual([]);
+  for (const [id, record] of Object.entries(before.tasks)) if (record.accepted) expect(after.tasks[id]).toEqual(record);
+});
+
+test("accepted owner deferral reason survives native final reporting independently of author rationale", async () => {
+  const f = await intakeWithFindings([finding("F-defer")]);
+  const source = (await f.state()).domain.planning.source, id = source.findings[0]!.id;
+  const authorReason = "The author suggests waiting for a dependency";
+  const ownerReason = "The owner explicitly defers until the compatibility contract is settled";
+  const plan: ExecutableChangePlan = { plan_id: source.plan_id, objective: "Preserve the owner deferral",
+    non_goals: [], requirements: [], units: [], source_dispositions: [{
+      finding_id: id, status: "deferred", reason: authorReason, evidence: ["index.js:1 existing implementation remains unchanged"],
+    }] };
+  await f.reply({ base_revision_sha256: null, plan, retired_requirements: [] }, "remediation.plan.author");
+  await f.reply({ revision_sha256: (await f.state()).domain.planning.canonical!.revision_sha256, confirmed_by: "host",
+    approved_unit_ids: [], declined_units: [], deferred_findings: [{ finding_id: id, reason: ownerReason }],
+  }, "remediation.plan.owner");
+  await f.reply(independent({ verdict: "approved", issues: [] }), "remediation.plan.critique");
+  await f.reply(independent({ counterexamples: [] }), "remediation.plan.critic");
+  await f.reply(independent({ verdict: "approved", classifications: [], requirement_assessments: [],
+    disposition_assessments: [{ finding_id: id, verdict: "satisfied", evidence: ["Compared explicit deferral to the unchanged source"] }],
+  }), "remediation.plan.judge");
+  const state = await f.state();
+  expect(state.phase).toBe("complete");
+  const io = f.store.lifecycle().io;
+  const outcomes = await io.readArtifact(state.deliverables!.outcomes!) as { outcomes: { finding_id: string; outcome: string; reason: string; finding: Finding }[] };
+  expect(outcomes.outcomes.find(entry => entry.finding_id === id)).toMatchObject({
+    outcome: "deferred", reason: ownerReason, finding: f.originals[0],
+  });
+  expect(await io.readText(state.deliverables!.report!)).toContain(ownerReason);
+  expect(state.domain.planning.canonical!.plan.source_dispositions[0]!.reason).toBe(authorReason);
+  expect(state.domain.intake.source.findings).toEqual(f.originals);
+});
+
+
+test("bound planning context excludes declined and unselected findings and refuses changed artifact bytes", async () => {
+  const f = await createIntakeEntryFixture(); roots.push(f.root);
+  const findings = [
+    finding("F-approved", { title: "Approved boundary", category: "approved", evidence: ["index.js:1 APPROVED-CONTEXT-MARKER"] }),
+    finding("F-declined", { title: "Declined boundary", category: "declined", evidence: ["index.js:1 DECLINED-CONTEXT-MARKER"] }),
+    finding("F-unselected", { title: "Unselected boundary", category: "unselected", severity: "low", evidence: ["index.js:1 UNSELECTED-CONTEXT-MARKER"] }),
