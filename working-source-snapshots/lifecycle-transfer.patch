-    phase: "next-step",
-    kind: "outcome",
-    obligation: state.status,
-    note:
-      `final_gate_red scope=${scope} command=${failed ? failed.argv.join(" ") : "unknown"}` +
-      (attribution ? ` attribution=${attribution.verdict}` : ""),
-  });
