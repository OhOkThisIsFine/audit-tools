+// sites-pinned: tests/remediate/executable-plan-identity.test.ts, tests/remediate/review-outcome-provenance.test.ts
+import { join } from "node:path";
+import { z } from "zod";
+import { stableStringify, readOptionalJsonFile } from "audit-tools/shared";
+import { executionPlanRevision, PlanReviewReceiptSchema, type PlanSource, type CanonicalPlan, type PlanReviewHistory, type PlanReviewRole, type PlanReviewReceipt } from "./executionPlan.js";
+export async function readPlanSource(artifactsDir: string): Promise<PlanSource | undefined> {
+  return (await readPlanningContext(artifactsDir))?.state.domain.planning.source;
+}
+
+export async function readCanonicalPlan(artifactsDir: string): Promise<CanonicalPlan | undefined> {
+  const context = await readPlanningContext(artifactsDir);
+  const canonical = context?.state.domain.planning.canonical;
+  if (!canonical) return undefined;
+  if (executionPlanRevision(canonical.plan, canonical.source_sha256, canonical.context_files) !== canonical.revision_sha256) throw new Error("Canonical executable plan content does not match its revision binding.");
+  const accepted = Object.values(context.state.tasks).some(task => task.spec.kind === "remediation.plan.author" && task.status === "accepted" && task.accepted?.outcome === "complete" && stableStringify(context.acceptedPayloads.get(task.spec.id)) === stableStringify(canonical));
+  if (!accepted) throw new Error("Canonical plan has no matching accepted author evidence.");
+  return canonical;
+}
+
+export async function readPlanReviewHistory(artifactsDir: string): Promise<PlanReviewHistory> {
+  const context = await readPlanningContext(artifactsDir);
+  if (!context) return { counterexamples: [], accepted_ids: [], repair_rounds: 0 };
+  const { approvedPlanning } = await import("./planningLifecycle.js");
+  const approved = approvedPlanning(context);
+  const history = context.state.domain.planning.history;
+  return approved ? { ...history, counterexamples: approved.counterexamples } : history;
+}
+
+export async function readPlanReview(artifactsDir: string, role: PlanReviewRole, revision: string): Promise<PlanReviewReceipt | undefined> {
+  const context = await readPlanningContext(artifactsDir);
+  if (!context || context.state.domain.planning.canonical?.revision_sha256 !== revision) return undefined;
+  const id = `remediation.plan.${context.state.domain.planning.round}.${role}`;
+  const task = context.state.tasks[id];
+  const raw = context.acceptedPayloads.get(id) as { review?: unknown; result?: unknown } | undefined;
+  if (!task?.accepted || task.accepted.outcome !== "complete" || !task.issued || !raw) return undefined;
+  const requirement = role === "judge" ? "independent" : context.state.domain.planning.reviewRequirement ?? "independent";
+  return PlanReviewReceiptSchema.parse({ revision_sha256: revision, role, input_sha256: task.issued.binding_sha256,
+    provenance: { requirement, prompt_sha256: task.issued.prompt_body_sha256, review: raw.review, reviewed_content_hash: revision }, result: raw.result });
+}
+
+export async function readApprovedExecutionPlan(artifactsDir: string) {
+  const context = await readPlanningContext(artifactsDir);
+  if (!context) return undefined;
+  const { approvedPlanning } = await import("./planningLifecycle.js");
+  return approvedPlanning(context);
+}
+
+/** Coordinator checkpoint plus verified immutable acceptance payloads is the only planning authority. */
+async function readPlanningContext(artifactsDir: string) {
+  const raw = await readOptionalJsonFile<unknown>(join(artifactsDir, "state.json"));
+  if (raw === undefined) return undefined;
+  const { createRunStore, readRunContext } = await import("../../shared/engine/taskLifecycleStore.js");
+  const { parsePlanningState } = await import("./planningLifecycle.js");
+  const store = createRunStore({ directory: artifactsDir, checkpointPath: "state.json", parseDomain: (value: unknown) => {
+    const domain = z.object({ planning: z.unknown() }).passthrough().parse(value);
+    return { ...domain, planning: parsePlanningState(domain.planning) };
+  } });
+  return readRunContext(store);
+}
