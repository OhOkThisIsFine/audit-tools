+/** Real entrypoint fixture: exact shared envelopes, no sidecar approvals or legacy state writes. */
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { execFileSyncHidden as execFileSync } from "../../helpers/spawn.mjs";
+import type { RunState, TaskSubmission, ExecutableChangePlan } from "audit-tools/shared";
+import type { RemediationDomain } from "../../../src/remediate/state/taskLifecycleDomain.js";
+import { decideNextStep, type NextStepOptions } from "../../../src/remediate/steps/nextStep.js";
+import { StateStore } from "../../../src/remediate/state/store.js";
+
+export async function createLifecycleEntryFixture(configuration: Partial<NextStepOptions> = {}) {
+  const root = await mkdtemp(join(tmpdir(), "remediation-shared-entry-"));
+  const git = (...args: string[]) => execFileSync("git", args, { cwd: root, encoding: "utf8" });
+  git("init", "-q");
+  await writeFile(join(root, ".gitignore"), ".audit-tools/\n");
+  await writeFile(join(root, "request.md"), "Preserve the greeting function's behavior and public API.\n");
+  await writeFile(join(root, "index.js"), "export const greeting = () => 'hello';\n");
+  git("add", "."); git("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "fixture");
+  const artifactsDir = join(root, ".audit-tools", "remediation");
+  const options = { root, artifactsDir, ...configuration };
+  const state = async (): Promise<RunState<RemediationDomain>> => JSON.parse(await readFile(join(artifactsDir, "state.json"), "utf8"));
+  const next = (extra: Partial<NextStepOptions> = {}) => decideNextStep({ ...options, ...extra });
+  const start = () => next({ input: join(root, "request.md") });
+  const issued = async (kind?: string) => {
+    const task = Object.values((await state()).tasks).find(task => task.status === "issued" && (!kind || task.spec.kind === kind));
+    if (!task?.issued) throw new Error(`No issued task ${kind ?? ""}`);
+    return task;
+  };
+  const writeResult = async (payload: unknown, kind?: string, overrides: Partial<TaskSubmission> = {}) => {
+    const run = await state(), task = await issued(kind);
+    const result: TaskSubmission = { contract_version: "audit-tools-task-result/v1", run_id: run.run_id, task_id: task.spec.id,
+      attempt: task.attempt, binding_sha256: task.issued!.binding_sha256, outcome: "complete", payload, ...overrides };
+    await writeFile(join(artifactsDir, task.issued!.result_path), JSON.stringify(result));
+    return result;
+  };
+  const reply = async (payload: unknown, kind?: string) => { await writeResult(payload, kind); return next(); };
+  const summary = { schema_version: "remediate-code-intake-summary/v1alpha2", ready: true, source_type: "documents", goals: ["Preserve greeting"], non_goals: [], constraints: [], affected_files: [{ path: "index.js", reason: "Existing greeting" }], open_questions: [], source_summary: "Greeting request", acceptance_criteria: ["Greeting remains hello"], scope_summary: "index.js", intent_summary: "Preserve greeting", filters: {} };
+  const finishIntake = async () => {
+    await start(); await reply(summary, "remediation.intake.summary");
+    return reply({ schema_version: "intent-checkpoint/v1", confirmed_at: "2026-10-20T00:00:00Z", confirmed_by: "host", scope_summary: "index.js", intent_summary: "Preserve greeting", closing_action: "none", verification_scope: (await state()).domain.intake.verification_scope }, "remediation.intake.intent");
+  };
+  const approvePreparedPlan = async (authored?: ExecutableChangePlan) => {
+    const run = await state();
+    const plan: ExecutableChangePlan = authored ? { ...authored, plan_id: run.run_id } : { plan_id: run.run_id, objective: "Preserve existing greeting", non_goals: [], requirements: [], units: [], source_dispositions: [],
+      request_disposition: { status: "already_satisfied", reason: "index.js already returns hello without changing its API", evidence: ["index.js:1 exports the existing greeting implementation"] } };
+    await reply({ base_revision_sha256: null, plan, retired_requirements: [] }, "remediation.plan.author");
+    if (Object.values((await state()).tasks).some(task => task.status === "issued" && task.spec.kind === "remediation.plan.owner")) await reply({ revision_sha256: (await state()).domain.planning.canonical!.revision_sha256, confirmed_by: "host", approved_unit_ids: plan.units.map(unit => unit.id), declined_units: [], deferred_findings: [] }, "remediation.plan.owner");
+    await reply({ review: { mode: "independent", reason: "Separate fixture reviewer" }, result: { verdict: "approved", issues: [] } }, "remediation.plan.critique");
+    await reply({ review: { mode: "independent", reason: "Separate fixture reviewer" }, result: { counterexamples: [] } }, "remediation.plan.critic");
+    return reply({ review: { mode: "independent", reason: "Separate fixture judge" }, result: { verdict: "approved", classifications: [], requirement_assessments: plan.requirements.map(requirement => ({ requirement_id: requirement.id, verdict: "satisfied", evidence: ["Compared requirement to index.js:1"] })), disposition_assessments: [], ...(plan.request_disposition ? { request_disposition_assessment: { verdict: "satisfied", evidence: ["Compared request to index.js:1"] } } : {}) } }, "remediation.plan.judge");
