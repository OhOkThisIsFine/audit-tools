+    hook.unlink = async () => { unlinks++; };
+    try {
+      await expect(acquireLock(path, timeout, undefined, { now: () => clock })).rejects.toBeInstanceOf(FileLockTimeoutError);
+      expect(unlinks).toBe(0);
+      expect(await readFile(path, 'utf8')).toBe(dead);
