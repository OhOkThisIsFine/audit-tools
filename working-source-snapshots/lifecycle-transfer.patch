+export async function retryTask<Domain>(store: RunStore<Domain>, taskId: string, request: RetryRequest, policy: DrawPolicy<Domain>): Promise<void> {
+  if (!request.reason.trim()) throw new Error("Retry requires an explicit failure/abandonment reason");
