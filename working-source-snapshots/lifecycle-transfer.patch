+
+let base: string, root: string, path: string;
+beforeEach(() => {
+  base = fs.realpathSync(fs.mkdtempSync(join(tmpdir(), "bounded-source-")));
+  root = join(base, "repo"); fs.mkdirSync(root);
+  path = join(root, "source.ts"); fs.writeFileSync(path, "needle\n");
+  fs.writeFileSync(join(base, "outside.ts"), "OUTSIDE_PRIVATE_SENTINEL");
+});
+afterEach(() => fs.rmSync(base, { recursive: true, force: true }));
+
+for (const mode of ["sync", "async"] as const) describe(mode, () => {
+  const read = async (candidate = "source.ts", options?: RepositorySourceOptions) => mode === "sync" ? readRepositorySourceSync(root, candidate, options) : readRepositorySource(root, candidate, options);
+  test("cap minus one, cap, cap plus one and zero-byte files", async () => {
+    for (const size of [0, 7, 8]) {
+      fs.writeFileSync(path, "x".repeat(size));
+      expect(await read("source.ts", { maxBytes: 8 })).toMatchObject({ text: "x".repeat(size), byteLength: size, repoRelativePath: "source.ts", canonicalPath: path });
+    }
+    fs.writeFileSync(path, "x".repeat(9));
+    const open = vi.fn(fs.openSync);
+    await expect(read("source.ts", { maxBytes: 8, filesystem: { open } })).rejects.toMatchObject({ code: "too_large" });
+    expect(open).not.toHaveBeenCalled();
+  });
+  test("validates finite positive safe byte caps", async () => {
+    for (const maxBytes of [0, -1, NaN, Infinity, 1.5, Number.MAX_SAFE_INTEGER + 1])
+      await expect(read("source.ts", { maxBytes })).rejects.toMatchObject({ code: "invalid_path" });
+  });
+  test("incremental UTF8 survives multibyte splits", async () => {
+    fs.writeFileSync(path, "a😀éb");
