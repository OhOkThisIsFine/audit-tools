+    await store.mutate(async state => {
+      const record = state.tasks[task.spec.id];
+      if (record?.status === "issued" && record.attempt === task.attempt && record.issued?.binding_sha256 === task.binding_sha256) record.blocker = { code: "deterministic_failed", detail };
