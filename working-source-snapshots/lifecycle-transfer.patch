+// sites-pinned: tests/remediate/remediation-outcomes.test.ts, tests/remediate/remediate-state-invariants.test.ts
+/** Inert historical report vocabulary, below the checkpoint adapter and domain policies. */
+import type { ConformanceReviewBinding, RemediationPlan, FindingDisposition, SourceVerification,
+  RemediationItemState, ClosingPlan, CoverageLedger, RemediationHostHandoffRecord } from "./types.js";
+import type { RemediationRunStatus } from "./runStatus.js";
+
+/** Historical report-view stamp, never accepted by the live checkpoint loader. */
+export const REMEDIATION_STATE_CONTRACT_VERSION = "remediate-code-state/v2" as const;
+export interface RemediationState {
+  /** Optional historical report vocabulary; never a persisted live checkpoint contract. */
+  contract_version?: "remediate-code-state/v2";
+  status: RemediationRunStatus;
+  /** Tool-minted current-run snapshot; survives handoff/frontier replacement. */
+  conformance_review?: ConformanceReviewBinding;
+  plan?: RemediationPlan;
+  items?: Record<string, RemediationItemState>;
+  finding_dispositions?: Record<string, FindingDisposition>;
+  /** Accepted owner rationale for deferred sources, separate from authored plan evidence. */
+  owner_deferred_reasons?: Record<string, string>;
+  source_verifications?: Record<string, SourceVerification>;
+  closing_plan?: ClosingPlan;
+  started_at?: string;
+  step_count?: number;
+  plan_coverage?: CoverageLedger;
+  /**
+   * Historical partial-report marker. Live halts use the shared control state,
+   * never this view field as a transition or completion grant.
+   */
+  closing_context?: "user_halted";
+  /** Verified accepted landing paths, used to derive the exact closing write grant. */
+  applied_edit_surface?: string[];
+  /** Exact original pre-edit dirty paths, never recaptured from a later tree. */
+  run_start_dirty?: string[];
+  run_start_dirty_encoding?: "git-z/v1";
+  /** Historical diagnostic vocabulary only. The live lifecycle never produces or consumes it. */
+  host_handoff?: RemediationHostHandoffRecord;
+}
