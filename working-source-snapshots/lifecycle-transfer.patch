-  }
-
-  log.event({
-    phase: "advance",
-    kind: "executor_end",
-    correlationId,
-    obligation: selectedObligation ?? undefined,
-    note: selectedExecutor,
-    duration_ms: Date.now() - executorStartedAt,
-  });
