+import { writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { z } from "zod";
+import { createRunState } from "../../../src/shared/engine/taskLifecycle.js";
+import { createLifecycleIO, createRunStore } from "../../../src/shared/engine/taskLifecycleStore.js";
+import type { DrawPolicy, IssuedTask, RunStore, TaskSpec, TaskSubmission } from "../../../src/shared/engine/taskLifecycleTypes.js";
+
+const Subject = z.object({ files: z.array(z.string()), prompt: z.string() }).strict();
+const Payload = z.object({ files: z.array(z.string()) }).strict();
+export const hostSpec = (id: string, prompt = `Inspect ${id}`): TaskSpec => ({
+  id, kind: "fixture.inspect", phase: "preparing", depends_on: [], inputs: {},
+  subject: { files: [id], prompt }, completion: "complete",
+});
+export async function lifecycleFixture(directory: string, tasks: TaskSpec[] = [hostSpec("alpha"), hostSpec("beta")]) {
+  const policy: DrawPolicy<{ accepted: number }> = {
+    parseDomain: value => z.object({ accepted: z.number().int().nonnegative() }).strict().parse(value),
+    initialTasks: () => tasks, phaseTransition: async () => null, acceptanceGuard: async () => [],
+    definitions: new Map([["fixture.inspect", {
+      kind: "fixture.inspect", phase: "preparing", completion: "complete", execution: "host", effect: "read_only",
+      parseSubject: value => Subject.parse(value), parsePayload: value => Payload.parse(value),
+      render: task => Subject.parse(task.spec.subject).prompt,
+      validate: async (task, payload, _context, submission) => ({ errors: submission.outcome !== "complete" || JSON.stringify(Payload.parse(payload).files) !== JSON.stringify(Subject.parse(task.spec.subject).files) ? ["full declared scope is required"] : [] }),
+      reduce: (_task, _payload, context) => ({ domain: { accepted: context.state.domain.accepted + 1 } }),
+      requiredScopeComplete: task => task.accepted?.outcome === "complete",
+    }]]),
+  };
+  const io = createLifecycleIO(directory);
+  const source = await io.writeArtifact({ fixture: "immutable source" });
+  const initialState = createRunState({ run_id: "fixture-run", mode: "audit", source, domain: { accepted: 0 } }, policy);
+  const store = createRunStore({ directory, initialState, parseDomain: policy.parseDomain });
+  await store.read();
+  return { store, policy };
+}
+export function submissionFor(task: IssuedTask): TaskSubmission {
+  return { contract_version: "audit-tools-task-result/v1", run_id: task.run_id, task_id: task.spec.id,
+    attempt: task.attempt, binding_sha256: task.binding_sha256, outcome: "complete", payload: { files: Subject.parse(task.spec.subject).files } };
+}
+export async function writeSubmission<Domain>(store: RunStore<Domain>, task: IssuedTask, value: unknown = submissionFor(task)) {
+  await writeFile(join(store.io.directory, task.result_path), JSON.stringify(value));
+  return task.result_path;
+}
