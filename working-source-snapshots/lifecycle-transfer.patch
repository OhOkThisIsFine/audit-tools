+  return {
+    ...actual,
+    readdir: async (...args: Parameters<typeof actual.readdir>) => { await boundary.beforeReadDir?.(String(args[0])); return actual.readdir(...args); },
+    rm: async (...args: Parameters<typeof actual.rm>) => { await boundary.beforeRemove?.(String(args[0])); return actual.rm(...args); },
+    rmdir: async (...args: Parameters<typeof actual.rmdir>) => { await boundary.beforeRmdir?.(String(args[0])); return actual.rmdir(...args); },
+  };
+});
+afterEach(() => { boundary.beforeRemove = undefined; boundary.beforeRmdir = undefined; boundary.beforeReadDir = undefined; });
