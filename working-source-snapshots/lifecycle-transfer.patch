+++ b/tests/shared/fileLock-admission.test.ts
@@ -0,0 +1,59 @@
+import { basename, dirname, join } from 'node:path';
+import { expect, test, vi } from 'vitest';
+import { withTempDir } from './fileLockTestSupport.mjs';
+const hook = vi.hoisted(() => ({ beforeCreate: undefined as undefined | (() => Promise<void>) }));
+vi.mock('node:fs/promises', async original => {
+  const actual = await original<typeof import('node:fs/promises')>();
+  return { ...actual, writeFile: (async (...args: Parameters<typeof actual.writeFile>) => {
+    if (hook.beforeCreate && basename(String(args[0])) === 'admission.lock') await hook.beforeCreate();
+    return actual.writeFile(...args);
+  }) as typeof actual.writeFile };
+});
+import { readFile, rmdir } from 'node:fs/promises';
+import { acquireLock, FileLockTimeoutError, releaseLock } from '../../src/shared/io/fileLock.js';
+
+test('recreates a parent removed between mkdir and exclusive lock creation', async () => {
+  await withTempDir(async (dir: string) => {
+    const path = join(dir, 'empty', 'admission.lock');
+    hook.beforeCreate = async () => { hook.beforeCreate = undefined; await rmdir(dirname(path)); };
+    try {
+      const token = await acquireLock(path, 1000);
+      expect(await readFile(path, 'utf8')).toBe(token);
+      await releaseLock(path, token);
+    } finally { hook.beforeCreate = undefined; }
+  });
+});
+
+test('repeated parent removals stop at the acquisition deadline', async () => {
+  await withTempDir(async (dir: string) => {
+    const path = join(dir, 'empty', 'admission.lock');
+    let clock = 0, attempts = 0;
+    hook.beforeCreate = async () => { attempts++; clock += 10; await rmdir(dirname(path)); };
+    try {
+      await expect(acquireLock(path, 30, undefined, { now: () => clock })).rejects.toBeInstanceOf(FileLockTimeoutError);
+      expect(attempts).toBe(3);
+    } finally { hook.beforeCreate = undefined; }
+  });
+});
+
+test('zero-timeout parent removal never starts an unbounded recreation loop', async () => {
+  await withTempDir(async (dir: string) => {
+    const path = join(dir, 'empty', 'admission.lock');
+    let attempts = 0;
+    hook.beforeCreate = async () => { attempts++; await rmdir(dirname(path)); };
+    try {
+      await expect(acquireLock(path, 0)).rejects.toBeInstanceOf(FileLockTimeoutError);
+      expect(attempts).toBe(1);
+    } finally { hook.beforeCreate = undefined; }
+  });
+});
+
+
+test.each([-1, NaN, Infinity])('existing free-lock duration acceptance is unchanged for %s', async duration => {
+  await withTempDir(async (dir: string) => {
+    const path = join(dir, 'duration.lock');
+    const token = await acquireLock(path, duration);
+    expect(await readFile(path, 'utf8')).toBe(token);
+    await releaseLock(path, token);
+  });
+});
