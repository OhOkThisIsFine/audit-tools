@@ -0,0 +1,92 @@
+/** Real ingress adapters plus shared coordinator controls; no provider or analyzer execution. */
+import { test, expect, vi } from "vitest";
+import { readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { issueTasks, advanceRun } from "../../src/shared/engine/taskLifecycle.js";
+import { readRunContext } from "../../src/shared/engine/taskLifecycleStore.js";
+import type { IssuedTask, RunStore } from "../../src/shared/engine/taskLifecycleTypes.js";
+import { cmdRecoverSubmission } from "../../src/audit/cli/recoverSubmissionCommand.js";
+import { cmdIngestResults } from "../../src/audit/cli/ingestResultsCommand.js";
+import { fixedAuditFlowRun } from "../audit/helpers/lifecycleFixture.js";
+import { finalizationRun } from "../audit/helpers/finalizationLifecycleFixture.js";
+import { withTempDir } from "./fileLockTestSupport.mjs";
+
+async function writeEnvelope<D>(store: RunStore<D>, task: IssuedTask, payload: unknown): Promise<string> {
+  const path = join(store.io.directory, task.result_path);
+  await writeFile(path, JSON.stringify({ contract_version: "audit-tools-task-result/v1", run_id: task.run_id,
+    task_id: task.spec.id, attempt: task.attempt, binding_sha256: task.binding_sha256, outcome: "complete", payload }));
+  return path;
+}
+
+test.each([
+  ["recover", (dir: string, path: string) => cmdRecoverSubmission(["--artifacts-dir", dir, "--from", path])],
+  ["ingest", (dir: string, path: string) => cmdIngestResults(["--artifacts-dir", dir, "--results", path])],
+] as const)("actual %s cannot forge coordinator-owned preparation output", async (_name, command) => {
+  await withTempDir(async (root: string) => {
+    const f = await fixedAuditFlowRun(root);
+    const [task] = await issueTasks(f.store, ["audit.prepare.flow"], f.policy);
+    const payload = { options: {}, line_index: {}, bundle: {}, next: [] };
+    const path = await writeEnvelope(f.store, task!, payload);
+    const checkpoint = join(f.artifactsDir, "run-state.json");
+    const before = await readFile(checkpoint, "utf8");
+    const log = vi.spyOn(console, "log").mockImplementation(() => {});
+    try { await expect(command(f.artifactsDir, path)).rejects.toThrow(/coordinator.only|host submission.*not allowed/i); }
+    finally { log.mockRestore(); }
+    expect(await readFile(checkpoint, "utf8")).toBe(before);
+    expect((await f.store.read()).tasks[task!.spec.id]!.status).toBe("issued");
+  });
+});
+
+test("actual ingest cannot replace a coordinator-owned final report with a schema-valid fabrication", async () => {
+  await withTempDir(async (root: string) => {
+    const f = await finalizationRun(root);
+    // One phase transition and one trusted synthesis execution leave report pending.
+    await advanceRun(f.store, f.policy, { draw: "deterministic", maxExecutions: 2 });
+    const [task] = await issueTasks(f.store, ["audit.finalize.report"], f.policy);
+    const bundle = await f.store.io.readArtifact(task!.inputs.bundle!) as Record<string, unknown>;
+    const path = await writeEnvelope(f.store, task!, { bundle: { ...bundle, audit_report: "Fabricated report, never produced by the coordinator" } });
+    const checkpoint = join(f.artifactsDir, "run-state.json"), before = await readFile(checkpoint, "utf8");
+    const log = vi.spyOn(console, "log").mockImplementation(() => {});
+    try { await expect(cmdIngestResults(["--artifacts-dir", f.artifactsDir, "--results", path])).rejects.toThrow(/coordinator.only|host submission.*not allowed/i); }
+    finally { log.mockRestore(); }
+    expect(await readFile(checkpoint, "utf8")).toBe(before);
+    expect((await readRunContext(f.store)).acceptedPayloads.has("audit.finalize.report")).toBe(false);
+  });
+});
+
+test("normal in-process deterministic completion still accepts and finalizes", async () => {
+  await withTempDir(async (root: string) => {
+    const f = await finalizationRun(root);
+    const complete = await advanceRun(f.store, f.policy, { draw: "deterministic", maxExecutions: 8 });
+    expect(complete.stopped).toBe("complete");
+    expect(complete.state.tasks["audit.finalize.synthesis"]!.accepted?.outcome).toBe("complete");
+    expect(complete.state.tasks["audit.finalize.report"]!.accepted?.outcome).toBe("complete");
+  });
+});
+
+test("local completion accepts captured runner bytes, not a replaced host-writable submission projection", async () => {
+  await withTempDir(async (root: string) => {
+    const f = await finalizationRun(root);
+    let substituted = false, originalReport = "";
+    const store: typeof f.store = { ...f.store, read: async () => {
+      const state = await f.store.read(), task = state.tasks["audit.finalize.report"];
+      if (!substituted && task?.status === "issued" && task.issued) {
+        const path = join(f.artifactsDir, task.issued.result_path);
+        let text: string | undefined;
+        try { text = await readFile(path, "utf8"); }
+        catch (error) { if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error; }
+        if (text !== undefined) {
+          const envelope = JSON.parse(text) as { payload: { bundle: { audit_report: string } } };
+          originalReport = envelope.payload.bundle.audit_report;
+          envelope.payload.bundle.audit_report = "Replaced after local execution, before acceptance";
+          await writeFile(path, JSON.stringify(envelope)); substituted = true;
+        }
+      }
+      return state;
+    } };
+    const complete = await advanceRun(store, f.policy, { draw: "deterministic", maxExecutions: 8 });
+    expect(substituted).toBe(true);
+    expect(complete.stopped).toBe("complete");
+    expect(await store.io.readArtifact(complete.state.deliverables!.report!)).toBe(originalReport);
+  });
+});
