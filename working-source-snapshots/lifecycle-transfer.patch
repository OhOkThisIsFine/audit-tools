@@ -0,0 +1,146 @@
+// sites-pinned: tests/shared/repository-source.test.ts, tests/shared/citation-grounding.test.ts
+import * as fs from "node:fs";
+import { dirname, relative, resolve, sep } from "node:path";
+import { StringDecoder } from "node:string_decoder";
+import { promisify } from "node:util";
+import { resolveWithinRoot } from "./pathContainment.js";
+
+export interface RepositorySource {
+  text: string;
+  repoRelativePath: string;
+  canonicalPath: string;
+  byteLength: number;
+  identity: { dev: number; ino: number };
+}
+type RepositorySourceErrorCode = "invalid_path" | "outside_root" | "non_regular" | "too_large" | "changed_during_read" | "unreadable" | "close_failed";
+/** Deliberately carries neither source bytes nor unsanitized filesystem errors. */
+export class RepositorySourceError extends Error {
+  secondaryCode?: "close_failed";
+  constructor(readonly code: RepositorySourceErrorCode) {
+    super(`Repository source unavailable: ${code}`);
+    this.name = "RepositorySourceError";
+  }
+}
+
+/** Low-level test seam. It cannot replace path authorization or return source text. */
+interface RepositorySourceFileSystem {
+  realpath(path: string): string;
+  lstat(path: string): fs.Stats;
+  open(path: string, flags: number): number;
+  fstat(fd: number): fs.Stats;
+  read(fd: number, buffer: Buffer, length: number, position: number): number;
+  close(fd: number): void;
+}
+export interface RepositorySourceOptions {
+  maxBytes?: number;
+  filesystem?: Partial<RepositorySourceFileSystem>;
+}
+type Operations = { [K in keyof RepositorySourceFileSystem]: (...args: Parameters<RepositorySourceFileSystem[K]>) => ReturnType<RepositorySourceFileSystem[K]> | Promise<ReturnType<RepositorySourceFileSystem[K]>> };
+const syncOperations: RepositorySourceFileSystem = {
+  realpath: fs.realpathSync, lstat: fs.lstatSync, open: fs.openSync, fstat: fs.fstatSync,
+  read: (fd, buffer, length, position) => fs.readSync(fd, buffer, 0, length, position),
+  close: fs.closeSync,
+};
+const readAsync = promisify(fs.read);
+const asyncOperations: Operations = {
+  realpath: promisify(fs.realpath), lstat: promisify(fs.lstat), open: promisify(fs.open), fstat: promisify(fs.fstat),
+  read: async (fd, buffer, length, position) => (await readAsync(fd, buffer, 0, length, position)).bytesRead,
+  close: promisify(fs.close),
+};
+const sameIdentity = (a: fs.Stats, b: fs.Stats) => a.dev === b.dev && a.ino === b.ino;
+const sameSnapshot = (a: fs.Stats, b: fs.Stats) => sameIdentity(a, b) && a.size === b.size && a.mtimeMs === b.mtimeMs && a.ctimeMs === b.ctimeMs;
+function fail(code: RepositorySourceErrorCode): never { throw new RepositorySourceError(code); }
+
+/** One algorithm, driven by synchronous or asynchronous descriptor operations.
+ * Defends stable/cooperative trees and observable replacement races, NOT hostile
+ * same-user ancestor swapping. Such inputs require an authorized stable snapshot.
+ */
+function* readSource(root: string, candidate: string, options: RepositorySourceOptions, io: Operations): Generator<unknown, RepositorySource, unknown> {
+  let fd: number | undefined;
+  let failure: RepositorySourceError | undefined;
+  try {
+    const maxBytes = options.maxBytes === undefined ? 1024 * 1024 : options.maxBytes;
+    if (!Number.isSafeInteger(maxBytes) || maxBytes <= 0) fail("invalid_path");
+    if (typeof candidate !== "string" || !candidate.trim() || candidate.includes("\0") ||
+      /^[A-Za-z]:[^\\/]/.test(candidate) || /^[A-Za-z]:$/.test(candidate) ||
+      /^\\\\[?.]\\/.test(candidate) || /^\/\/[?.]\//.test(candidate) ||
+      (/^[A-Za-z][A-Za-z0-9+.-]*:/.test(candidate) && !/^[A-Za-z]:[\\/]/.test(candidate)) ||
+      (sep === "/" && (/^[A-Za-z]:/.test(candidate) || candidate.startsWith("\\\\")))) fail("invalid_path");
+    const logicalRoot = resolve(root);
+    const path = resolveWithinRoot(logicalRoot, candidate, { allowRoot: false });
+    if (path === null) fail("outside_root");
+    const canonicalRoot = (yield io.realpath(logicalRoot)) as string;
+    const parent = (yield io.realpath(dirname(path))) as string;
+    const sourceRealpath = (yield io.realpath(path)) as string;
+    if (!resolveWithinRoot(canonicalRoot, parent) || !resolveWithinRoot(canonicalRoot, sourceRealpath, { allowRoot: false })) fail("outside_root");
+    const before = (yield io.lstat(sourceRealpath)) as fs.Stats;
+    if (!before.isFile()) fail("non_regular");
+    if (before.size > maxBytes) fail("too_large");
+    fd = (yield io.open(sourceRealpath, fs.constants.O_RDONLY | (fs.constants.O_NOFOLLOW ?? 0) | (fs.constants.O_NONBLOCK ?? 0))) as number;
+    const opened = (yield io.fstat(fd)) as fs.Stats;
+    if (!opened.isFile()) fail("non_regular");
+    if (!sameSnapshot(before, opened)) fail("changed_during_read");
+    // Check the logical name as well as the opened descriptor before and after
+    // the read. Returning an old descriptor after namespace replacement is not
+    // evidence for the newly named source.
+    const validateName = function* (): Generator<unknown, void, unknown> {
+      const nowRoot = (yield io.realpath(logicalRoot)) as string;
+      const nowParent = (yield io.realpath(dirname(path))) as string;
+      const nowPath = (yield io.realpath(path)) as string;
+      if (nowRoot !== canonicalRoot || nowPath !== sourceRealpath || !resolveWithinRoot(canonicalRoot, nowParent)) fail("changed_during_read");
+      const named = (yield io.lstat(nowPath)) as fs.Stats;
+      if (!named.isFile() || !sameSnapshot(opened, named)) fail("changed_during_read");
+    };
+    yield* validateName();
+    const decoder = new StringDecoder("utf8");
+    const parts: string[] = [];
+    const buffer = Buffer.alloc(Math.min(64 * 1024, maxBytes));
+    let byteLength = 0;
+    while (true) {
+      // The single extra byte proves overflow without accepting or decoding it.
+      const length = Math.min(buffer.length, maxBytes - byteLength + 1);
+      const count = (yield io.read(fd, buffer, length, byteLength)) as number;
+      if (!Number.isSafeInteger(count) || count < 0 || count > length) fail("unreadable");
+      if (count === 0) break;
+      byteLength += count;
+      if (byteLength > maxBytes) fail("too_large");
+      parts.push(decoder.write(buffer.subarray(0, count)));
+    }
+    const after = (yield io.fstat(fd)) as fs.Stats;
+    if (!after.isFile() || !sameSnapshot(opened, after) || byteLength !== after.size) fail("changed_during_read");
+    yield* validateName();
+    parts.push(decoder.end());
+    return { text: parts.join(""), repoRelativePath: relative(logicalRoot, path).split(sep).join("/"), canonicalPath: sourceRealpath, byteLength, identity: { dev: opened.dev, ino: opened.ino } };
+  } catch (error) {
+    failure = error instanceof RepositorySourceError ? error : new RepositorySourceError("unreadable");
+    throw failure;
+  } finally {
+    if (fd !== undefined) {
+      try { yield io.close(fd); }
+      catch {
+        if (failure) failure.secondaryCode = "close_failed";
+        else fail("close_failed");
+      }
+    }
+  }
+}
+
+export function readRepositorySourceSync(root: string, candidate: string, options: RepositorySourceOptions = {}): RepositorySource {
+  const iterator = readSource(root, candidate, options, { ...syncOperations, ...options.filesystem });
+  // Every sync adapter operation executes inside the generator, so throws enter
+  // its owned finally. The yield simply shares the algorithm with the async draw.
+  let step = iterator.next();
+  while (!step.done) step = iterator.next(step.value);
+  return step.value;
+}
+export async function readRepositorySource(root: string, candidate: string, options: RepositorySourceOptions = {}): Promise<RepositorySource> {
+  const iterator = readSource(root, candidate, options, { ...asyncOperations, ...options.filesystem });
+  let step = iterator.next();
+  while (!step.done) {
+    let value: unknown;
+    try { value = await step.value; }
+    catch (error) { step = iterator.throw(error); continue; }
+    step = iterator.next(value);
+  }
+  return step.value;
+}
