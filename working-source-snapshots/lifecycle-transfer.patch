+    units: [{ id: "U1", title: "Improve greeting structure", description: "Preserve the existing API and behavior", source_finding_ids: [], requirement_ids: ["R1"], dependencies: [], read_paths: ["index.js"], allowed_files: ["index.js"], required_tests: ['node -e "process.exit(0)"'], affected_interfaces: [], addresses_counterexample_ids: [] }] };
+}
