+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { readRunContext } from '../../../src/shared/engine/taskLifecycleStore.js';
+import { createLifecycleEntryFixture } from './lifecycleEntryFixture.js';
+import type { NextStepOptions } from '../../../src/remediate/steps/nextStep.js';
+import type { IntakeSummary } from '../../../src/remediate/intake.js';
+import type { IntentCheckpoint } from 'audit-tools/shared';
+
+/** Drive actual bound preparation tasks, never sidecar approvals. */
+export async function createIntakeEntryFixture(options: Partial<NextStepOptions> = {}) {
+  const f = await createLifecycleEntryFixture(options);
+  const context = () => readRunContext(f.store.lifecycle());
+  const confirm = async (summary: Partial<IntakeSummary> = {}, intent: Partial<IntentCheckpoint> = {}, declines: {finding_id:string;reason:string}[] = []) => {
+    await f.reply({ ...f.summary, ...summary }, 'remediation.intake.summary');
+    let step = await f.reply({ schema_version:'intent-checkpoint/v1',confirmed_at:'2026-10-20T00:00:00Z',confirmed_by:'host',scope_summary:'Selected source scope',intent_summary:'Repair selected findings',closing_action:'none',verification_scope:(await f.state()).domain.intake.verification_scope,...intent }, 'remediation.intake.intent');
+    if (Object.values((await f.state()).tasks).some(t=>t.status==='issued' && t.spec.kind==='remediation.intake.review')) {
+      step = await f.reply({plan_id:(await f.state()).run_id,declined_findings:declines,declined_tiers:[]},'remediation.intake.review');
+    }
+    return step;
+  };
+  return {...f,context,confirm,prompt:async()=>readFile(join(f.artifactsDir,(await f.issued()).issued!.prompt.path),"utf8")};
+}
