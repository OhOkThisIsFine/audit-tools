+/** Real audit inspection policy over two fixed source lines. No model or analyzer work. */
+import { mkdir, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { createRunState, issueTasks, acceptSubmission } from "../../../src/shared/engine/taskLifecycle.js";
+import { createLifecycleIO, createRunStore, readRunContext } from "../../../src/shared/engine/taskLifecycleStore.js";
+import { createAuditPolicy } from "../../../src/audit/lifecycle/auditPolicy.js";
+import { parseAuditDomain, inspectionSpec, inspectionSurface, type AuditDomain } from "../../../src/audit/lifecycle/auditDomain.js";
+import { hashContent } from "../../../src/shared/hash.js";
+import type { AuditResult, AuditTask } from "../../../src/audit/types.js";
+export async function inspectionFixture(root: string, lens = "correctness", taskOverrides: Partial<AuditTask> = {}) {
+  const artifactsDir = join(root, ".audit-tools", "audit");
+  await mkdir(join(root, "src"), { recursive: true }); await writeFile(join(root, "src/a.ts"), "one\ntwo\n");
+  const io = createLifecycleIO(artifactsDir), policy = createAuditPolicy();
+  const source = await io.writeArtifact({ source_root: root, repository_root: root, artifacts_dir: artifactsDir, options: {} });
+  const basis = await io.writeArtifact({ source, fixed: "completed preparation" });
+  const domain: AuditDomain = { repository_root: root, source_root: root, artifacts_dir: artifactsDir, preparation: { repo_manifest: { repository: { name: "finding" }, generated_at: "fixed", files: [{ path: "src/a.ts", language: "typescript", hash: hashContent("one\ntwo\n"), size_bytes: 8 }] } }, line_index: { "src/a.ts": 2 }, narrative_enabled: false };
+  const state = createRunState({ run_id: "fixed-inspection-contract", mode: "audit", source, domain }, { ...policy, initialTasks: () => [] });
+  state.phase = "executing"; state.basis = basis;
+  const spec = inspectionSpec({ task_id: "audit-task-a", unit_id: "unit-audit-task-a", pass_id: `pass:${lens}`, lens, file_paths: ["src/a.ts"], file_line_counts: { "src/a.ts": 2 }, rationale: "Fixed finding validation", priority: "medium", ...taskOverrides }, basis);
+  if (spec.completion === "selective") spec.inputs.surface = await io.writeArtifact(inspectionSurface((spec.subject as { task: AuditTask }).task));
+  state.tasks[spec.id] = { spec, status: "pending", attempt: 0 };
+  const store = createRunStore({ directory: artifactsDir, initialState: state, parseDomain: parseAuditDomain }); await store.read();
+  const task = (await issueTasks(store, [spec.id], policy))[0]!;
+  return { store, policy, task, artifactsDir, root, resultPath: join(artifactsDir, task.result_path), prompt: await io.readText(task.prompt) };
+}
+export async function writeInspectionPayload(fixture: Awaited<ReturnType<typeof inspectionFixture>>, payload: unknown) {
+  const task = fixture.task;
+  await writeFile(fixture.resultPath, JSON.stringify({ contract_version: "audit-tools-task-result/v1", run_id: task.run_id, task_id: task.spec.id, attempt: task.attempt, binding_sha256: task.binding_sha256, outcome: "complete", payload }));
+}
+export async function acceptFinding(fixture: Awaited<ReturnType<typeof inspectionFixture>>, finding: unknown): Promise<AuditResult> {
+  await writeInspectionPayload(fixture, { file_coverage: [{ path: "src/a.ts", total_lines: 2 }], findings: [finding] });
+  await acceptSubmission(fixture.store, fixture.task.result_path, fixture.policy);
+  return (await readRunContext(fixture.store)).acceptedPayloads.get(fixture.task.spec.id) as AuditResult;
+}
