@@ -0,0 +1,155 @@
+// sites-pinned: tests/shared/engineering-contract-gate.test.ts
+// Plan coverage and oracle identity, not a semantic proof or review attestation.
+// --run uses the canonical runner and never accepts a saved report as evidence.
+import { hashContent } from "./shared/primitives.mjs";
+import { execFileSync, spawnSync } from "node:child_process";
+import { readFileSync, existsSync } from "node:fs";
+import { dirname, join, posix, resolve } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import ts from "typescript";
+import { guardArgv } from "./shared/argvGuard.mjs";
+import { worktreeTree } from "./shared/worktree-tree.mjs";
+
+const PLAN = "docs/reviews/pinned-phase-shared-lifecycle-plan.md";
+const MANIFEST = "tests/fixtures/pinned-workflow-golden/contract.json";
+// The original fourteen obligations cannot disappear by editing both mapping
+// and prose. Changing this floor is itself a reviewed change to the gate.
+const REQUIRED = Array.from({ length: 14 }, (_, i) => `acceptance-${String(i + 1).padStart(2, "0")}`);
+const digest = bytes => hashContent(bytes);
+const safePath = path => typeof path === "string" && path.startsWith("tests/") &&
+  !path.includes("\\") && path.split("/").every(part => part !== ".." && part !== "." && part !== "");
+const revision = plan => ({
+  number: Number(/^Oracle revision: ([1-9][0-9]*)$/mu.exec(plan)?.[1] ?? 0),
+  reason: /^Oracle change: (\S.*)$/mu.exec(plan)?.[1]?.trim() ?? "",
+});
+
+/**
+ * @typedef {{schema_version:number, cases:{id:string, tests:string[]}[], tests:{path:string,count:number,platform_counts?:Record<string,number>}[], files:Record<string,string>}} Contract
+ * @param {{plan:string, manifest:Contract, read:(path:string)=>Buffer|string,
+ * dependencies:(path:string)=>string[], prior?:{plan:string,manifest:Contract}}} input
+ * @returns {string[]}
+ */
+export function validateContract({ plan, manifest, read, dependencies, prior }) {
+  const errors = [];
+  if (manifest?.schema_version !== 1 || !Array.isArray(manifest.cases) || !Array.isArray(manifest.tests) ||
+      !manifest.files || typeof manifest.files !== "object" || Array.isArray(manifest.files)) {
+    return ["Invalid engineering contract shape/version"];
+  }
+  const rows = manifest.cases.map(row => row?.id);
+  const planned = [...plan.matchAll(/<!-- (acceptance-\d{2}) -->/gu)].map(match => match[1]);
+  for (const id of REQUIRED) {
+    if (planned.filter(value => value === id).length !== 1) errors.push(`Plan must retain exactly one ${id}`);
+    if (rows.filter(value => value === id).length !== 1) errors.push(`Mapping must retain exactly one ${id}; missing or duplicate case`);
+  }
+  for (const id of [...planned, ...rows]) if (!REQUIRED.includes(id)) errors.push(`Unknown acceptance case ${id}`);
+  const currentRevision = revision(plan);
+  if (!currentRevision.number || currentRevision.reason.length < 12) errors.push("Plan needs a positive oracle revision and concrete change reason");
+  const roster = manifest.tests.map(test => test?.path);
+  if (!roster.length || new Set(roster).size !== roster.length) errors.push("Test roster is empty or duplicate");
+  for (const test of manifest.tests) {
+    if (!safePath(test?.path) || !/\.test\.(?:ts|mjs)$/u.test(test.path)) errors.push(`Unsafe or non-test roster path ${test?.path}`);
+    if (!Number.isSafeInteger(test?.count) || test.count < 1) errors.push(`Test count must be positive: ${test?.path}`);
+    for (const [platform, count] of Object.entries(test.platform_counts ?? {})) {
+      if (!["win32", "linux", "darwin"].includes(platform) || !Number.isSafeInteger(count) || count < 1) errors.push(`Invalid explicit platform count: ${test.path} ${platform}`);
+    }
+    if (!manifest.files[test.path]) errors.push(`Unpinned executed test ${test.path}`);
+  }
+  for (const row of manifest.cases) {
+    if (!Array.isArray(row?.tests) || !row.tests.length) errors.push(`Case ${row?.id} has no tests`);
+    else for (const path of row.tests) if (!roster.includes(path)) errors.push(`Case ${row.id} names test outside executed roster: ${path}`);
+  }
+  for (const path of roster) if (!manifest.cases.some(row => row.tests?.includes(path))) errors.push(`Executed test has no plan case: ${path}`);
+  for (const [path, hash] of Object.entries(manifest.files)) {
+    if (!safePath(path)) { errors.push(`unsafe pinned path ${path}`); continue; }
+    if (typeof hash !== "string" || !/^[a-f0-9]{64}$/u.test(hash)) errors.push(`Invalid SHA-256 for ${path}`);
+    try {
+      if (digest(read(path)) !== hash) errors.push(`Oracle changed bytes: ${path}; do not regenerate expectations from implementation output`);
+      for (const dependency of dependencies(path)) {
+        if (!manifest.files[dependency]) errors.push(`unpinned assertion-bearing helper/data: ${dependency} from ${path}`);
+      }
+    } catch (error) { errors.push(`Oracle unreadable: ${path}: ${/** @type {Error} */ (error).message}`); }
+  }
+  const requirements = text => text.replace(/^Oracle (?:revision|change): .*$/gmu, "");
+  if (prior && (JSON.stringify(manifest) !== JSON.stringify(prior.manifest) || requirements(plan) !== requirements(prior.plan))) {
+    const before = revision(prior.plan);
+    if (currentRevision.number <= before.number || currentRevision.reason === before.reason) {
+      errors.push("Oracle/mapping changes require a higher plan revision and a new concrete reason; independent review remains required");
+    }
+  }
+  return errors;
+}
+
+/**
+ * @param {{report:any,previousToken?:string,beforeTree:string|null,afterTree:string|null,platform?:string,tests:{path:string,count:number,platform_counts?:Record<string,number>}[]}} input
+ * @returns {string[]}
+ */
+export function validateRunEvidence({ report, previousToken, beforeTree, afterTree, tests, platform = process.platform }) {
+  const errors = [];
+  if (!report || typeof report.runToken !== "string" || !report.runToken || report.runToken === previousToken) {
+    errors.push("Missing or non-fresh canonical runner report");
+  }
+  const actual = Object.keys(report?.files ?? {}).sort();
+  if (JSON.stringify(actual) !== JSON.stringify(tests.map(test => test.path).sort())) errors.push("Runner file roster does not match planned oracle roster");
+  const count = tests.reduce((sum, test) => sum + (test.platform_counts?.[platform] ?? test.count), 0);
+  const outcome = report?.outcome;
+  if (!outcome || outcome.total !== count) errors.push("Runner test count does not match pinned cases");
+  if (!outcome || outcome.passed !== count || outcome.failed !== 0 || outcome.skipped !== 0 || outcome.unfinished !== 0) errors.push("Oracle tests must all pass with zero skipped, failed or unfinished cases");
+  if (!beforeTree || !afterTree || beforeTree !== afterTree) errors.push("Oracle source tree changed or could not be observed");
+  return errors;
+}
+
+/** Relative static test imports are part of the oracle, including fixture helpers. */
+function testDependencies(root, path) {
+  if (!/\.(?:ts|mjs|js)$/u.test(path)) return [];
+  const imports = ts.preProcessFile(readFileSync(join(root, path), "utf8"), true, true).importedFiles;
+  return imports.flatMap(({ fileName }) => {
+    if (!fileName.startsWith(".")) return [];
+    const target = posix.normalize(posix.join(posix.dirname(path), fileName));
+    if (!target.startsWith("tests/")) return [];
+    const candidates = [target.replace(/\.js$/u, ".ts"), target, `${target}.ts`, `${target}.json`];
+    return [candidates.find(candidate => existsSync(join(root, candidate))) ?? target];
+  });
+}
+
+function main() {
+  const args = guardArgv(process.argv.slice(2), {
+    name: "check-engineering-contract", usage: "node scripts/check-engineering-contract.mjs [--run] [--base <commit>]",
+    flags: ["--run"], values: ["--base"],
+  });
+  const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
+  const read = path => readFileSync(join(root, path));
+  const git = argv => execFileSync("git", argv, { cwd: root, encoding: "utf8", windowsHide: true, stdio: ["ignore", "pipe", "pipe"] });
+  try {
+    const base = git(["rev-parse", "--verify", `${(args.get("--base") ?? "HEAD")}^{commit}`]).trim();
+    const manifest = JSON.parse(read(MANIFEST).toString("utf8"));
+    let prior;
+    if (git(["ls-tree", "--name-only", base, "--", MANIFEST]).trim()) {
+      prior = { manifest: JSON.parse(git(["show", `${base}:${MANIFEST}`])), plan: git(["show", `${base}:${PLAN}`]) };
+    }
+    const tracked = new Set(git(["ls-files", "-z"]).split("\0"));
+    const errors = validateContract({ plan: read(PLAN).toString("utf8"), manifest, read, dependencies: path => testDependencies(root, path), prior });
+    for (const path of [PLAN, MANIFEST, ...Object.keys(manifest.files ?? {})]) if (!tracked.has(path)) errors.push(`Contract input is not tracked/staged: ${path}`);
+    if (errors.length) throw new Error(errors.join("\n"));
+    console.log("✓ engineering-contract: all 14 original obligations mapped; oracle bytes pinned. This is not execution or review evidence.");
+    if (!args.has("--run")) return;
+    const ledgerPath = join(root, ".audit-tools-profile", "vitest-latest.json");
+    let previousToken;
+    try { previousToken = JSON.parse(readFileSync(ledgerPath, "utf8")).runToken; } catch { /* no previous report */ }
+    const beforeTree = worktreeTree(root);
+    if (!beforeTree) throw new Error("Cannot identify source tree before oracle execution");
+    const run = spawnSync(process.execPath, ["scripts/shared/run-vitest-gate.mjs", ...manifest.tests.map(test => test.path), "--maxWorkers=1", "--minWorkers=1"], {
+      cwd: root, stdio: "inherit", windowsHide: true,
+      env: { ...process.env, AUDIT_TOOLS_ISOLATED_LOAD_DIAGNOSTIC: "1" },
+    });
+    if (run.error || run.signal || run.status !== 0) throw new Error(`Canonical oracle runner failed: ${run.error?.message ?? run.signal ?? run.status}`);
+    let report;
+    try { report = JSON.parse(readFileSync(ledgerPath, "utf8")); } catch { /* verdict below fails closed */ }
+    const evidenceErrors = validateRunEvidence({ report, previousToken, beforeTree, afterTree: worktreeTree(root), tests: manifest.tests });
+    if (evidenceErrors.length) throw new Error(evidenceErrors.join("\n"));
+    console.log(`✓ engineering-contract: fresh exact-roster oracle run on tree ${beforeTree}; not a full-suite or release certificate.`);
+  } catch (error) {
+    console.error(`✗ engineering-contract: ${/** @type {Error} */ (error).message}`);
+    process.exitCode = 1;
+  }
+}
+if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) main();
