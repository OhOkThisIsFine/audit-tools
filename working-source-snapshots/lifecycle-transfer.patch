+/** Small fixed execution checkpoint for finalization, without model or analyzer work. */
+import { createRunState } from "../../../src/shared/engine/taskLifecycle.js";
+import { createLifecycleIO, createRunStore } from "../../../src/shared/engine/taskLifecycleStore.js";
+import { createAuditPolicy } from "../../../src/audit/lifecycle/auditPolicy.js";
+import { parseAuditDomain, type AuditDomain } from "../../../src/audit/lifecycle/auditDomain.js";
+import type { ArtifactBundle } from "../../../src/audit/io/artifacts.js";
+import type { AuditSource } from "../../../src/audit/lifecycle/preparationTasks.js";
+import { join } from "node:path";
+export async function finalizationRun(root: string, options: { narrative?: boolean; bundle?: ArtifactBundle } = {}) {
+  const artifactsDir = join(root, ".audit-tools", "audit");
+  const io = createLifecycleIO(artifactsDir);
+  const source = await io.writeArtifact({ repository_root: root, source_root: root, artifacts_dir: artifactsDir, options: {} } satisfies AuditSource);
+  const basis = await io.writeArtifact({ fixed: "completed preparation and execution", source });
+  const policy = createAuditPolicy();
+  const domain: AuditDomain = { repository_root: root, source_root: root, artifacts_dir: artifactsDir,
+    preparation: { repo_manifest: { repository: { name: "finalization" }, generated_at: "2026-01-01T00:00:00Z", files: [] }, file_disposition: { files: [] }, ...options.bundle }, line_index: {}, narrative_enabled: options.narrative ?? false };
+  const initialState = createRunState({ run_id: "fixed-finalization", mode: "audit", source, domain }, { ...policy, initialTasks: () => [] });
+  initialState.phase = "executing"; initialState.basis = basis;
+  const store = createRunStore({ directory: artifactsDir, initialState, parseDomain: parseAuditDomain });
+  await store.read();
+  return { store, policy, artifactsDir };
+}
