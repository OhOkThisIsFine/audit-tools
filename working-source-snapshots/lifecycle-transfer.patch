diff --git a/tests/shared/fixtures/file-lock-owner-worker.mjs b/tests/shared/fixtures/file-lock-owner-worker.mjs
new file mode 100644
index 00000000..8cd9120c
--- /dev/null
+++ b/tests/shared/fixtures/file-lock-owner-worker.mjs
@@ -0,0 +1,38 @@
+import { writeFile, unlink } from "node:fs/promises";
+import { acquireLock, withFileLock, STALE_LOCK_MS } from '../../../src/shared/io/fileLock.ts';
+const [mode, lockPath] = process.argv.slice(2);
+if (mode === 'abandon') {
+  await acquireLock(lockPath);
+  process.disconnect();
+} else if (mode === 'contend') {
+  const start = new Promise(resolve => process.on('message', message => { if (message === 'go') resolve(); }));
+  process.send('ready');
+  await start;
+  await withFileLock(lockPath, async assertOwnership => {
+    const release = new Promise(resolve => process.on('message', message => { if (message === 'release') resolve(); }));
+    // Independent exclusion witness: overlap fails wx, not merely IPC ordering.
+    const witness = `${lockPath}.critical`;
+    await writeFile(witness, String(process.pid), { flag: 'wx' });
+    process.send('entered');
+    await release;
+    await assertOwnership();
+    await unlink(witness);
+    process.send('leaving');
+  }, 10_000);
+  process.disconnect();
+} else {
+  await withFileLock(lockPath, async assertOwnership => {
+    const release = new Promise(resolve => process.on('message', message => {
+      if (message === 'release') resolve();
+    }));
+    process.send('entered');
+    // A genuine event-loop stall: no clock injection, external mtime changes,
+    // process suspension or heartbeat cancellation. The owner remains alive.
+    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, STALE_LOCK_MS + 1500);
+    process.send('resumed');
+    await release;
+    await assertOwnership();
+    process.send('ownership-retained');
+  });
+  process.disconnect();
+}
