diff --git a/tests/shared/repository-source-submodule.test.ts b/tests/shared/repository-source-submodule.test.ts
new file mode 100644
index 00000000..9b1de403
--- /dev/null
+++ b/tests/shared/repository-source-submodule.test.ts
@@ -0,0 +1,78 @@
+import { afterEach, expect, test } from "vitest";
+import { mkdtemp, mkdir, readFile, rm, symlink, writeFile } from "node:fs/promises";
+import { dirname, join } from "node:path";
+import { tmpdir } from "node:os";
+import { execFileHidden } from "../helpers/spawn.mjs";
+import { git } from "../audit/helpers/submoduleRepo.mjs";
+import { readRepositorySource, readRepositorySourceSync } from "../../src/shared/io/repositorySource.js";
+import { enumerateTrackedFilePaths, groundFinding } from "../../src/shared/validation/findingGrounding.js";
+import { checkCitations } from "../../src/shared/validation/citationGrounding.js";
+import type { Finding } from "../../src/shared/types/finding.js";
+
+function output(root: string, args: string[]): Promise<string> {
+  return new Promise((resolve, reject) => {
+    execFileHidden("git", args, { cwd: root, encoding: "utf8", windowsHide: true }, (error, stdout) => {
+      if (error) reject(error); else resolve(String(stdout));
+    });
+  });
+}
+const roots: string[] = [];
+afterEach(async () => { while (roots.length) await rm(roots.pop()!, { recursive: true, force: true }); });
+
+async function fixture(): Promise<string> {
+  const base = await mkdtemp(join(tmpdir(), "source-real-submodule-")); roots.push(base);
+  const root = join(base, "outer"), sub = join(root, "sub");
+  await mkdir(sub, { recursive: true });
+  const commit = async (cwd: string) => git(cwd, ["-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "synthetic source"]);
+  await git(root, ["init", "-q"]);
+  await git(sub, ["init", "-q"]);
+  await writeFile(join(sub, "a.ts"), "export const submoduleValue = 1;\n");
+  await git(sub, ["add", "a.ts"]); await commit(sub);
+  await writeFile(join(root, ".gitmodules"), '[submodule "sub"]\n\tpath = sub\n\turl = ./sub\n');
+  await git(root, ["add", ".gitmodules", "sub"]); await commit(root);
+  // Genuine committed gitlink + initialized absorbed submodule. Unlike a clone,
+  // this local-only construction needs no protocol.file.allow override at all.
+  await git(root, ["submodule", "init", "--", "sub"]);
+  await git(root, ["submodule", "absorbgitdirs", "--", "sub"]);
+  const index = await output(root, ["ls-files", "--stage", "--", "sub"]);
+  expect(index).toMatch(/^160000 [a-f0-9]{40} 0\tsub/);
+  expect(await readFile(join(sub, ".git"), "utf8")).toMatch(/^gitdir:/);
+  const status = await output(root, ["submodule", "status", "--", "sub"]);
+  expect(status).toMatch(/^ [a-f0-9]{40} sub/);
+  return root;
+}
+
+function finding(path: string): Finding {
+  return { id: "F-sub", title: "Synthetic", category: "test", severity: "medium", confidence: "high", lens: "security", summary: "Synthetic", evidence: [], affected_files: [{ path, quoted_text: "export const submoduleValue = 1;", line_start: 99 }] };
+}
+
+test("owned readers and actual grounding consumers admit a genuine in-root Git submodule", async () => {
+  const root = await fixture();
+  const corpus = await enumerateTrackedFilePaths(root);
+  expect(corpus.has("sub/a.ts")).toBe(true);
+  for (const candidate of ["sub/a.ts", join(root, "sub", "a.ts")]) {
+    expect(readRepositorySourceSync(root, candidate)).toMatchObject({ repoRelativePath: "sub/a.ts", text: "export const submoduleValue = 1;\n" });
+    expect(await readRepositorySource(root, candidate)).toMatchObject({ repoRelativePath: "sub/a.ts", text: "export const submoduleValue = 1;\n" });
+  }
+  const cited = finding("a.ts");
+  expect((await groundFinding(root, cited, undefined, corpus)).status).toBe("grounded");
+  expect(cited.affected_files![0]).toMatchObject({ path: "sub/a.ts", line_start: 1, line_end: 1 });
+  const checked = checkCitations({ root, corpus, citations: [{ owner_id: "basename", ref: "a.ts:1", quote: "export const submoduleValue = 1;" }, { owner_id: "path-only", ref: "sub/a.ts" }] });
+  expect(checked.checks.map(check => check.verdict)).toEqual(["ok", "ok"]);
+});
+
+test("a genuine submodule never grants authority to traversal or an outside directory link", async () => {
+  const root = await fixture();
+  const outside = join(dirname(root), "outside"); await mkdir(outside);
+  await writeFile(join(outside, "a.ts"), "export const submoduleValue = 1;\n");
+  await symlink(outside, join(root, "sub", "escape"), process.platform === "win32" ? "junction" : "dir");
+  const corpus = await enumerateTrackedFilePaths(root);
+  for (const candidate of ["../outside/a.ts", join(outside, "a.ts"), "sub/escape/a.ts"]) {
+    expect(() => readRepositorySourceSync(root, candidate)).toThrow();
+    await expect(readRepositorySource(root, candidate)).rejects.toThrow();
+    const cited = finding(candidate);
+    expect((await groundFinding(root, cited, undefined, corpus)).status).toBe("ungrounded");
+    expect(cited.affected_files![0]!.line_start).toBeUndefined();
+    expect(checkCitations({ root, corpus, citations: [{ owner_id: "escape", ref: candidate }] }).checks[0]!.verdict).toBe("unknown_path");
+  }
+});
