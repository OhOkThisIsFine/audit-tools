+  id: identity, kind: identity, phase: taskPhase,
+  depends_on: z.array(z.object({ task_id: identity, requires: z.enum(["accepted_evidence", "completed_required_scope"]) }).strict()),
+  inputs: z.record(z.union([ArtifactRefSchema, outputRef])),
+  subject: requiredValue, completion: z.enum(["complete", "selective"]), order: z.number().int().nonnegative().optional(), required: z.boolean().optional(),
+}).strict();
+const taskIssue = z.object({ basis: ArtifactRefSchema.optional(), inputs: z.record(ArtifactRefSchema), prompt: ArtifactRefSchema, prompt_body_sha256: digest, binding_sha256: digest, result_path: relativePath }).strict();
+const retryReceipt = z.object({
+  from_attempt: z.number().int().positive(), to_attempt: z.number().int().positive(),
+  reason: z.string().refine(value => value.trim().length > 0, "Retry requires an explicit reason"),
+  disposition: z.enum(["abandoned", "failed_without_effect", "reconciled_no_effect"]),
+  issued: taskIssue,
+}).strict();
+const outcome = z.enum(["complete", "partial", "blocked"]);
+export const TaskSubmissionSchema = z.object({
+  contract_version: z.literal("audit-tools-task-result/v1"), run_id: identity, task_id: identity,
+  attempt: z.number().int().positive(), binding_sha256: digest, outcome, payload: requiredValue,
+}).strict();
+const taskRecord = z.object({
+  spec: TaskSpecSchema, status: z.enum(["pending", "issued", "accepted", "blocked"]), attempt: z.number().int().nonnegative(),
+  issued: taskIssue.optional(),
+  retry_history: z.array(retryReceipt).optional(),
+  accepted: z.object({ raw: ArtifactRefSchema, outcome, normalized: ArtifactRefSchema.optional(), outputs: z.record(ArtifactRefSchema) }).strict().optional(),
+  blocker: z.object({ code: z.string().min(1), detail: z.string().min(1) }).strict().optional(),
+}).strict().superRefine((task, context) => {
+  if ((task.status === "issued" || task.status === "accepted") && (!task.issued || task.attempt < 1)) context.addIssue({ code: "custom", message: "Issued/accepted task requires an attempt binding" });
+  if ((task.status === "accepted") !== !!task.accepted) context.addIssue({ code: "custom", message: "Acceptance exists only on accepted tasks" });
+  if (task.status === "pending" && task.issued) context.addIssue({ code: "custom", message: "Pending task cannot retain an active assignment" });
+  const history = task.retry_history ?? [];
+  for (const [index, receipt] of history.entries()) {
+    if (receipt.to_attempt !== receipt.from_attempt + 1 || (index > 0 && receipt.from_attempt !== history[index - 1]!.to_attempt)) context.addIssue({ code: "custom", message: "Retry history must contain consecutive attempt transitions" });
+  }
+  if (history.length && history.at(-1)!.to_attempt !== task.attempt) context.addIssue({ code: "custom", message: "Retry history must end at the current attempt" });
+});
+export const RunStateSchema = z.object({
+  contract_version: z.literal("audit-tools-run/v1"), run_id: identity, mode: z.enum(["audit", "remediate"]),
+  phase, control: z.enum(["active", "paused", "cancelled"]), control_reason: z.string().optional(),
+  source: ArtifactRefSchema, basis: ArtifactRefSchema.optional(), tasks: z.record(taskRecord), domain: requiredValue,
+  deliverables: z.record(ArtifactRefSchema).optional(),
+}).strict().superRefine((state, context) => {
+  if (state.phase !== "preparing" && !state.basis) context.addIssue({ code: "custom", message: "Post-preparation phase requires a pinned basis" });
+  for (const [id, task] of Object.entries(state.tasks)) if (id !== task.spec.id) context.addIssue({ code: "custom", message: "Task key does not match immutable task identity" });
+});
