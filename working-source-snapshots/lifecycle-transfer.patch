+import { expect, test } from "vitest";
+import { existsSync, mkdtempSync, rmSync, statSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { jscpdCandidate } from "../../src/shared/analyzers/candidates.js";
+import { runExternalAnalyzer } from "../../src/shared/analyzers/acquisitionEngine.js";
+
+const ok = (argv: string[]) => ({ argv, status: 0, stdout: "", stderr: "", duration_ms: 1 });
+
+test("actual jscpd concurrent invocations own distinct report inputs and cleanup", async () => {
+  const root = mkdtempSync(join(tmpdir(), "jscpd-synthetic-root-"));
+  writeFileSync(join(root, "package.json"), "{}");
+  const directories: string[] = [];
+  let release!: () => void;
+  const bothStarted = new Promise<void>(resolve => { release = resolve; });
+  try {
+    const invoke = (name: string) => runExternalAnalyzer(jscpdCandidate, root, {
+      consentToken: { value: "fixture", tools: ["jscpd"] },
+      run: async argv => {
+        if (argv.includes("--version")) return ok(argv);
+        const directory = argv[argv.indexOf("--output") + 1];
+        directories.push(directory);
+        if (directories.length === 2) release();
+        await bothStarted;
+        // This assertion precedes writes, so a broken implementation cannot mix fixtures.
+        expect(directories[0]).not.toBe(directories[1]);
+        expect(existsSync(directory)).toBe(true);
+        if (process.platform !== "win32") expect(statSync(directory).mode & 0o777).toBe(0o700);
+        writeFileSync(join(root, name), "synthetic\n");
+        writeFileSync(join(directory, "jscpd-report.json"), JSON.stringify({ duplicates: [{
+          firstFile: { name, startLoc: { line: 1 }, endLoc: { line: 1 } },
+          secondFile: { name: "other.ts" }, lines: 1,
+        }] }));
+        return ok(argv);
+      },
+    });
+    const outcomes = await Promise.all([invoke("first.ts"), invoke("second.ts")]);
+    expect(directories[0]).not.toBe(directories[1]);
+    expect(outcomes.map(o => o.status.status)).toEqual(["findings", "findings"]);
+    expect(outcomes[0].results.results[0].path).toBe("first.ts");
+    expect(outcomes[1].results.results[0].path).toBe("second.ts");
+    for (const directory of directories) expect(existsSync(directory)).toBe(false);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
+
+for (const scenario of ["clean", "missing", "empty", "malformed", "nonzero", "throw"] as const) {
+  test(`jscpd owned report preserves failure evidence and cleanup: ${scenario}`, async () => {
+    const root = mkdtempSync(join(tmpdir(), "jscpd-synthetic-root-"));
+    writeFileSync(join(root, "package.json"), "{}");
+    let directory = "";
+    try {
+      const outcome = await runExternalAnalyzer(jscpdCandidate, root, {
+        consentToken: { value: "fixture", tools: ["jscpd"] },
+        run: async argv => {
+          if (argv.includes("--version")) return ok(argv);
+          directory = argv[argv.indexOf("--output") + 1];
+          if (scenario === "throw") throw new Error("ordinary synthetic runner failure");
+          if (scenario !== "missing") writeFileSync(join(directory, "jscpd-report.json"),
+            scenario === "empty" ? "" : scenario === "malformed" ? "not-json" : '{"duplicates":[]}');
+          return { ...ok(argv), status: scenario === "nonzero" ? 2 : 0,
+            stderr: "ordinary synthetic warning" };
+        },
+      });
+      expect(directory).not.toBe("");
+      expect(existsSync(directory)).toBe(false);
+      expect(outcome.status.status).toBe(scenario === "clean" ? "success" : (scenario === "nonzero" || scenario === "empty")
+        ? "failed" : scenario === "throw" ? "spawn_error" : "parse_error");
+      if (scenario !== "missing" && scenario !== "throw") {
+        expect(outcome.status.stderr_snippet).toBe("ordinary synthetic warning");
+      }
+      if (scenario === "malformed") expect(outcome.status.error).toContain("not valid JSON");
+      if (scenario === "throw") expect(outcome.status.error).toBe("ordinary synthetic runner failure");
+    } finally { rmSync(root, { recursive: true, force: true }); }
+  });
+}
+
+test("ordinary managed reporter retains degraded measurement notes and snippets", async () => {
+  const root = mkdtempSync(join(tmpdir(), "jscpd-synthetic-root-"));
+  writeFileSync(join(root, "package.json"), "{}");
+  try {
+    const outcome = await runExternalAnalyzer({ ...jscpdCandidate,
+      parse: () => ({ items: [], measurement_failed: true, note: "ordinary parser note" }),
+    }, root, {
+      consentToken: { value: "fixture", tools: ["jscpd"] },
+      run: async argv => {
+        if (argv.includes("--version")) return ok(argv);
+        writeFileSync(join(argv[argv.indexOf("--output") + 1], "jscpd-report.json"), "synthetic report");
+        return ok(argv);
+      },
+    });
+    expect(outcome.status.status).toBe("failed");
+    expect(outcome.status.error).toBe("ordinary parser note");
+    expect(outcome.status.output_snippet).toBe("synthetic report");
+  } finally { rmSync(root, { recursive: true, force: true }); }
+});
