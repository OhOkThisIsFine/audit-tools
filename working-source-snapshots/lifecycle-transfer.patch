diff --git a/src/audit/lifecycle/auditDomain.ts b/src/audit/lifecycle/auditDomain.ts
new file mode 100644
index 00000000..ce550ba4
--- /dev/null
+++ b/src/audit/lifecycle/auditDomain.ts
@@ -0,0 +1,191 @@
+// sites-pinned: tests/audit/accepted-lineage-projection.test.ts, tests/audit/lifecycle-audit-parity.test.ts, tests/audit/host-handoff.test.ts, tests/audit/selective-deepening-handoff.test.ts
+import { z } from "zod";
+import { hashContent, stableStringify } from "../../shared/index.js";
+import type { ArtifactRef, ReadContext, TaskSpec } from "../../shared/engine/taskLifecycleTypes.js";
+import type { AdvanceAuditOptions } from "../orchestrator/advanceTypes.js";
+import type { ArtifactBundle } from "../io/artifacts.js";
+import { AuditTaskSchema, type AuditTask, type AuditResult } from "../types.js";
+import { ingestAuditResults } from "../orchestrator/resultIngestion.js";
+import { buildDesignReviewSnapshot } from "../orchestrator/designReviewSnapshot.js";
+import { buildFlowCoverage } from "../orchestrator/flowCoverage.js";
+
+/** Domain facts only. Attempts, task status and accepted outputs live in the shared checkpoint. */
+export interface AuditDomain {
+  repository_root: string;
+  source_root: string;
+  artifacts_dir: string;
+  preparation: ArtifactBundle;
+  line_index: Record<string, number>;
+  narrative_enabled: boolean;
+  initial_plan?: ArtifactRef;
+  preparation_options?: AdvanceAuditOptions;
+}
+
+const DomainShape = z.object({
+  repository_root: z.string().min(1), source_root: z.string().min(1),
+  artifacts_dir: z.string().min(1), preparation: z.record(z.string(), z.unknown()),
+  line_index: z.record(z.string(), z.number().int().nonnegative()),
+  narrative_enabled: z.boolean(),
+  preparation_options: z.record(z.string(), z.unknown()).optional(),
+  initial_plan: z.object({ path: z.string().min(1), sha256: z.string().regex(/^[a-f0-9]{64}$/) }).strict().optional(),
+}).strict();
+
+export function parseAuditDomain(value: unknown): AuditDomain {
+  const domain = DomainShape.parse(value) as AuditDomain;
+  // These are projections of coordinator-owned task records, never writable authorities.
+  if (domain.preparation.audit_results !== undefined || domain.preparation.audit_state !== undefined ||
+      domain.preparation.artifact_metadata !== undefined) {
+    throw new Error("Audit preparation cannot contain task results, lifecycle state, or artifact freshness authority.");
+  }
+  return domain;
+}
+
+export interface InspectionSubject {
+  task: AuditTask;
+  root_task_id: string;
+  parent_task_id?: string;
+}
+export const InspectionSubjectSchema = z.object({
+  task: AuditTaskSchema,
+  root_task_id: z.string().min(1),
+  parent_task_id: z.string().min(1).optional(),
+}).strict().superRefine((subject, context) => {
+  if (subject.task.file_metrics !== undefined && subject.task.coverage_policy !== "selective") {
+    context.addIssue({ code: z.ZodIssueCode.custom, path: ["task", "file_metrics"], message: "file_metrics are permitted only on selective inspection tasks" });
+  }
+});
+
+export function inspectionSubject(spec: TaskSpec): InspectionSubject {
+  return InspectionSubjectSchema.parse(spec.subject);
+}
+
+export function isInspectionTask(spec: TaskSpec): boolean {
+  return spec.kind === "audit.inspection" || spec.kind === "audit.selective-inspection";
+}
+
+export function inspectionSpec(task: AuditTask, basis: ArtifactRef, dependencies: TaskSpec["depends_on"] = [], parent?: InspectionSubject): TaskSpec {
+  // construction-site: AuditTask (the pinned, status-free task projection)
+  const cleanTask = { ...task };
+  delete cleanTask.status;
+  const subject: InspectionSubject = {
+    task: cleanTask,
+    root_task_id: parent?.root_task_id ?? task.task_id,
+    ...(parent ? { parent_task_id: parent.task.task_id } : {}),
+  };
+  return {
+    id: task.task_id,
+    kind: task.coverage_policy === "selective" ? "audit.selective-inspection" : "audit.inspection",
+    phase: "executing", completion: task.coverage_policy === "selective" ? "selective" : "complete",
+    depends_on: dependencies, inputs: { basis }, subject,
+  };
+}
+
+/** Compact host prompts read the full ranked selective surface through an immutable input. */
+export function inspectionSurface(task: AuditTask): unknown {
+  return { file_paths: task.file_paths, file_line_counts: task.file_line_counts, file_metrics: task.file_metrics };
+}
+export function bindAddedInspectionSurfaces(tasks: TaskSpec[], predecessor: string): Record<string, unknown> {
+  const outputs: Record<string, unknown> = {};
+  for (const task of tasks) if (task.completion === "selective") {
+    const output = `surface_${hashContent(task.id, { length: 16 })}`;
+    outputs[output] = inspectionSurface(inspectionSubject(task).task);
+    task.inputs.surface = { task_id: predecessor, output };
+  }
+  return outputs;
+}
+
+/** Canonical residual identity binds the original task and the strictly smaller remaining file set. */
+export function residualInspectionSpec(parent: TaskSpec, covered: ReadonlySet<string>, basis: ArtifactRef): TaskSpec | undefined {
+  const subject = inspectionSubject(parent);
+  const remaining = subject.task.file_paths.filter(path => !covered.has(path)).sort();
+  if (remaining.length === 0 || remaining.length === subject.task.file_paths.length) return undefined;
+  const id = `${subject.root_task_id}:residual:${hashContent(stableStringify(remaining), { length: 16 })}`;
+  const task: AuditTask = {
+    ...subject.task, task_id: id,
+    file_paths: remaining,
+    file_line_counts: Object.fromEntries(remaining.map(path => [path, subject.task.file_line_counts?.[path] ?? 0])),
+  };
+  return inspectionSpec(task, basis, [{ task_id: parent.id, requires: "accepted_evidence" }], subject);
+}
+
+/** Partial parent acceptance is immutable. Its required scope completes only through the accepted lineage union. */
+export function inspectionScopeComplete(taskId: string, context: ReadContext<AuditDomain>): boolean {
+  const record = context.state.tasks[taskId];
+  if (!record || record.status !== "accepted") return false;
+  if (record.spec.completion === "selective") return record.accepted?.outcome === "complete";
+  const subject = inspectionSubject(record.spec);
+  const covered = new Set<string>();
+  for (const sibling of Object.values(context.state.tasks)) {
+    if (!isInspectionTask(sibling.spec) || sibling.status !== "accepted") continue;
+    const member = inspectionSubject(sibling.spec);
+    if (member.root_task_id !== subject.root_task_id) continue;
+    const result = context.acceptedPayloads.get(sibling.spec.id) as AuditResult | undefined;
+    for (const file of result?.file_coverage ?? []) covered.add(file.path);
+  }
+  return subject.task.file_paths.every(path => covered.has(path));
+}
+
+/**
+ * Whole-scope analytical view, never an acceptance rewrite. A validated candidate
+ * is explicit because reducers run before its acceptance is committed. Runtime
+ * and synthesis omit it and therefore see only accepted completed lineages.
+ */
+export function projectCompletedInspectionResults(context: ReadContext<AuditDomain>, validatedCandidate?: AuditResult): AuditResult[] {
+  const acceptedResults: AuditResult[] = [];
+  for (const record of Object.values(context.state.tasks)) {
+    if (!isInspectionTask(record.spec) || record.status !== "accepted" || record.spec.id === validatedCandidate?.task_id) continue;
+    const result = context.acceptedPayloads.get(record.spec.id) as AuditResult | undefined;
+    if (result) acceptedResults.push(result);
+  }
+  if (validatedCandidate) acceptedResults.push(validatedCandidate);
+  const results: AuditResult[] = [];
+  for (const record of Object.values(context.state.tasks)) {
+    if (!isInspectionTask(record.spec)) continue;
+    const original = inspectionSubject(record.spec);
+    if (original.parent_task_id) continue;
+    if (!validatedCandidate && !inspectionScopeComplete(record.spec.id, context)) continue;
+    const rootResult = acceptedResults.find(result => result.task_id === original.task.task_id);
+    if (!rootResult) continue;
+    const members = acceptedResults.filter(candidate => {
+      const member = context.state.tasks[candidate.task_id];
+      return member && isInspectionTask(member.spec) && inspectionSubject(member.spec).root_task_id === original.root_task_id;
+    });
+    const coverage = new Map(members.flatMap(member => member.file_coverage.map(file => [file.path, file] as const)));
+    if (record.spec.completion !== "selective" && !original.task.file_paths.every(path => coverage.has(path))) continue;
+    // Identity and non-aggregated metadata remain the root's. Selective review
+    // is one whole-result task, so its verification metadata is not combined.
+    results.push({ ...rootResult, task_id: original.task.task_id, file_coverage: [...coverage.values()],
+      findings: members.flatMap(member => member.findings), reviewed_clean: members.every(member => member.reviewed_clean === true) });
+  }
+  return results;
+}
+
+/** Read model only: all results come from verified immutable acceptance, never host-writable artifacts. */
+export function projectAuditBundle(context: ReadContext<AuditDomain>): ArtifactBundle {
+  const tasks: AuditTask[] = [];
+  const results: AuditResult[] = [];
+  for (const record of Object.values(context.state.tasks)) {
+    if (!isInspectionTask(record.spec)) continue;
+    tasks.push({ ...inspectionSubject(record.spec).task,
+      status: inspectionScopeComplete(record.spec.id, context) ? "complete" : "pending" });
+    if (record.status === "accepted") {
+      const payload = context.acceptedPayloads.get(record.spec.id) as AuditResult | undefined;
+      if (payload) results.push(payload);
+    }
+  }
+  const runtime = context.acceptedPayloads.get("audit.runtime-validation") as ArtifactBundle["runtime_validation_report"];
+  const base = { ...context.state.domain.preparation, ...(runtime ? { runtime_validation_report: runtime } : {}) };
+  // Legacy snapshot-shaped reporting input is a derived view of exact accepted review tasks,
+  // never read from disk and never consulted for lifecycle readiness or re-review.
+  const snapshots: NonNullable<ArtifactBundle["design_review_snapshots"]> = {};
+  for (const pass of ["contract", "conceptual"] as const) {
+    const id = pass === "contract" ? "audit.prepare.review.contract" : context.state.tasks["audit.prepare.review.judge"] ? "audit.prepare.review.judge" : "audit.prepare.review.conceptual";
+    const accepted = context.state.tasks[id]?.accepted;
+    if (accepted && base.design_assessment?.[`${pass}_reviewed`]) snapshots[pass] = buildDesignReviewSnapshot(pass, base.design_assessment[`${pass}_findings`] ?? [], base, `accepted:${accepted.raw.sha256}`);
+  }
+  const coverage = base.coverage_matrix ? ingestAuditResults(base.coverage_matrix, results) : undefined;
+  return { ...base, audit_tasks: tasks, audit_results: results, design_review_snapshots: snapshots,
+    ...(coverage ? { coverage_matrix: coverage } : {}),
+    ...(coverage && base.critical_flows ? { flow_coverage: buildFlowCoverage(base.critical_flows, coverage) } : {}),
+  };
+}
diff --git a/src/audit/lifecycle/auditPolicy.ts b/src/audit/lifecycle/auditPolicy.ts
