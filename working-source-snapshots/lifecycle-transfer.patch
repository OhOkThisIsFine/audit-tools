+import { readFile, writeFile, utimes } from 'node:fs/promises';
+import { expect, test, vi } from 'vitest';
+import { acquireLock, releaseLock, FileLockTimeoutError, STALE_LOCK_MS } from '../../src/shared/io/fileLock.js';
+import { tmpLockPath, withTempDir } from './fileLockTestSupport.mjs';
+import { abandonedLock, automaticRecoveryAvailable } from './fileLockOwnerTestSupport.js';
+
+async function makeOld(path: string, bytes: string) {
+  await writeFile(path, bytes);
+  const past = new Date(Date.now() - STALE_LOCK_MS * 2);
+  await utimes(path, past, past);
+}
+
+test.each([{ name: 'empty', bytes: '' }, { name: 'legacy', bytes: 'stale-holder-token' }, { name: 'malformed', bytes: '{"version":' }, { name: 'oversized', bytes: 'x'.repeat(4097) }])('unknown or legacy owner bytes are never age-reaped ($name)', async ({ bytes }) => {
+  await withTempDir(async (dir: string) => {
+    const path = tmpLockPath(dir);
+    await makeOld(path, bytes);
+    await expect(acquireLock(path, 0)).rejects.toBeInstanceOf(FileLockTimeoutError);
+    expect(await readFile(path, 'utf8')).toBe(bytes);
+  });
+});
+
+test.each(['EPERM', 'EACCES', 'EIO'])('ambiguous process probe %s fails closed', async code => {
+  await withTempDir(async (dir: string) => {
+    const path = tmpLockPath(dir);
+    const bytes = await abandonedLock(path);
+    // Fault injection only: no signal is sent, and no unrelated PID is probed.
+    const probe = vi.spyOn(process, 'kill').mockImplementation(() => { throw Object.assign(new Error(code), { code }); });
+    try {
+      await expect(acquireLock(path, 0)).rejects.toBeInstanceOf(FileLockTimeoutError);
+      expect(await readFile(path, 'utf8')).toBe(bytes);
+    } finally { probe.mockRestore(); }
+  });
+});
+
+test('an old recovery claim is never stolen while its owner may still act', async () => {
+  await withTempDir(async (dir: string) => {
+    const path = tmpLockPath(dir);
+    const bytes = await abandonedLock(path);
+    await makeOld(`${path}.steal`, 'unknown-reaper');
+    await expect(acquireLock(path, 0)).rejects.toBeInstanceOf(FileLockTimeoutError);
+    expect(await readFile(path, 'utf8')).toBe(bytes);
+    expect(await readFile(`${path}.steal`, 'utf8')).toBe('unknown-reaper');
+  });
+});
+
+test('free locks do not require removal of an abandoned recovery claim', async () => {
+  await withTempDir(async (dir: string) => {
+    const path = tmpLockPath(dir);
+    await makeOld(`${path}.steal`, 'unknown-reaper');
+    const token = await acquireLock(path, 0);
+    await releaseLock(path, token);
+    expect(await readFile(`${path}.steal`, 'utf8')).toBe('unknown-reaper');
+  });
+});
+
+
+test.each(['foreign-boot', 'foreign-namespace', 'unknown-scope', 'invalid-pid'])('owner identity %s fails closed without a process probe', async change => {
+  await withTempDir(async (dir: string) => {
+    const path = tmpLockPath(dir);
+    const original = await acquireLock(path);
+    await releaseLock(path, original);
+    const record = JSON.parse(original);
+    if (change === 'foreign-boot') record.ownerScope = { kind: 'linux', boot_id: '11111111-1111-4111-8111-111111111111', pid_namespace: 'pid:[1]' };
+    if (change === 'foreign-namespace') record.ownerScope = { ...record.ownerScope, pid_namespace: 'pid:[1]' };
+    if (change === 'unknown-scope') record.ownerScope = { kind: 'unknown' };
+    if (change === 'invalid-pid') record.pid = -1;
+    const bytes = JSON.stringify(record);
+    await makeOld(path, bytes);
+    const probe = vi.spyOn(process, 'kill').mockImplementation(() => { throw new Error('must not probe foreign/invalid ownership'); });
+    try {
+      await expect(acquireLock(path, 0)).rejects.toBeInstanceOf(FileLockTimeoutError);
+      expect(probe).not.toHaveBeenCalled();
+      expect(await readFile(path, 'utf8')).toBe(bytes);
+    } finally { probe.mockRestore(); }
+  });
+});
+
+
+test('a live or reused PID at the second proof prevents removal', async () => {
+  await withTempDir(async (dir: string) => {
+    const path = tmpLockPath(dir), dead = await abandonedLock(path);
+    const available = await automaticRecoveryAvailable(path);
+    let probes = 0;
+    const probe = vi.spyOn(process, 'kill').mockImplementation(() => {
+      if (++probes === 1) throw Object.assign(new Error('synthetic initial absence'), { code: 'ESRCH' });
+      return true; // A live/reused PID never grants removal.
+    });
+    try {
+      await expect(acquireLock(path, 0)).rejects.toBeInstanceOf(FileLockTimeoutError);
+      expect(probes).toBe(available ? 2 : 0);
+      expect(await readFile(path, 'utf8')).toBe(dead);
+    } finally { probe.mockRestore(); }
+  });
+});
