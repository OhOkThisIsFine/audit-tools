+import { expect, test } from "vitest";
+import { readFile, rm, symlink, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { withTempDir } from "./fileLockTestSupport.mjs";
+import { createLifecycleIO, createRunStore } from "../../src/shared/engine/taskLifecycleStore.js";
+import { ArtifactRefSchema, RunStateSchema, TaskSpecSchema, TaskSubmissionSchema } from "../../src/shared/engine/taskLifecycleSchema.js";
+import type { RunState } from "../../src/shared/engine/taskLifecycleTypes.js";
+
+async function initial(directory: string): Promise<RunState<{ ok: true }>> {
+  const source = await createLifecycleIO(directory).writeArtifact({ source: "frozen" });
+  return { contract_version: "audit-tools-run/v1", run_id: "test-run", mode: "audit", phase: "preparing", control: "active", source, tasks: {}, domain: { ok: true } };
+}
+const parseDomain = (value: unknown): { ok: true } => {
+  if ((value as { ok?: unknown })?.ok !== true) throw new Error("Invalid domain");
+  return { ok: true };
+};
+
+test("strict checkpoint/result schema rejects missing domain, payload, subject and provider extras", async () => {
+  await withTempDir(async (dir: string) => {
+    const state = await initial(dir);
+    const { domain: _domain, ...withoutDomain } = state;
+    expect(RunStateSchema.safeParse(withoutDomain).success).toBe(false);
+    expect(RunStateSchema.safeParse({ ...state, contract_version: "audit-tools-run/v0" }).success).toBe(false);
+    expect(TaskSubmissionSchema.safeParse({ contract_version: "audit-tools-task-result/v1", run_id: "run", task_id: "task", attempt: 1, binding_sha256: "a".repeat(64), outcome: "complete" }).success).toBe(false);
+    expect(TaskSpecSchema.safeParse({ id: "task", kind: "test", phase: "preparing", inputs: {}, depends_on: [], completion: "complete" }).success).toBe(false);
+    expect(RunStateSchema.safeParse({ ...state, provider: "unowned" }).success).toBe(false);
+    for (const path of ["../escape", "/outside", "C:/outside", "a/../b", "a\\b", "a//b"]) expect(ArtifactRefSchema.safeParse({ path, sha256: "a".repeat(64) }).success).toBe(false);
+  });
+});
+
+test("unknown/corrupt checkpoints stay untouched rather than becoming new runs", async () => {
+  await withTempDir(async (dir: string) => {
+    const state = await initial(dir);
+    const store = createRunStore({ directory: dir, initialState: state, parseDomain });
+    const path = join(dir, "run-state.json");
+    const old = JSON.stringify({ ...state, contract_version: "audit-tools-run/v0" });
+    await writeFile(path, old);
+    await expect(store.read()).rejects.toThrow();
+    await expect(store.mutate(async current => current)).rejects.toThrow();
+    expect(await readFile(path, "utf8")).toBe(old);
+    await writeFile(path, "{broken");
+    await expect(store.read()).rejects.toThrow(/invalid json/i);
+    expect(await readFile(path, "utf8")).toBe("{broken");
+  });
+});
+
+test("content-addressed artifacts never overwrite corrupt bytes and symlinks cannot escape run root", async () => {
+  await withTempDir(async (dir: string) => {
+    const io = createLifecycleIO(dir);
+    const ref = await io.writeArtifact({ original: true });
+    expect(await io.writeArtifact({ original: true })).toEqual(ref);
+    await writeFile(join(dir, ref.path), "modified");
+    await expect(io.readArtifact(ref)).rejects.toThrow(/integrity/i);
+    await expect(io.writeArtifact({ original: true })).rejects.toThrow(/integrity/i);
+    expect(await readFile(join(dir, ref.path), "utf8")).toBe("modified");
+    await withTempDir(async (outside: string) => {
+      await writeFile(join(outside, "evidence.json"), "{}");
+      // A junction exercises the same realpath escape on Windows without
+      // requiring the privilege needed to create a directory symbolic link.
+      await symlink(outside, join(dir, "escape"), process.platform === "win32" ? "junction" : "dir");
