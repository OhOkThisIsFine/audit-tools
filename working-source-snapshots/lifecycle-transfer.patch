+// sites-pinned: tests/shared/task-lifecycle-schema-generation.test.ts
+// Public JSON projections of the runtime lifecycle schemas, never a second
+// definition of acceptance or phase readiness.
+import { zodToJsonSchema } from "zod-to-json-schema";
+import {
+  RunStateSchema,
+  TaskSpecSchema,
+  TaskSubmissionSchema,
+} from "../../src/shared/engine/taskLifecycleSchema.ts";
+
+export const LIFECYCLE_SCHEMA_SOURCES = {
+  "run_state.schema.json": {
+    schema: RunStateSchema,
+    title: "AuditToolsRun",
+  },
+  "lifecycle_task.schema.json": {
+    schema: TaskSpecSchema,
+    title: "AuditToolsTask",
+  },
+  "task_result.schema.json": {
+    schema: TaskSubmissionSchema,
+    title: "AuditToolsTaskResult",
+  },
+};
+
+/** @param {keyof typeof LIFECYCLE_SCHEMA_SOURCES} filename */
+export function renderLifecycleJsonSchema(filename) {
+  const entry = LIFECYCLE_SCHEMA_SOURCES[filename];
+  const generated = zodToJsonSchema(entry.schema, {
+    $refStrategy: "none",
+    target: "jsonSchema7",
+  });
+  return {
+    ...generated,
+    $schema: "https://json-schema.org/draft/2020-12/schema",
+    $id: filename,
+    title: entry.title,
+  };
+}
