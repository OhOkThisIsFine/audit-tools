+async function legacy(root: string): Promise<string> {
+  const dir = join(root, ".audit-tools", "audit");
+  await mkdir(dir, { recursive: true });
+  await writeFile(join(dir, "audit_state.json"), JSON.stringify({ status: "not_started" }));
+  await writeFile(join(dir, "evidence.txt"), "legacy evidence");
+  return dir;
+}
+function latch() {
+  let resolve!: () => void;
+  const promise = new Promise<void>((done) => { resolve = done; });
+  return { promise, resolve };
+}
+
+test.each(["active", "checkpoint"])("cleanup waits for a live owner and rechecks %s retention", async (change) => {
+  await withTempDir("cleanup-live-", async (root) => {
+    const dir = await legacy(root);
+    let pending: Promise<unknown> | undefined;
+    let settled = false;
+    try {
+      await withArtifactTreeHold(dir, undefined, async (assertOwnership) => {
+        pending = cleanupStaleArtifactsDir(dir).finally(() => { settled = true; });
+        await delay(100);
+        expect(settled, "cleanup cannot finish while another callback owns the tree").toBe(false);
+        await assertOwnership();
+        if (change === "active") await writeFile(join(dir, "audit_state.json"), JSON.stringify({ status: "active" }));
+        else await writeFile(join(dir, "run-state.json"), "retained checkpoint");
+      });
+      expect(await pending).toMatchObject({ action: "skipped" });
+      expect(await readFile(join(dir, "evidence.txt"), "utf8")).toBe("legacy evidence");
+    } finally { await pending; }
+  });
+});
