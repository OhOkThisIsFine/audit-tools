-  return {
-    task_id: taskId,
-    unit_id: unitId,
-    pass_id: passId,
-    lens,
-    file_paths: files,
-    file_line_counts: Object.fromEntries(
-      Object.entries(normalizedLineCounts).sort(([left], [right]) =>
-        compareCodeUnits(left, right),
