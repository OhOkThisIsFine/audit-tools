+      def.runDeterministic = async task => { now += 100; return { outcome: "complete", payload: { files: subject(task.spec.subject).files } }; };
+      const bounded = await advanceRun(store, p, { draw: "deterministic", maxExecutions: 10, deadline: { at: now + 100 } });
+      expect(bounded.stopped).toBe("budget"); expect(bounded.executions).toBe(1);
+      expect(bounded.state.tasks.one!.status).toBe("accepted");
+      expect(bounded.state.tasks.two).toMatchObject({ status: "pending", attempt: 0 });
+      await expect(advanceRun(store, p, { draw: "full", maxExecutions: 10, deadline: { at: NaN } })).rejects.toThrow(/finite timestamp/);
+    } finally { time.mockRestore(); }
+  });
+});
+
+
+test("retry records a bound append-only reason and disposition across reload", async () => {
+  await withTempDir(async (dir: string) => {
+    const p = policy([spec("root", ["A"])]), store = await setup(dir, p);
+    const [first] = await issueTasks(store, ["root"], p);
+    const originalIssue = (await store.read()).tasks.root!.issued!;
+    const request = { expectedAttempt: 1, reason: "Host process ended without a result", disposition: "abandoned" as const };
+    await retryTask(store, "root", request, p);
+    const resumed = createRunStore({ directory: dir, parseDomain: p.parseDomain });
+    const record = (await resumed.read()).tasks.root!;
+    expect(record.retry_history).toEqual([{ from_attempt: 1, to_attempt: 2, reason: request.reason, disposition: request.disposition, issued: originalIssue }]);
+    expect(await resumed.io.readText(record.retry_history![0]!.issued.prompt)).toEqual(await resumed.io.readText(first!.prompt));
+    await retryTask(resumed, "root", { expectedAttempt: 2, reason: "Second host attempt failed without effect", disposition: "failed_without_effect" }, p);
+    const twice = (await resumed.read()).tasks.root!;
+    expect(twice.retry_history).toHaveLength(2);
+    expect(twice.retry_history![0]).toEqual(record.retry_history![0]);
+    await expect(resumed.mutate(async state => { state.tasks.root!.retry_history![0]!.reason = "Rewritten reason"; return state; })).rejects.toThrow(/retry.*immutable|immutable.*retry/i);
+    await expect(resumed.mutate(async state => { state.tasks.root!.retry_history = []; return state; })).rejects.toThrow(/retry.*immutable|immutable.*retry/i);
+  });
+});
+
+test("retry refuses changed rendering premises without replacing the outstanding attempt", async () => {
+  await withTempDir(async (dir: string) => {
+    const p = policy([spec("root", ["A"])]);
+    p.definitions.get("coverage")!.render = (task, context) => `Pinned premise ${context.state.domain.reductions}; output ${task.result_path}`;
+    const store = await setup(dir, p); await issueTasks(store, ["root"], p);
+    await store.mutate(async state => { state.domain.reductions++; return state; });
+    const before = await store.read();
+    await expect(retryTask(store, "root", { expectedAttempt: 1, reason: "No reply", disposition: "abandoned" }, p)).rejects.toThrow(/render.*premis|premis.*render/i);
+    expect(await store.read()).toEqual(before);
+  });
+});
+
+test.each(["error", "nondeterministic"] as const)("retry fails closed for a %s new-attempt renderer", async mode => {
+  await withTempDir(async (dir: string) => {
+    const p = policy([spec("root", ["A"])]); let serial = 0;
+    p.definitions.get("coverage")!.render = task => {
+      if (task.attempt === 1) return `Pinned original output ${task.result_path}`;
+      if (mode === "error") throw new Error("Renderer unavailable");
+      return `Unstable ${++serial}; output ${task.result_path}`;
+    };
+    const store = await setup(dir, p); await issueTasks(store, ["root"], p);
+    const before = await store.read();
+    await expect(retryTask(store, "root", { expectedAttempt: 1, reason: "No reply", disposition: "abandoned" }, p)).rejects.toThrow(mode === "error" ? /Renderer unavailable/ : /nondeterministic|unstable/i);
+    expect(await store.read()).toEqual(before);
+  });
+});
+
+
+test("retry receipts retain integrity-checked prior prompt evidence", async () => {
+  await withTempDir(async (dir: string) => {
+    const p = policy([spec("root", ["A"])]), store = await setup(dir, p);
+    const [first] = await issueTasks(store, ["root"], p);
+    await retryTask(store, "root", { expectedAttempt: 1, reason: "No effect observed", disposition: "failed_without_effect" }, p);
+    await writeFile(join(dir, first!.prompt.path), "Changed historical prompt");
+    await expect(createRunStore({ directory: dir, parseDomain: p.parseDomain }).read()).rejects.toThrow(/integrity|modified evidence/i);
+  });
+});
