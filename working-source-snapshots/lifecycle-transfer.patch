+
+export async function advanceRun<Domain>(store: RunStore<Domain>, policy: DrawPolicy<Domain>, options: { draw: "full" | "deterministic"; maxExecutions: number; deadline?: { at: number } }): Promise<LifecycleStep<Domain>> {
