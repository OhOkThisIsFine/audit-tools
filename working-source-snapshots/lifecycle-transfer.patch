+async function pushFixture(withUpstream = true) {
+  const f = await finalLifecycleFixture({ scope: "scoped_out", closing: { action: "push", allowed_files: [] } }); roots.push(f.root);
+  const remotes = await mkdtemp(join(tmpdir(), "closing-remotes-")); roots.push(remotes);
+  const a = join(remotes, "a.git"), b = join(remotes, "b.git");
+  for (const remote of [a, b]) execFileSync("git", ["clone", "--bare", f.root, remote], { encoding: "utf8", stdio: "pipe" });
+  const branch = f.git("symbolic-ref", "--short", "HEAD");
+  f.git("remote", "add", "origin", a); f.git("remote", "add", "other", b);
+  if (withUpstream) { f.git("config", `branch.${branch}.remote`, "origin"); f.git("config", `branch.${branch}.merge`, `refs/heads/${branch}`); }
