--- /dev/null
+++ b/tests/audit/runtime-lifecycle.test.ts
@@ -0,0 +1,108 @@
+/** Synthetic observations only: the real shared draw invokes one fixed local runner. */
+import { test, expect, vi } from "vitest";
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { acceptSubmission, advanceRun, issueTasks, readyTasks } from "../../src/shared/engine/taskLifecycle.js";
+import { readRunContext } from "../../src/shared/engine/taskLifecycleStore.js";
+import { runtimeTask } from "../../src/audit/lifecycle/runtimeTask.js";
+import { EXECUTOR_RUNNERS } from "../../src/audit/orchestrator/executorRunners.js";
+import { fixedAuditInspectionRun, writeAuditInspectionSubmission } from "./helpers/lifecycleFixture.js";
+
+test("runtime waits for full residual scope, records a red observation once, and never reruns it on resume", async () => {
+  const root = await mkdtemp(join(tmpdir(), "audit-runtime-lifecycle-"));
+  const planned = { runtime_validation_tasks: { tasks: [{ id: "fixed-runtime", kind: "unit-risk-check" as const,
+    target_paths: ["a.ts"], reason: "Fixed runtime observation", priority: "high" as const, command: ["fixed-no-spawn"] }] } };
+  const report = { results: [{ task_id: "fixed-runtime", status: "not_confirmed" as const,
+    summary: "Synthetic assertion failed", evidence: ["fixed exit: 1"], notes: [] }] };
+  const runner = vi.spyOn(EXECUTOR_RUNNERS, "runtime_validation_executor").mockImplementation(async (bundle, context) => {
+    expect(bundle).toEqual(planned); expect(context.options.root).toBe(root);
+    return { updated: { ...bundle, runtime_validation_report: report }, artifacts_written: [], progress_summary: "Fixed red observation" };
+  });
+  try {
+    const f = await fixedAuditInspectionRun(root, { groups: [["a.ts", "b.ts"]] });
+    const bundle = await f.store.io.writeArtifact(planned);
+    await f.store.mutate(async state => {
+      const spec = runtimeTask(bundle, Object.values(state.tasks).map(task => task.spec));
+      state.tasks[spec.id] = { spec, status: "pending", attempt: 0 }; return state;
+    });
+    expect(readyTasks(await readRunContext(f.store), f.policy).map(task => task.id)).toEqual(["inspect-0"]);
+    const [parent] = await issueTasks(f.store, ["inspect-0"], f.policy);
+    await acceptSubmission(f.store, await writeAuditInspectionSubmission(f.store, parent!, ["a.ts"], "partial"), f.policy);
+    const residuals = readyTasks(await readRunContext(f.store), f.policy);
+    expect(residuals).toHaveLength(1); expect(residuals[0]!.id).toContain(":residual:");
+    expect(runner).not.toHaveBeenCalled();
+    const [residual] = await issueTasks(f.store, [residuals[0]!.id], f.policy);
+    await acceptSubmission(f.store, await writeAuditInspectionSubmission(f.store, residual!), f.policy);
+    expect(readyTasks(await readRunContext(f.store), f.policy).map(task => task.id)).toEqual(["audit.runtime-validation"]);
+    const first = await advanceRun(f.store, f.policy, { draw: "deterministic", maxExecutions: 1 });
+    expect(first.executions).toBe(1); expect(runner).toHaveBeenCalledTimes(1);
+    const accepted = first.state.tasks["audit.runtime-validation"]!.accepted!;
+    expect(accepted.outcome).toBe("complete");
+    expect((await readRunContext(f.store)).acceptedPayloads.get("audit.runtime-validation")).toEqual(report);
+    await advanceRun(f.store, f.policy, { draw: "full", maxExecutions: 16 });
+    await advanceRun(f.store, f.policy, { draw: "full", maxExecutions: 16 });
+    expect(runner).toHaveBeenCalledTimes(1);
+    expect((await f.store.read()).tasks["audit.runtime-validation"]!.accepted).toEqual(accepted);
+    expect((await readRunContext(f.store)).acceptedPayloads.get("audit.runtime-validation")).toEqual(report);
+  } finally { runner.mockRestore(); await rm(root, { recursive: true, force: true }); }
+});
+
+async function issuedRuntimeFixture(root: string) {
+  const f = await fixedAuditInspectionRun(root, { groups: [] });
+  const manifest = { tasks: ["fixed-a", "fixed-b"].map(id => ({ id, kind: "unit-risk-check" as const,
+    target_paths: ["fixed.ts"], reason: "Fixed synthetic observation", priority: "low" as const })) };
+  const bundle = await f.store.io.writeArtifact({ runtime_validation_tasks: manifest });
+  await f.store.mutate(async state => {
+    const spec = runtimeTask(bundle, []);
+    state.tasks[spec.id] = { spec, status: "pending", attempt: 0 }; return state;
+  });
+  const [task] = await issueTasks(f.store, ["audit.runtime-validation"], f.policy);
+  return { ...f, task: task!, manifest };
+}
+
+async function writeRuntimePayload(f: Awaited<ReturnType<typeof issuedRuntimeFixture>>, payload: unknown) {
+  const { writeFile } = await import("node:fs/promises");
+  const path = join(f.artifactsDir, f.task.result_path);
+  const raw = JSON.stringify({ contract_version: "audit-tools-task-result/v1", run_id: f.task.run_id, task_id: f.task.spec.id,
+    attempt: f.task.attempt, binding_sha256: f.task.binding_sha256, outcome: "complete", payload });
+  await writeFile(path, raw);
+  return { path, raw };
+}
+
+const observedRow = (task_id: string, status: "pending" | "confirmed" | "not_confirmed" | "inconclusive" | "not_required" = "confirmed") =>
+  ({ task_id, status, summary: "Fixed synthetic observation, no command executed" });
+
+test.each([
+  { name: "missing", rows: [observedRow("fixed-a")], message: /missing.*fixed-b/i },
+  { name: "extra", rows: [observedRow("fixed-a"), observedRow("fixed-b"), observedRow("foreign")], message: /unexpected.*foreign/i },
+  { name: "duplicate", rows: [observedRow("fixed-a"), observedRow("fixed-b"), observedRow("fixed-a")], message: /duplicate.*fixed-a/i },
+  { name: "pending", rows: [observedRow("fixed-a"), observedRow("fixed-b", "pending")], message: /pending.*fixed-b/i },
+])("actual runtime-update ingress refuses $name evidence without accepting or changing the issued attempt", async ({ rows, message }) => {
+  const { readFile } = await import("node:fs/promises");
+  const { cmdUpdateRuntimeValidation } = await import("../../src/audit/cli/updateRuntimeValidationCommand.js");
+  const root = await mkdtemp(join(tmpdir(), "audit-runtime-contract-"));
+  try {
+    const f = await issuedRuntimeFixture(root);
+    const before = await readFile(join(f.artifactsDir, "run-state.json"), "utf8");
+    const input = await writeRuntimePayload(f, { results: rows });
+    await expect(cmdUpdateRuntimeValidation(["--artifacts-dir", f.artifactsDir, "--updates", input.path])).rejects.toThrow(message);
+    expect(await readFile(join(f.artifactsDir, "run-state.json"), "utf8")).toBe(before);
+    expect(await readFile(input.path, "utf8")).toBe(input.raw);
+    expect((await f.store.read()).tasks[f.task.spec.id]!.status).toBe("issued");
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
+
+test.each(["confirmed", "not_confirmed", "inconclusive", "not_required"] as const)("actual runtime-update ingress retains explicit %s outcomes for every planned task", async status => {
+  const { cmdUpdateRuntimeValidation } = await import("../../src/audit/cli/updateRuntimeValidationCommand.js");
+  const root = await mkdtemp(join(tmpdir(), "audit-runtime-terminal-"));
+  const log = vi.spyOn(console, "log").mockImplementation(() => {});
+  try {
+    const f = await issuedRuntimeFixture(root), payload = { results: f.manifest.tasks.map(task => observedRow(task.id, status)) };
+    const input = await writeRuntimePayload(f, payload);
+    await cmdUpdateRuntimeValidation(["--artifacts-dir", f.artifactsDir, "--updates", input.path]);
+    expect((await f.store.read()).tasks[f.task.spec.id]!.accepted?.outcome).toBe("complete");
+    expect((await readRunContext(f.store)).acceptedPayloads.get(f.task.spec.id)).toEqual(payload);
+    expect(JSON.parse(String(log.mock.calls[0]![0]))).toEqual({ task_id: f.task.spec.id, status: "accepted" });
+  } finally { log.mockRestore(); await rm(root, { recursive: true, force: true }); }
+});
