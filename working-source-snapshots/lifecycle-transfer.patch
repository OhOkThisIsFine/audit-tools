+    await writeFile(join(root,"a.ts"),"changed premise\n");
+    await expect(acceptSubmission(store,path,policy)).rejects.toThrow(/Pinned source changed|changed|integrity/i);
+    expect((await store.read()).tasks[task.spec.id]?.status).toBe("issued");
+  });
+});
