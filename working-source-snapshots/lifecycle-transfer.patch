-      "result_envelope",
-      `result envelope is not ${RESULT_CONTRACT_VERSION} with exactly contract_version, ` +
-        `result_id, run_id, work_item_id, prompt_sha256, file_coverage and findings` +
-        `${hasVerification ? ", and at most one verification object" : ""}`,
