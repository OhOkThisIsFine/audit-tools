+// sites-pinned: tests/audit/accepted-lineage-projection.test.ts, tests/audit/runtime-lifecycle.test.ts
+import { z } from "zod";
+import type { TaskDefinition, TaskSpec, ArtifactRef } from "../../shared/engine/taskLifecycleTypes.js";
+import { RunLogger } from "../../shared/index.js";
+import { RuntimeValidationReportSchema, RuntimeValidationTaskManifestSchema } from "../types/runtimeValidation.js";
+import { createLifecycleIO } from "../../shared/engine/taskLifecycleStore.js";
+import type { ArtifactBundle } from "../io/artifacts.js";
+import { EXECUTOR_RUNNERS } from "../orchestrator/executorRunners.js";
+import { buildSelectiveDeepeningTasks } from "../orchestrator/selectiveDeepening/index.js";
+import { inspectionSpec, projectAuditBundle, projectCompletedInspectionResults, bindAddedInspectionSurfaces, type AuditDomain } from "./auditDomain.js";
+export function runtimeTask(bundle: ArtifactRef, baseTasks: readonly TaskSpec[]): TaskSpec {
+  return { id: "audit.runtime-validation", kind: "audit.runtime-validation", phase: "executing", completion: "complete", subject: {}, inputs: { bundle },
+    depends_on: baseTasks.map(task => ({ task_id: task.id, requires: "completed_required_scope" })) };
+}
+export function runtimeDefinition(): TaskDefinition<AuditDomain> {
+  return { kind: "audit.runtime-validation", phase: "executing", completion: "complete", execution: "deterministic", resultIngress: "bound_host", effect: "read_only",
+    parseSubject: value => z.object({}).strict().parse(value), parsePayload: value => RuntimeValidationReportSchema.parse(value),
+    render: () => "Run the pinned deterministic validation plan; do not modify source or reinterpret the inspection basis.",
+    runDeterministic: async (task, io) => {
+      const source = await io.readArtifact(task.source) as { source_root: string };
+      const bundle = await io.readArtifact(task.inputs.bundle!) as ArtifactBundle;
+      const result = await EXECUTOR_RUNNERS.runtime_validation_executor!(bundle, { options: { root: source.source_root }, log: RunLogger.disabled(), correlationId: task.run_id, obligation: task.spec.id });
+      return { outcome: "complete", payload: result.updated.runtime_validation_report };
+    },
+    validate: async (task, payload, context, submission) => {
+      if (submission.outcome !== "complete") return { errors: ["Runtime observation must be complete; failed assertions are data, not omitted work."] };
+      const report = RuntimeValidationReportSchema.parse(payload);
+      // The immutable assigned input is the manifest authority. Neither a host
+      // report nor a mutable artifact view may narrow or expand planned work.
+      const bundle = await createLifecycleIO(context.state.domain.artifacts_dir).readArtifact(task.inputs.bundle!) as ArtifactBundle;
+      const manifest = RuntimeValidationTaskManifestSchema.parse(bundle.runtime_validation_tasks);
+      const expected = new Set(manifest.tasks.map(item => item.id));
+      const errors: string[] = [];
+      if (expected.size !== manifest.tasks.length) errors.push("Pinned runtime manifest contains duplicate task identities.");
+      const observed = new Set<string>();
+      for (const row of report.results) {
+        if (!expected.has(row.task_id)) errors.push(`Unexpected runtime task: ${row.task_id}`);
+        if (observed.has(row.task_id)) errors.push(`Duplicate runtime task: ${row.task_id}`);
+        observed.add(row.task_id);
+        if (row.status === "pending") errors.push(`Pending runtime observation: ${row.task_id}`);
+      }
+      for (const id of expected) if (!observed.has(id)) errors.push(`Missing runtime observation: ${id}`);
+      return { errors, normalizedPayload: report };
+    },
+    reduce: (task, payload, context) => {
+      const bundle = projectAuditBundle(context);
+      const report = RuntimeValidationReportSchema.parse(payload);
+      const additions = buildSelectiveDeepeningTasks({ existingTasks: bundle.audit_tasks, results: projectCompletedInspectionResults(context), lineIndex: context.state.domain.line_index,
+        runtimeValidationTasks: bundle.runtime_validation_tasks, runtimeValidationReport: report, externalAnalyzerResults: bundle.external_analyzer_results });
+      const addTasks = additions.map(item => inspectionSpec(item, context.state.basis!, [{ task_id: task.spec.id, requires: "accepted_evidence" }]));
+      return { outputs: { report, ...bindAddedInspectionSurfaces(addTasks, task.spec.id) }, addTasks };
+    },
+    requiredScopeComplete: task => task.status === "accepted" && task.accepted?.outcome === "complete",
+  };
+}
