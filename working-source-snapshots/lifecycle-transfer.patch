+++ b/tests/shared/pinned-lifecycle-fault-windows.test.ts
@@ -0,0 +1,55 @@
+/** Plan acceptance-05: logical persistence fault windows, not OS power-loss proof. */
+import { expect, test } from "vitest";
+import { readFile } from "node:fs/promises";
+import { join } from "node:path";
+import { withTempDir } from "./fileLockTestSupport.mjs";
+import { hostSpec, lifecycleFixture, writeSubmission } from "./helpers/taskLifecycleFixture.js";
+import { acceptSubmission, issueTasks } from "../../src/shared/engine/taskLifecycle.js";
+import { createRunStore, readRunContext } from "../../src/shared/engine/taskLifecycleStore.js";
+import type { RunStore } from "../../src/shared/engine/taskLifecycleTypes.js";
+
+const windows = ["before-payload", "after-payload", "before-checkpoint", "after-checkpoint"] as const;
+
+test.each(windows)("golden persistence: %s fault preserves exactly-once accepted evidence", async window => {
+  await withTempDir(async (directory: string) => {
+    const { store, policy } = await lifecycleFixture(directory, [hostSpec("alpha")]);
+    const [task] = await issueTasks(store, ["alpha"], policy);
+    const path = await writeSubmission(store, task!);
+    const submissionBytes = await readFile(join(directory, path), "utf8");
+    const originalAssignment = (await store.read()).tasks.alpha!.issued;
+    let reached = false;
+    const fail = () => { reached = true; throw new Error(`Injected ${window}`); };
+    const crashing: RunStore<{ accepted: number }> = {
+      ...store,
+      io: { ...store.io, writeText: async text => {
+        if (window === "before-payload") fail();
+        const ref = await store.io.writeText(text);
+        if (window === "after-payload") fail();
+        return ref;
+      } },
+      mutate: async fn => {
+        if (window === "before-checkpoint") return store.mutate(async state => { await fn(state); return fail(); });
+        const state = await store.mutate(fn);
+        if (window === "after-checkpoint") fail();
+        return state;
+      },
+    };
+    await expect(acceptSubmission(crashing, path, policy)).rejects.toThrow(`Injected ${window}`);
+    expect(reached).toBe(true);
+    const resumed = createRunStore({ directory, parseDomain: policy.parseDomain });
+    const interrupted = await resumed.read();
+    expect(interrupted.tasks.alpha!.status).toBe(window === "after-checkpoint" ? "accepted" : "issued");
+    expect(interrupted.domain.accepted).toBe(window === "after-checkpoint" ? 1 : 0);
+    expect(interrupted.tasks.alpha!.attempt).toBe(1);
+    expect(interrupted.tasks.alpha!.issued).toEqual(originalAssignment);
+    expect((await acceptSubmission(resumed, path, policy)).status).toBe(window === "after-checkpoint" ? "duplicate" : "accepted");
+    const accepted = await resumed.read(), raw = accepted.tasks.alpha!.accepted!.raw;
+    expect(accepted.domain.accepted).toBe(1);
+    expect(Object.keys(accepted.tasks)).toEqual(["alpha"]);
+    expect(await resumed.io.readText(raw)).toBe(submissionBytes);
+    expect((await readRunContext(resumed)).acceptedPayloads.get("alpha")).toEqual({ files: ["alpha"] });
+    expect((await acceptSubmission(resumed, path, policy)).status).toBe("duplicate");
+    expect(await resumed.read()).toEqual(accepted);
+    expect(await resumed.io.readText(raw)).toBe(submissionBytes);
+  });
+});
