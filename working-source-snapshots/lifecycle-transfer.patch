@@ -0,0 +1,80 @@
+import { test, expect } from "vitest";
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { withTempDir } from "./fileLockTestSupport.mjs";
+import { acceptSubmission, advanceRun, issueTasks, retryTask, setControl } from "../../src/shared/engine/taskLifecycle.js";
+import { LifecycleSubmissionError } from "../../src/shared/engine/taskLifecycleErrors.js";
+import { lifecycleFixture, submissionFor, writeSubmission } from "./helpers/taskLifecycleFixture.js";
+
+test("missing, non-file, malformed UTF8/JSON and invalid envelope have distinct repair diagnostics", async () => {
+  await withTempDir(async (dir: string) => {
+    const { store, policy } = await lifecycleFixture(dir);
+    const [task] = await issueTasks(store, ["alpha"], policy);
+    await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toMatchObject({ code: "submission_missing", check: "result_path", task_id: "alpha", result_path: task!.result_path });
+    // Missing host files are not errors during the ordinary full draw.
+    expect((await advanceRun(store, policy, { draw: "full", maxExecutions: 10 })).stopped).toBe("host");
+    await expect(acceptSubmission(store, "../escape.json", policy)).rejects.toMatchObject({ code: "submission_contract_invalid", check: "result_path" });
+    await mkdir(join(dir, "directory-result"));
+    await expect(acceptSubmission(store, "directory-result", policy)).rejects.toMatchObject({ code: "submission_contract_invalid", check: "result_path" });
+    for (const bytes of [Buffer.from([0xff]), Buffer.from("{broken")]) {
+      await writeFile(join(dir, task!.result_path), bytes);
+      await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toMatchObject({ code: "submission_malformed", check: "result_json", task_id: "alpha", result_path: task!.result_path });
+    }
+    await writeSubmission(store, task!, { contract_version: "unknown" });
+    await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toMatchObject({ code: "submission_contract_invalid", check: "result_envelope", task_id: "alpha" });
+    expect((await store.read()).tasks.alpha!.status).toBe("issued");
+  });
+});
+
+test("domain contract, coverage, binding and source guard failures preserve task/path and original causes", async () => {
+  await withTempDir(async (dir: string) => {
+    const { store, policy } = await lifecycleFixture(dir); const [task] = await issueTasks(store, ["alpha"], policy);
+    const before = await readFile(join(dir, "run-state.json"), "utf8");
+    await writeSubmission(store, task!, { ...submissionFor(task!), payload: { wrong: true } });
+    const invalid = await acceptSubmission(store, task!.result_path, policy).catch(error => error);
+    expect(invalid).toBeInstanceOf(LifecycleSubmissionError);
+    expect(invalid).toMatchObject({ code: "submission_contract_invalid", check: "result_schema", task_id: "alpha", result_path: task!.result_path });
+    expect(invalid.cause).toBeInstanceOf(Error);
+    await writeSubmission(store, task!, { ...submissionFor(task!), payload: { files: ["outside"] } });
+    await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toMatchObject({ code: "result_validation_failed", check: "result_validation", task_id: "alpha" });
+    await writeSubmission(store, task!, { ...submissionFor(task!), binding_sha256: "0".repeat(64) });
+    await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toMatchObject({ code: "submission_contract_invalid", check: "workload_binding" });
+    await writeSubmission(store, task!);
+    policy.acceptanceGuard = async () => ["source moved"];
+    await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toMatchObject({ code: "workload_stale", check: "workload_binding", message: "Acceptance guard failed: source moved" });
+    expect(await readFile(join(dir, "run-state.json"), "utf8")).toBe(before);
+  });
+});
+
+test("paused, superseded and conflicting duplicate diagnostics never alter accepted history", async () => {
+  await withTempDir(async (dir: string) => {
+    const { store, policy } = await lifecycleFixture(dir); const [task] = await issueTasks(store, ["alpha"], policy);
+    await writeSubmission(store, task!); await setControl(store, "paused", "operator review");
+    await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toMatchObject({ code: "run_stopped", task_id: "alpha" });
+    await setControl(store, "active", "review complete");
+    await retryTask(store, "alpha", { expectedAttempt: 1, reason: "known read-only failure", disposition: "failed_without_effect" }, policy);
+    await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toMatchObject({ code: "submission_contract_invalid", check: "identity_binding", task_id: "alpha" });
+    const [current] = await issueTasks(store, ["alpha"], policy); await writeSubmission(store, current!);
+    await acceptSubmission(store, current!.result_path, policy);
+    const before = await readFile(join(dir, "run-state.json"), "utf8");
+    await writeFile(join(dir, current!.result_path), JSON.stringify(submissionFor(current!), null, 2));
+    await expect(acceptSubmission(store, current!.result_path, policy)).rejects.toMatchObject({ code: "duplicate_result", check: "duplicate_result", task_id: "alpha" });
+    expect(await readFile(join(dir, "run-state.json"), "utf8")).toBe(before);
+  });
+});
+
+test("one transport BOM is accepted without changing raw replay identity or downstream artifact readability", async () => {
+  await withTempDir(async (dir: string) => {
+    const { store, policy } = await lifecycleFixture(dir); const [task] = await issueTasks(store, ["alpha"], policy);
+    const text = `\uFEFF${JSON.stringify(submissionFor(task!))}`;
+    await writeFile(join(dir, task!.result_path), `\uFEFF${text}`);
+    await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toMatchObject({ code: "submission_malformed" });
+    await writeFile(join(dir, task!.result_path), text);
+    const accepted = await acceptSubmission(store, task!.result_path, policy);
+    expect(await store.io.readText(accepted.task.accepted!.raw)).toBe(text);
+    expect(await store.io.readArtifact(accepted.task.accepted!.outputs.result!)).toEqual(submissionFor(task!));
+    expect((await acceptSubmission(store, task!.result_path, policy)).status).toBe("duplicate");
+    await writeFile(join(dir, task!.result_path), text.slice(1));
+    await expect(acceptSubmission(store, task!.result_path, policy)).rejects.toMatchObject({ code: "duplicate_result" });
+  });
+});
