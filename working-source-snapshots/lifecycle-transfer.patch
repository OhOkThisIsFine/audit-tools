-    throw new Error(`${taskId}.token_estimate must be a non-negative integer`);
-  }
-  if (!Array.isArray(task.file_paths) || !isRecord(task.file_line_counts)) {
-    throw new Error(`${taskId} must declare file paths and line counts`);
-  }
