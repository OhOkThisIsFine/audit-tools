+// sites-pinned: tests/shared/task-lifecycle.test.ts, tests/shared/task-lifecycle-store.test.ts
+/** Shared task lifecycle contract. Domain policies validate facts, never own attempts or acceptance. */
+export type RunPhase = "preparing" | "executing" | "finalizing" | "complete";
+export type RunMode = "audit" | "remediate";
+export type RunControl = "active" | "paused" | "cancelled";
+export interface ArtifactRef { path: string; sha256: string }
+export interface TaskOutputRef { task_id: string; output: string }
+export interface TaskDependency {
+  task_id: string;
+  requires: "accepted_evidence" | "completed_required_scope";
+}
+export interface TaskSpec {
+  id: string;
+  kind: string;
+  phase: Exclude<RunPhase, "complete">;
+  depends_on: TaskDependency[];
+  inputs: Record<string, ArtifactRef | TaskOutputRef>;
+  subject: unknown;
+  completion: "complete" | "selective";
+  /** Policy-computed stable order, pinned with the spec; ties use task identity. */
+  order?: number;
+  /** Optional work must be explicitly marked; all other tasks block phase completion. */
+  required?: boolean;
+}
+export interface TaskIssue {
+  /** Basis at issuance, absent for preparation; later pinning cannot rewrite old bindings. */
+  basis?: ArtifactRef;
+  inputs: Record<string, ArtifactRef>;
+  prompt: ArtifactRef;
+  prompt_body_sha256: string;
+  binding_sha256: string;
+  result_path: string;
+}
+export interface TaskRetryReceipt {
+  from_attempt: number;
+  to_attempt: number;
+  reason: string;
+  disposition: RetryRequest["disposition"];
+  /** Prior binding and evidence remain owned by this checkpoint, never an orphaned prompt. */
+  issued: TaskIssue;
+}
+export interface TaskRecord {
+  spec: TaskSpec;
+  status: "pending" | "issued" | "accepted" | "blocked";
+  attempt: number;
+  issued?: TaskIssue;
+  /** Append-only coordinator retry decisions; absent on historical records without receipts. */
+  retry_history?: TaskRetryReceipt[];
+  accepted?: {
+    /** Immutable canonical submission envelope, including its original outcome. */
+    raw: ArtifactRef;
+    outcome: "complete" | "partial" | "blocked";
+    normalized?: ArtifactRef;
+    /** `result` is the whole submission; other outputs require an explicit domain projector. */
+    outputs: Record<string, ArtifactRef>;
+  };
+  blocker?: { code: string; detail: string };
+}
+export interface RunState<Domain> {
+  contract_version: "audit-tools-run/v1";
+  run_id: string;
+  mode: RunMode;
+  phase: RunPhase;
+  control: RunControl;
+  control_reason?: string;
+  source: ArtifactRef;
+  basis?: ArtifactRef;
+  tasks: Record<string, TaskRecord>;
+  domain: Domain;
+  deliverables?: Record<string, ArtifactRef>;
+}
+export interface TaskSubmission {
+  contract_version: "audit-tools-task-result/v1";
+  run_id: string;
+  task_id: string;
+  attempt: number;
+  binding_sha256: string;
+  outcome: "complete" | "partial" | "blocked";
+  payload: unknown;
+}
+export interface TaskAssignment {
+  run_id: string;
+  mode: RunMode;
+  source: ArtifactRef;
+  basis?: ArtifactRef;
+  spec: TaskSpec;
+  attempt: number;
+  inputs: Record<string, ArtifactRef>;
+  result_path: string;
+}
+export interface IssuedTask extends TaskAssignment {
+  prompt: ArtifactRef;
+  prompt_body_sha256: string;
+  binding_sha256: string;
+}
+export interface ReadContext<Domain> {
+  state: Readonly<RunState<Domain>>;
+  /** Payloads read only from verified immutable coordinator-owned submissions. */
+  acceptedPayloads: ReadonlyMap<string, unknown>;
+  acceptedSubmissions: ReadonlyMap<string, TaskSubmission>;
+}
+export interface LifecycleIO {
+  directory: string;
+  readArtifact(ref: ArtifactRef): Promise<unknown>;
+  readText(ref: ArtifactRef): Promise<string>;
+  writeArtifact(value: unknown): Promise<ArtifactRef>;
+  writeText(value: string): Promise<ArtifactRef>;
+}
+export interface TransitionControl {
+  state: "paused" | "cancelled";
+  reason: string;
+}
+export interface DomainTransition<Domain> {
+  domain?: Domain;
+  addTasks?: TaskSpec[];
+  /** Stop issuance atomically with acceptance, not in a later wrapper call. */
+  control?: TransitionControl;
+  /** Explicit, whole projected outputs. The reserved `result` name cannot be overridden. */
+  outputs?: Record<string, unknown>;
+}
+export interface ValidationResult {
+  errors: string[];
+  /** Optional tool-derived enrichment; raw host bytes remain immutable. */
+  normalizedPayload?: unknown;
+  /** Domain-specific read-only observation, rechecked by acceptanceGuard under the lock. */
+  observation?: unknown;
+}
+export interface TaskDefinition<Domain, Payload = unknown> {
+  kind: string;
+  phase: Exclude<RunPhase, "complete">;
+  completion: "complete" | "selective";
+  execution: "deterministic" | "host";
+  /** Policy-owned ingress. Defaults: host execution admits bound_host; deterministic is coordinator_only. */
+  resultIngress?: "coordinator_only" | "bound_host";
+  effect: "read_only" | "external_write";
+  /** Assign the same key to mutually exclusive host effects, such as target-tree landing. */
+  exclusive?: string;
+  parseSubject(value: unknown): unknown;
+  parsePayload(value: unknown): Payload;
+  render(task: TaskAssignment, context: ReadContext<Domain>): string;
+  runDeterministic?: (task: IssuedTask, io: LifecycleIO) => Promise<{ outcome: TaskSubmission["outcome"]; payload: unknown }>;
+  validate(task: IssuedTask, payload: Payload, context: ReadContext<Domain>, submission: Readonly<TaskSubmission>): Promise<ValidationResult>;
+  reduce(task: IssuedTask, payload: Payload, context: ReadContext<Domain>): DomainTransition<Domain>;
+  /** Pure domain projection, e.g. verified parent + residual coverage. No completion ledger. */
+  requiredScopeComplete(task: TaskRecord, context: ReadContext<Domain>): boolean;
+}
+export interface PhaseTransition<Domain> {
+  phase: RunPhase;
+  /** E.g. plan-only pins preparation and pauses before any fine task can issue. */
+  control?: TransitionControl;
+  basis?: ArtifactRef;
+  domain?: Domain;
+  addTasks?: TaskSpec[];
+  deliverables?: Record<string, ArtifactRef>;
+}
+export interface RetryRequest {
+  expectedAttempt: number;
+  reason: string;
+  disposition: "abandoned" | "failed_without_effect" | "reconciled_no_effect";
+}
+export interface DrawPolicy<Domain> {
+  definitions: ReadonlyMap<string, TaskDefinition<Domain>>;
+  parseDomain(value: unknown): Domain;
+  initialTasks(source: ArtifactRef, domain: Domain): TaskSpec[];
+  phaseTransition(context: ReadContext<Domain>, io: LifecycleIO): Promise<PhaseTransition<Domain> | null>;
+  acceptanceGuard(task: IssuedTask, observation: ValidationResult, context: ReadContext<Domain>, io: LifecycleIO): Promise<string[]>;
+  /** Required before any external-write attempt can be retried; must corroborate actual effect absence. */
+  retryGuard?: (task: IssuedTask, request: RetryRequest, context: ReadContext<Domain>, io: LifecycleIO) => Promise<string[]>;
+}
+export interface RunStore<Domain> {
+  io: LifecycleIO;
+  read(): Promise<RunState<Domain>>;
+  /** Coordinator transaction; never expose this to host workers. */
+  mutate(fn: (state: RunState<Domain>) => Promise<RunState<Domain>>): Promise<RunState<Domain>>;
+}
+export interface AcceptOutcome<Domain> {
+  status: "accepted" | "duplicate";
+  state: RunState<Domain>;
+  task: TaskRecord;
+}
+export interface LifecycleStep<Domain> {
+  state: RunState<Domain>;
+  tasks: IssuedTask[];
+  stopped: "host" | "budget" | "blocked" | "paused" | "cancelled" | "complete";
+  executions: number;
+}
