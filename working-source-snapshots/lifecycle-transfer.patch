+test.each([1, 2, 3])("snapshot cleanup propagates ownership loss at destructive checkpoint %i", async (failAt) => {
+  await withTempDir("cleanup-snapshot-loss-", async (root) => {
+    const previousState = process.env.AUDIT_CODE_STATE_DIR;
+    process.env.AUDIT_CODE_STATE_DIR = join(root, "state");
+    try {
+      const dir = await legacy(root);
+      const { tree } = await snapshotFixture(root, dir);
+      const loss = new FileLockOwnershipLostError(artifactTreeLockPath(dir));
+      let assertions = 0;
+      await expect(removeRunSnapshot(dir, root, async () => {
+        if (++assertions === failAt) throw loss;
+      })).rejects.toBe(loss);
+      expect(assertions).toBe(failAt);
+      expect(await readFile(runSnapshotPath(dir), "utf8")).toContain("audit-run-snapshot/v1");
+      if (failAt < 3) expect(await readFile(join(tree, "source.txt"), "utf8")).toBe("frozen source");
+      if (failAt === 1) expect(await realpath(join(tree, "dependency"))).toBe(await realpath(root));
+    } finally { process.env.AUDIT_CODE_STATE_DIR = previousState; }
+  });
+});
+
+test("--force never converts snapshot hold loss into permission to delete the tree", async () => {
+  await withTempDir("cleanup-forced-loss-", async (root) => {
+    const previousState = process.env.AUDIT_CODE_STATE_DIR;
+    process.env.AUDIT_CODE_STATE_DIR = join(root, "state");
+    try {
+      const dir = await legacy(root);
+      const { snapshotDir, tree } = await snapshotFixture(root, dir);
+      // Deliberate fault injection, not a claim that supported peers replace tokens.
+      boundary.beforeReadDir = async (path) => {
+        if (path === snapshotDir) await writeFile(artifactTreeLockPath(dir), "replacement-owner");
+      };
+      await expect(cleanupStaleArtifactsDir(dir, { force: true, repositoryRoot: root })).rejects.toBeInstanceOf(FileLockOwnershipLostError);
+      expect(await readFile(artifactTreeLockPath(dir), "utf8")).toBe("replacement-owner");
+      expect(await readFile(join(dir, "evidence.txt"), "utf8")).toBe("legacy evidence");
+      expect(await readFile(join(tree, "source.txt"), "utf8")).toBe("frozen source");
+      expect(await readFile(runSnapshotPath(dir), "utf8")).toContain("audit-run-snapshot/v1");
+    } finally { boundary.beforeReadDir = undefined; process.env.AUDIT_CODE_STATE_DIR = previousState; }
+  });
+});
