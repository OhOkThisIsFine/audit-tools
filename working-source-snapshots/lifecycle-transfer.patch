-type AnalyzerConsentBranchResult =
-  | { action: "continue" }
-  | { action: "return"; result: { kind: "analyzer_consent"; state: AuditState; bundle: ArtifactBundle; pending: ExternalAnalyzerCandidate[] } }
-  | { action: "fallthrough" };
