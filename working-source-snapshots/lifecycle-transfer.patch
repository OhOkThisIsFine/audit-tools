+// sites-pinned: tests/shared/task-lifecycle.test.ts, tests/shared/ordered-reachability.test.ts
+import { hashContent } from "../hash.js";
+import { stableStringify } from "../stableStringify.js";
+import { compareCodeUnits } from "../compareCodeUnits.js";
+import { workerPromptBindingHolds } from "../submission/workerPromptBinding.js";
+import { TaskSpecSchema } from "./taskLifecycleSchema.js";
+import type { DrawPolicy, IssuedTask, ReadContext, RunState, TaskAssignment, TaskDefinition, TaskRecord, TaskSpec, TaskSubmission } from "./taskLifecycleTypes.js";
+
+export const phaseOrder = ["preparing", "executing", "finalizing", "complete"] as const;
+export function equal(left: unknown, right: unknown): boolean { return stableStringify(left) === stableStringify(right); }
+export function frozen<T>(value: T): T {
+  if (value !== null && typeof value === "object" && !Object.isFrozen(value)) {
+    for (const child of Object.values(value)) frozen(child);
+    Object.freeze(value);
+  }
+  return value;
+}
+export function definitionFor<Domain>(policy: DrawPolicy<Domain>, task: TaskSpec): TaskDefinition<Domain> {
+  const definition = policy.definitions.get(task.kind);
+  if (!definition || definition.kind !== task.kind) throw new Error(`Unknown task kind ${task.kind}`);
+  if (definition.phase !== task.phase || definition.completion !== task.completion) throw new Error(`Task ${task.id} does not match its kind's phase/completion contract`);
+  if (!equal(definition.parseSubject(task.subject), task.subject)) throw new Error(`Task ${task.id} subject must already be canonical`);
+  if (definition.execution === "deterministic" && definition.effect !== "read_only") throw new Error(`External-write task ${task.id} must be host-owned`);
+  return definition;
+}
+export function validateGraph<Domain>(state: RunState<Domain>, policy: DrawPolicy<Domain>): void {
+  for (const [id, task] of Object.entries(state.tasks)) {
+    TaskSpecSchema.parse(task.spec);
+    if (id !== task.spec.id) throw new Error(`Task key mismatch: ${id}`);
+    definitionFor(policy, task.spec);
+    const deps = new Set<string>();
+    for (const dep of task.spec.depends_on) {
+      if (!Object.hasOwn(state.tasks, dep.task_id)) throw new Error(`Missing dependency ${dep.task_id} for ${id}`);
+      if (deps.has(dep.task_id)) throw new Error(`Duplicate dependency ${dep.task_id} for ${id}`);
+      deps.add(dep.task_id);
+      if (phaseOrder.indexOf(state.tasks[dep.task_id]!.spec.phase) > phaseOrder.indexOf(task.spec.phase)) throw new Error(`Task ${id} depends on a later phase`);
+    }
+    for (const ref of Object.values(task.spec.inputs)) if ("task_id" in ref && !deps.has(ref.task_id)) throw new Error(`Task output input ${ref.task_id} requires an explicit dependency for ${id}`);
+  }
+  const visiting = new Set<string>(); const visited = new Set<string>();
+  const visit = (id: string): void => {
+    if (visiting.has(id)) throw new Error(`Task dependency cycle at ${id}`);
+    if (visited.has(id)) return;
+    visiting.add(id);
+    for (const dep of state.tasks[id]!.spec.depends_on) visit(dep.task_id);
+    visiting.delete(id); visited.add(id);
+  };
+  for (const id of Object.keys(state.tasks)) visit(id);
+}
+export function addTasks<Domain>(state: RunState<Domain>, specs: TaskSpec[], policy: DrawPolicy<Domain>): void {
+  for (const candidate of specs) {
+    const spec = TaskSpecSchema.parse(candidate) as TaskSpec;
+    definitionFor(policy, spec);
+    if (phaseOrder.indexOf(spec.phase) < phaseOrder.indexOf(state.phase)) throw new Error(`Cannot add task ${spec.id} to a closed phase`);
+    const existing = state.tasks[spec.id];
+    if (existing) {
+      if (!equal(existing.spec, spec)) throw new Error(`Conflicting immutable task ${spec.id}`);
+      continue;
+    }
+    state.tasks[spec.id] = { spec: structuredClone(spec), status: "pending", attempt: 0 };
+  }
+  validateGraph(state, policy);
+}
+export function taskAssignment<Domain>(state: RunState<Domain>, task: TaskRecord): IssuedTask {
+  if (!task.issued) throw new Error(`Task ${task.spec.id} is not issued`);
+  return {
+    run_id: state.run_id, mode: state.mode, source: state.source,
+    spec: task.spec, attempt: task.attempt, ...task.issued,
+  };
+}
+export function assignmentBinding(task: TaskAssignment, promptBodySha256: string): string {
+  return hashContent(stableStringify({ contract_version: "audit-tools-task-binding/v1", ...task, prompt_body_sha256: promptBodySha256 }));
+}
+export function submissionTail(task: TaskAssignment, binding: string): string {
+  const template: TaskSubmission = {
+    contract_version: "audit-tools-task-result/v1", run_id: task.run_id, task_id: task.spec.id,
+    attempt: task.attempt, binding_sha256: binding, outcome: "complete", payload: {},
+  };
+  return `Write one JSON result at ${task.result_path}, relative to the result-path base directory above. If you cannot write files, return the complete JSON object as your final message instead; the dispatching host must write it verbatim to that exact path. Keep all identity fields exactly as given. Put the domain result in payload; outcome must honestly be complete, partial, or blocked.\n\n${JSON.stringify(template, null, 2)}`;
+}
+export function bindingHolds(task: IssuedTask, prompt: string): boolean {
+  const { prompt: _prompt, prompt_body_sha256, binding_sha256, ...assignment } = task;
+  return assignmentBinding(assignment, prompt_body_sha256) === binding_sha256 && workerPromptBindingHolds({ text: prompt, sha256: prompt_body_sha256 }, () => submissionTail(assignment, binding_sha256));
+}
+export function isScopeComplete<Domain>(task: TaskRecord, context: ReadContext<Domain>, policy: DrawPolicy<Domain>): boolean {
+  if (!task.accepted) return false;
+  return definitionFor(policy, task.spec).requiredScopeComplete(task, context);
+}
+export function sortedTasks<Domain>(state: RunState<Domain>): TaskRecord[] {
+  return Object.values(state.tasks).sort((a, b) => (a.spec.order ?? 0) - (b.spec.order ?? 0) || compareCodeUnits(a.spec.id, b.spec.id));
+}
