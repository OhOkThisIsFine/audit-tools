diff --git a/tests/shared/analyzer-owned-report-read.test.ts b/tests/shared/analyzer-owned-report-read.test.ts
new file mode 100644
index 00000000..2d18d53e
--- /dev/null
+++ b/tests/shared/analyzer-owned-report-read.test.ts
@@ -0,0 +1,87 @@
+import { afterEach, expect, test, vi } from "vitest";
+import * as fs from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import type { RepositorySourceOptions } from "../../src/shared/io/repositorySource.js";
+import { jscpdCandidate } from "../../src/shared/analyzers/candidates.js";
+import { runExternalAnalyzer } from "../../src/shared/analyzers/acquisitionEngine.js";
+
+// Inject only descriptor operations into the real bounded reader, never text or
+// authorization. The actual acquisition consumer must select and use the reader.
+const hooks = vi.hoisted(() => ({ filesystem: undefined as RepositorySourceOptions["filesystem"] }));
+vi.mock("../../src/shared/io/repositorySource.js", async original => {
+  const actual = await original<typeof import("../../src/shared/io/repositorySource.js")>();
+  return { ...actual, readRepositorySourceSync: (root: string, path: string, options?: RepositorySourceOptions) =>
+    actual.readRepositorySourceSync(root, path, { ...options, filesystem: hooks.filesystem }) };
+});
+afterEach(() => { hooks.filesystem = undefined; });
+const maxReportBytes = 10 * 1024 * 1024;
+const body = '{"duplicates":[]}';
+const ok = (argv: string[]) => ({ argv, status: 0, stdout: "", stderr: "", duration_ms: 1 });
+
+async function fixture(prepare: (directory: string, report: string) => void) {
+  const root = fs.mkdtempSync(join(tmpdir(), "owned-report-bound-"));
+  fs.writeFileSync(join(root, "package.json"), "{}");
+  let directory = "";
+  const parse = vi.fn(jscpdCandidate.parse);
+  try {
+    const outcome = await runExternalAnalyzer({ ...jscpdCandidate, parse }, root, {
+      consentToken: { value: "fixture", tools: ["jscpd"] },
+      run: async argv => {
+        if (argv.includes("--version")) return ok(argv);
+        directory = argv[argv.indexOf("--output") + 1];
+        prepare(directory, join(directory, "jscpd-report.json"));
+        return ok(argv);
+      },
+    });
+    return { outcome, parse, directory };
+  } finally { fs.rmSync(root, { recursive: true, force: true }); }
+}
+
+test.each([maxReportBytes - 1, maxReportBytes])("real jscpd consumer accepts bounded report of %i bytes", async size => {
+  const { outcome, parse, directory } = await fixture((_dir, path) => fs.writeFileSync(path, body.padEnd(size)));
+  expect(outcome.status.status).toBe("success");
+  expect(parse).toHaveBeenCalledOnce();
+  expect(fs.existsSync(directory)).toBe(false);
+});
+
+test.each(["oversized", "nonregular", "replaced-before-open"] as const)("real jscpd consumer refuses %s report before parsing", async kind => {
+  const read = vi.fn((fd: number, buffer: Buffer, length: number, position: number) => fs.readSync(fd, buffer, 0, length, position));
+  const close = vi.fn(fs.closeSync);
+  const { outcome, parse, directory } = await fixture((_dir, path) => {
+    if (kind === "nonregular") fs.mkdirSync(path);
+    else fs.writeFileSync(path, kind === "oversized" ? body.padEnd(maxReportBytes + 1) : body);
+    hooks.filesystem = { close, read,
+      ...(kind === "replaced-before-open" ? { open: (name: string, flags: number) => {
+        fs.renameSync(path, `${path}.old`); fs.writeFileSync(path, body);
+        return fs.openSync(name, flags);
+      } } : {}) };
+  });
+  expect(outcome.status.status).toBe("parse_error");
+  expect(outcome.results.results).toEqual([]);
+  expect(parse).not.toHaveBeenCalled();
+  expect(read).not.toHaveBeenCalled();
+  if (kind === "replaced-before-open") expect(close).toHaveBeenCalledOnce();
+  expect(fs.existsSync(directory)).toBe(false);
+});
+
+test.each(["directory", "junction"] as const)("replaced invocation %s is refused and never cleaned as owned", async kind => {
+  let moved = "", replacement = "", outside = "";
+  try {
+    const { outcome, parse } = await fixture((directory, path) => {
+      moved = `${directory}-original`; replacement = directory;
+      fs.renameSync(directory, moved);
+      if (kind === "junction") {
+        outside = `${directory}-outside`; fs.mkdirSync(outside);
+        fs.symlinkSync(outside, directory, process.platform === "win32" ? "junction" : "dir");
+      } else fs.mkdirSync(directory);
+      fs.writeFileSync(path, body); fs.writeFileSync(join(directory, "replacement-owner"), "preserve");
+    });
+    expect(outcome.status.status).toBe("parse_error");
+    expect(parse).not.toHaveBeenCalled();
+    expect(fs.readFileSync(join(replacement, "replacement-owner"), "utf8")).toBe("preserve");
+    expect(fs.existsSync(moved)).toBe(true);
+  } finally {
+    for (const path of [moved, replacement, outside]) if (path) fs.rmSync(path, { recursive: true, force: true });
+  }
+});
