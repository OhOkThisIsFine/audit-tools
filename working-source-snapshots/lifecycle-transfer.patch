+import { afterEach, expect, test } from "vitest";
+import { mkdtemp, rm, writeFile, mkdir } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { hashContent } from "../../src/shared/hash.js";
+import { createRunState, issueTasks, readyTasks, acceptSubmission, advanceRun } from "../../src/shared/engine/taskLifecycle.js";
+import { createLifecycleIO, createRunStore, readRunContext } from "../../src/shared/engine/taskLifecycleStore.js";
+import type { DrawPolicy, IssuedTask } from "../../src/shared/engine/taskLifecycleTypes.js";
+import { createPlanningDefinitions, initialPlanningState, initialPlanningTasks, approvedPlanning, parsePlanningState, planningAcceptanceGuard, type PlanningDomain } from "../../src/remediate/contractPipeline/planningLifecycle.js";
+import { readApprovedExecutionPlan, readCanonicalPlan } from "../../src/remediate/contractPipeline/executionPlanReader.js";
+
+const roots: string[] = [];
+afterEach(async () => { await Promise.all(roots.splice(0).map(root => rm(root, { recursive: true, force: true }))); });
+async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "planning-lifecycle-")); roots.push(root);
+  const directory = join(root, "artifacts"); await mkdir(directory);
+  const input = join(root, "request.txt"); await writeFile(input, "Add greeting");
+  const source = { plan_id: "plan-test", findings: [], audit_read: null, sources: [{ path: input, sha256: hashContent("Add greeting") }], request: { id: "request-test", text: "Add greeting", source_paths: [input] } };
+  const io = createLifecycleIO(directory);
+  const sourceRef = await io.writeArtifact(source);
+  const policy: DrawPolicy<PlanningDomain> = {
+    definitions: createPlanningDefinitions({ root }),
+    parseDomain: value => ({ planning: parsePlanningState((value as PlanningDomain).planning) }),
+    initialTasks: initialPlanningTasks,
+    phaseTransition: async () => null,
+    acceptanceGuard: async (_task, observation) => planningAcceptanceGuard(root, observation.observation),
+  };
+  const domain = { planning: initialPlanningState(source, "independent") };
+  const initialState = createRunState({ run_id: "planning-run", mode: "remediate", source: sourceRef, domain }, policy);
+  const store = createRunStore({ directory, checkpointPath: "state.json", initialState, parseDomain: policy.parseDomain });
+  const plan = { plan_id: source.plan_id, objective: "Add greeting", non_goals: [], source_dispositions: [],
+    requirements: [{ id: "REQ-greeting", description: "Return greeting", source_finding_ids: [], change_kind: "addition", assertions: [{ kind: "positive", description: "Returns hello", scope_paths: ["greeting.ts"] }] }],
+    units: [{ id: "UNIT-greeting", title: "Implement greeting", description: "Implement and test greeting", source_finding_ids: [], requirement_ids: ["REQ-greeting"], dependencies: [], read_paths: ["request.txt"], allowed_files: ["greeting.ts"], required_tests: ["node --test"], affected_interfaces: [], addresses_counterexample_ids: [] }],
+  };
+  const next = async () => {
+    const ready = readyTasks(await readRunContext(store), policy);
+    expect(ready).toHaveLength(1);
+    return (await issueTasks(store, [ready[0]!.id], policy))[0]!;
+  };
+  const submit = async (task: IssuedTask, payload: unknown, outcome: "complete" | "partial" = "complete") => {
+    await writeFile(join(directory, task.result_path), JSON.stringify({ contract_version: "audit-tools-task-result/v1", run_id: task.run_id, task_id: task.spec.id, attempt: task.attempt, binding_sha256: task.binding_sha256, outcome, payload }));
+    return acceptSubmission(store, task.result_path, policy);
+  };
+  const author = async () => { const task = await next(); await submit(task, { base_revision_sha256: null, plan, retired_requirements: [] }); return task; };
+  const owner = async () => { const task = await next(); await submit(task, { revision_sha256: (await store.read()).domain.planning.canonical!.revision_sha256, confirmed_by: "host", approved_unit_ids: ["UNIT-greeting"], declined_units: [], deferred_findings: [] }); };
+  return { root, directory, input, policy, store, plan, next, submit, author, owner };
+}
+const independent = (result: unknown) => ({ review: { mode: "independent", reason: "Separate fixture review context" }, result });
+const judgeResult = (classifications: unknown[] = []) => ({ verdict: "approved", classifications, requirement_assessments: [{ requirement_id: "REQ-greeting", verdict: "satisfied", evidence: ["Checked scoped assertion"] }], disposition_assessments: [] });
+
+test("shared accepted author, owner, critique, critic and judge alone authorize immutable plan", async () => {
+  const f = await fixture(); const author = await f.author();
+  await writeFile(join(f.directory, "approval.json"), JSON.stringify({ approved: true }));
+  expect(await readApprovedExecutionPlan(f.directory)).toBeUndefined();
+  await f.owner();
+  await f.submit(await f.next(), independent({ verdict: "approved", issues: [] }));
+  await f.submit(await f.next(), independent({ counterexamples: [] }));
+  const judge = await f.next(); await f.submit(judge, independent(judgeResult()));
+  const approved = approvedPlanning(await readRunContext(f.store));
+  expect(approved?.approvedTaskId).toBe(judge.spec.id);
+  expect(approved?.canonical.plan).toEqual(f.plan);
+  expect(await readCanonicalPlan(f.directory)).toEqual(approved?.canonical);
+  expect((await readApprovedExecutionPlan(f.directory))?.canonical).toEqual(approved?.canonical);
+  expect((await acceptSubmission(f.store, judge.result_path, f.policy)).status).toBe("duplicate");
+  await expect(f.submit(author, { base_revision_sha256: null, plan: { ...f.plan, objective: "Changed" } })).rejects.toThrow(/Conflicting duplicate/);
+  expect(approvedPlanning(await readRunContext(f.store))?.canonical).toEqual(approved?.canonical);
+});
+
+test("coherent plan cannot accept partial scope or widened forbidden context", async () => {
+  const f = await fixture(); const task = await f.next();
+  await expect(f.submit(task, { base_revision_sha256: null, plan: f.plan }, "partial")).rejects.toThrow(/coherent complete/);
+  await expect(f.submit(task, { base_revision_sha256: null, plan: { ...f.plan, units: [{ ...f.plan.units[0], allowed_files: ["../escape.ts"] }] } })).rejects.toThrow(/escapes|outside|repository|beneath/);
+  expect((await f.store.read()).domain.planning.canonical).toBeUndefined();
+});
+
+test("independence, missing entity and changed context fail before shared acceptance", async () => {
+  const f = await fixture(); await f.author(); await f.owner(); const critique = await f.next();
+  await expect(f.submit(critique, { review: { mode: "degraded", reason: "Same context" }, result: { verdict: "approved", issues: [] } })).rejects.toThrow(/independent/);
+  await expect(f.submit(critique, independent({ verdict: "approved", issues: [{ id: "I", description: "Unknown requirement", requirement_ids: ["REQ-missing"], unit_ids: [], blocking: false }] }))).rejects.toThrow(/missing plan entities/);
+  await writeFile(join(f.root, "greeting.ts"), "changed before approval");
+  await expect(f.submit(critique, independent({ verdict: "approved", issues: [] }))).rejects.toThrow(/context changed/);
+});
+
+test("judge residual classification cannot stand in for operator risk acceptance", async () => {
+  const f = await fixture(); await f.author(); await f.owner();
+  await f.submit(await f.next(), independent({ verdict: "approved", issues: [] }));
+  await f.submit(await f.next(), independent({ counterexamples: [{ id: "C1", claim: "Greeting is English only", reproduction_steps: ["Read greeting"], expected: "Localized", actual: "English", requirement_ids: ["REQ-greeting"], unit_ids: ["UNIT-greeting"] }] }));
+  await f.submit(await f.next(), independent(judgeResult([{ counterexample_id: "C1", classification: "residual_risk", rationale: "Owner decision" }])));
+  expect(approvedPlanning(await readRunContext(f.store))).toBeUndefined();
+  const risk = await f.next(); const revision = (await f.store.read()).domain.planning.canonical!.revision_sha256;
+  await expect(f.submit(risk, { revision_sha256: revision, confirmed_by: "host", accepted_counterexample_ids: [] })).rejects.toThrow(/exactly/);
+  await f.submit(risk, { revision_sha256: revision, confirmed_by: "host", accepted_counterexample_ids: ["C1"] });
+  expect(approvedPlanning(await readRunContext(f.store))?.approvedTaskId).toBe(risk.spec.id);
+});
+
+test("repair accepts a new author task while preserving all accepted prior evidence", async () => {
+  const f = await fixture(); await f.author(); await f.owner();
+  const old = await f.store.read(); const before = structuredClone(old.tasks);
+  await f.submit(await f.next(), independent({ verdict: "needs_repair", issues: [{ id: "I1", description: "Simplify objective", requirement_ids: [], unit_ids: [], blocking: true }] }));
+  const revision = (await f.store.read()).domain.planning.canonical!.revision_sha256;
+  const task = await f.next(); expect(task.spec.id).toMatch(/\.1.author$/);
+  await expect(f.submit(task, { base_revision_sha256: null, plan: f.plan })).rejects.toThrow(/stale/);
+  await f.submit(task, { base_revision_sha256: revision, plan: { ...f.plan, objective: "A simpler greeting" } });
+  const after = await f.store.read();
+  for (const [id, record] of Object.entries(before)) if (record.status === "accepted") expect(after.tasks[id]).toEqual(record);
+  expect(after.domain.planning.canonical!.plan.objective).toBe("A simpler greeting");
+  expect(approvedPlanning(await readRunContext(f.store))).toBeUndefined();
+});
+
+test("judge must cover exact requirements, including after unavailable review", async () => {
+  const f = await fixture(); await f.author(); await f.owner();
+  await f.submit(await f.next(), independent({ verdict: "approved", issues: [] }));
+  await f.submit(await f.next(), independent({ counterexamples: [] }));
+  const judge = await f.next();
+  await expect(f.submit(judge, { review: { mode: "unavailable", reason: "No independent context" }, result: judgeResult() })).rejects.toThrow(/unavailable/);
+  await expect(f.submit(judge, independent({ ...judgeResult(), requirement_assessments: [] }))).rejects.toThrow(/every requirement/);
+  expect(approvedPlanning(await readRunContext(f.store))).toBeUndefined();
+});
+
+test("eight automatic repair decisions cannot silently start an unbounded review loop", async () => {
+  const f = await fixture(); await f.author();
+  for (let round = 0; round <= 8; round++) {
+    await f.owner();
+    await f.submit(await f.next(), independent({ verdict: "needs_repair", issues: [] }));
+    const task = await f.next(); const canonical = (await f.store.read()).domain.planning.canonical!;
+    const submission = { base_revision_sha256: canonical.revision_sha256, plan: { ...f.plan, objective: `Repair ${round + 1}` } };
+    if (round < 8) await f.submit(task, submission);
+    else {
+      expect(task.spec.kind).toBe("remediation.plan.repair_bound");
+      expect((await advanceRun(f.store, f.policy, { draw: "full", maxExecutions: 2 })).stopped).toBe("blocked");
+    }
+  }
+  expect((await f.store.read()).phase).toBe("preparing");
+  expect(approvedPlanning(await readRunContext(f.store))).toBeUndefined();
+});
+
+
+test("pure intake risk classifier cannot be weakened by a requested light review", () => {
+  const source = { plan_id: "plan-risk", findings: [], audit_read: null, sources: [], request: { id: "request-risk", text: "Fix concurrent scheduler race and data loss", source_paths: [] } };
+  expect(initialPlanningState(source, "degraded_allowed").reviewRequirement).toBe("independent");
+  expect(initialPlanningState({ ...source, request: { ...source.request, text: "Add greeting documentation" } }).reviewRequirement).toBe("degraded_allowed");
+});
