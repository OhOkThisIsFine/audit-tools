-export async function handleCharterExtractionBranch(
-  params: Pick<NextStepParams, "root" | "sourceRoot" | "artifactsDir" | "scopeIndexMemo">,
-  bundle: ArtifactBundle,
-  state: AuditState,
-  tx: FoldTransaction,
