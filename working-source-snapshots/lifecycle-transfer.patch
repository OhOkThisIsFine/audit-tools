+
+export async function drawAuditRun(store: RunStore<AuditDomain>, draw: "full" | "deterministic", maxExecutions = 128, deadline?: { at: number }): Promise<LifecycleStep<AuditDomain>> {
+  const before = await store.read();
+  if (before.domain.preparation.repo_manifest) {
+    const integrity = await checkFileIntegrity(before.domain.source_root, before.domain.preparation.repo_manifest);
