-      kind: "rejected",
-      issueCode: incoming.issueCode ?? "submission_malformed",
-      message: incoming.reason + quarantineSurvivalNote(quarantine),
-    });
-    return {
-      status: "quarantined",
-      quarantinePath: quarantine.quarantinePath,
-      reason: incoming.reason,
-    };
