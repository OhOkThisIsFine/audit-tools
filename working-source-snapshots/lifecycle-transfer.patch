+import { test, expect, vi } from "vitest";
+import { mkdtemp, mkdir, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { cmdNextStep } from "../../src/audit/cli/nextStepCommand.js";
+import * as auditSteps from "../../src/audit/cli/steps.js";
+import * as stepContractWriter from "../../src/shared/io/stepContractWriter.js";
+import { fixedAuditFlowRun } from "../audit/helpers/lifecycleFixture.js";
+import { finalizationRun } from "../audit/helpers/finalizationLifecycleFixture.js";
+import { readyCliPreflight } from "../audit/helpers/cliLifecycleFixture.js";
+import { drawAuditRun } from "../../src/audit/lifecycle/auditRun.js";
+
+test.each(["preflight", "host", "complete"] as const)("actual %s entrypoint writes and logs exactly one matching step", async phase => {
+  const root = await mkdtemp(join(tmpdir(), "audit-single-emission-"));
+  const artifactsDir = join(root, ".audit-tools/audit");
+  const write = vi.spyOn(auditSteps, "writeCurrentStep");
+  const log = vi.spyOn(console, "log").mockImplementation(() => {});
+  try {
+    if (phase === "host") await fixedAuditFlowRun(root);
+    if (phase === "complete") {
+      const f = await finalizationRun(root);
+      await drawAuditRun(f.store, "full", 16);
+    }
+    if (phase !== "preflight") await readyCliPreflight(root, artifactsDir);
+    await cmdNextStep(["--root", root, "--artifacts-dir", artifactsDir]);
+    expect(write).toHaveBeenCalledTimes(1);
+    expect(log).toHaveBeenCalledTimes(1);
+    const step = JSON.parse(String(log.mock.calls[0]![0]));
+    expect(step).toEqual(await write.mock.results[0]!.value);
+    expect(step).toEqual(JSON.parse(await readFile(join(artifactsDir, "steps/current-step.json"), "utf8")));
+    expect(step.step_kind).toBe(phase === "preflight" ? "functional_preflight" : phase === "host" ? "critical_flow_fallback" : "present_report");
+  } finally { write.mockRestore(); log.mockRestore(); await rm(root, { recursive: true, force: true }); }
+});
+
+test("fatal entrypoint failure emits one blocked contract and never logs a success step", async () => {
+  const root = await mkdtemp(join(tmpdir(), "audit-blocked-emission-"));
+  const artifactsDir = join(root, ".audit-tools/audit");
+  const blocked = vi.spyOn(stepContractWriter, "writeBlockedStepContract");
+  const write = vi.spyOn(auditSteps, "writeCurrentStep");
+  const log = vi.spyOn(console, "log").mockImplementation(() => {});
+  try {
+    await mkdir(artifactsDir, { recursive: true });
+    await readyCliPreflight(root, artifactsDir);
+    await writeFile(join(artifactsDir, "audit_state.json"), "{}");
+    await expect(cmdNextStep(["--root", root, "--artifacts-dir", artifactsDir])).rejects.toThrow(/no implicit migration/i);
+    expect(blocked).toHaveBeenCalledTimes(1);
+    expect(write).not.toHaveBeenCalled(); expect(log).not.toHaveBeenCalled();
+    const step = JSON.parse(await readFile(join(artifactsDir, "steps/current-step.json"), "utf8"));
+    expect(step.status).toBe("blocked");
+    expect(await readFile(step.prompt_path, "utf8")).toMatch(/no implicit migration/i);
+  } finally { blocked.mockRestore(); write.mockRestore(); log.mockRestore(); await rm(root, { recursive: true, force: true }); }
 });
