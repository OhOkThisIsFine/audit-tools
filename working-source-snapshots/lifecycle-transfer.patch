+/** Fixed domain evidence for shared-lifecycle adapter tests. No model, provider, or analyzer runs. */
+import { join } from "node:path";
+import type { AuditTask } from "../../../src/audit/types.js";
+import { createRunState } from "../../../src/shared/engine/taskLifecycle.js";
+import { createLifecycleIO, createRunStore } from "../../../src/shared/engine/taskLifecycleStore.js";
+import type { DrawPolicy } from "../../../src/shared/engine/taskLifecycleTypes.js";
+import { createAuditPolicy } from "../../../src/audit/lifecycle/auditPolicy.js";
+import { parseAuditDomain, type AuditDomain } from "../../../src/audit/lifecycle/auditDomain.js";
+import { preparationTask, type AuditSource } from "../../../src/audit/lifecycle/preparationTasks.js";
+
+export async function fixedAuditFlowRun(root: string) {
+  const artifactsDir = join(root, ".audit-tools", "audit");
+  const io = createLifecycleIO(artifactsDir);
+  const bundle = { critical_flows: { flows: [], fallback_required: true } };
+  const bundleRef = await io.writeArtifact(bundle);
+  const source = await io.writeArtifact({ repository_root: root, source_root: root, artifacts_dir: artifactsDir,
+    options: { analyzers: { typescript: "skip", python: "skip", css: "skip", html: "skip", sql: "skip" }, externalAcquisition: { enabled: false } },
+  } satisfies AuditSource);
+  const domain: AuditDomain = { repository_root: root, source_root: root, artifacts_dir: artifactsDir,
+    preparation: bundle, line_index: {}, narrative_enabled: false };
+  const original = createAuditPolicy();
+  const policy: DrawPolicy<AuditDomain> = { ...original, initialTasks: () => [{ ...preparationTask("flow"), inputs: { bundle: bundleRef } }] };
+  const initialState = createRunState({ run_id: "fixed-flow-run", mode: "audit", source, domain }, policy);
+  const store = createRunStore({ directory: artifactsDir, initialState, parseDomain: parseAuditDomain });
+  await store.read();
+  return { store, policy, artifactsDir };
+}
+
+/** Fixed fine-plan checkpoint used only to test immutable runtime invariants. */
+export async function fixedAuditInspectionRun(root: string, options: { artifactsDir?: string; groups?: string[][]; dependencies?: Record<string, string[]>; taskOverrides?: Pick<AuditTask, "priority" | "lens"> } = {}) {
+  const { writeFile } = await import("node:fs/promises");
+  const { hashContent } = await import("../../../src/shared/hash.js");
+  const { inspectionSpec } = await import("../../../src/audit/lifecycle/auditDomain.js");
+  const artifactsDir = options.artifactsDir ?? join(root, ".audit-tools", "audit");
+  const groups = options.groups ?? [["a.ts"], ["b.ts"]];
+  const paths = [...new Set(groups.flat())];
+  const files = await Promise.all(paths.map(async path => {
+    const content = `export const value = ${JSON.stringify(path)};\n`;
+    await writeFile(join(root, path), content);
+    return { path, language: "TypeScript", hash: hashContent(content), size_bytes: Buffer.byteLength(content) };
+  }));
+  const io = createLifecycleIO(artifactsDir);
+  const source = await io.writeArtifact({ repository_root: root, source_root: root, artifacts_dir: artifactsDir, options: {} } satisfies AuditSource);
+  const basis = await io.writeArtifact({ source, fixed: "full preparation joined", files });
+  const domain: AuditDomain = { repository_root: root, source_root: root, artifacts_dir: artifactsDir,
+    preparation: { repo_manifest: { repository: { name: "fixed-inspection" }, generated_at: "2026-01-01T00:00:00Z", files } },
+    line_index: Object.fromEntries(paths.map(path => [path, 1])), narrative_enabled: false };
+  const policy = createAuditPolicy();
+  const state = createRunState({ run_id: "fixed-inspection-run", mode: "audit", source, domain }, { ...policy, initialTasks: () => [] });
+  state.phase = "executing"; state.basis = basis;
+  groups.forEach((group, index) => {
+    const spec = inspectionSpec({ task_id: `inspect-${index}`, unit_id: `unit-${index}`, pass_id: "base", lens: "correctness",
+      file_paths: group, file_line_counts: Object.fromEntries(group.map(path => [path, 1])), rationale: "Fixed bounded inspection", priority: "low", ...options.taskOverrides }, basis,
+      (options.dependencies?.[`inspect-${index}`] ?? []).map(task_id => ({ task_id, requires: "completed_required_scope" })));
+    state.tasks[spec.id] = { spec, status: "pending", attempt: 0 };
+  });
+  const store = createRunStore({ directory: artifactsDir, initialState: state, parseDomain: parseAuditDomain });
+  await store.read();
+  return { store, policy, artifactsDir, basis, source };
+}
+
+export async function writeAuditInspectionSubmission<Domain>(store: import("../../../src/shared/engine/taskLifecycleTypes.js").RunStore<Domain>, task: import("../../../src/shared/engine/taskLifecycleTypes.js").IssuedTask,
+  paths?: string[], outcome: import("../../../src/shared/engine/taskLifecycleTypes.js").TaskSubmission["outcome"] = "complete") {
+  const { writeFile } = await import("node:fs/promises");
+  const { inspectionSubject } = await import("../../../src/audit/lifecycle/auditDomain.js");
+  const payload = { file_coverage: (paths ?? inspectionSubject(task.spec).task.file_paths).map(path => ({ path, total_lines: 1 })), findings: [], reviewed_clean: true };
+  const submission = { contract_version: "audit-tools-task-result/v1", run_id: task.run_id, task_id: task.spec.id, attempt: task.attempt, binding_sha256: task.binding_sha256, outcome, payload };
+  await writeFile(join(store.io.directory, task.result_path), JSON.stringify(submission));
+  return task.result_path;
+}
