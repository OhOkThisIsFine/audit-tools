@@ -0,0 +1,50 @@
+import { spawnHidden } from '../helpers/spawn.mjs';
+import { readFile, stat, utimes } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { expect, test } from 'vitest';
+import { acquireLock, FileLockTimeoutError, releaseLock, STALE_LOCK_MS, withFileLock } from '../../src/shared/io/fileLock.js';
+import { withTempDir, tmpLockPath } from './fileLockTestSupport.mjs';
+
+test('age alone never steals a live acquireLock owner without a heartbeat', async () => {
+  await withTempDir(async (dir: string) => {
+    const path = tmpLockPath(dir);
+    const token = await acquireLock(path);
+    const past = new Date(Date.now() - STALE_LOCK_MS * 2);
+    await utimes(path, past, past);
+    try {
+      await expect(acquireLock(path, 100)).rejects.toBeInstanceOf(FileLockTimeoutError);
+      expect(await readFile(path, 'utf8')).toBe(token);
+    } finally { await releaseLock(path, token); }
+  });
+});
+
+test('a real 31.5-second event-loop stall never admits a second live callback', async () => {
+  await withTempDir(async (dir: string) => {
+    const path = tmpLockPath(dir);
+    const child = spawnHidden(process.execPath, ['--import', 'tsx/esm', fileURLToPath(new URL('./fixtures/file-lock-owner-worker.mjs', import.meta.url)), 'stall', path], {
+      stdio: ['ignore', 'ignore', 'pipe', 'ipc'],
+    });
+    const events: unknown[] = [];
+    let stderr = '';
+    child.stderr?.on('data', chunk => { stderr += String(chunk); });
+    let entered!: () => void;
+    const entry = new Promise<void>(resolve => { entered = resolve; });
+    child.on('message', message => { events.push(message); if (message === 'entered') entered(); });
+    const exit = new Promise<number | null>((resolve, reject) => { child.on('error', reject); child.on('exit', resolve); });
+    const watchdog = setTimeout(() => child.kill(), STALE_LOCK_MS + 15_000);
+    try {
+      await Promise.race([entry, exit.then(() => { throw new Error(`Owner exited before entry: ${stderr}`); })]);
+      const mtime = (await stat(path)).mtimeMs;
+      await new Promise(resolve => setTimeout(resolve, Math.max(0, mtime + STALE_LOCK_MS + 100 - Date.now())));
+      let secondEntered = false;
+      await expect(withFileLock(path, async () => { secondEntered = true; }, 300)).rejects.toBeInstanceOf(FileLockTimeoutError);
+      expect(secondEntered).toBe(false);
+    } finally {
+      if (child.connected) child.send('release');
+      const code = await exit;
+      clearTimeout(watchdog);
+      expect(code, stderr).toBe(0);
+    }
+    expect(events).toEqual(['entered', 'resumed', 'ownership-retained']);
+  });
+}, 50_000);
