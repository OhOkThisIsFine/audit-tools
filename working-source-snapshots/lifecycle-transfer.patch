+    await expect(readFile(join(artifactsDir, "operator-lifecycle.json"))).rejects.toMatchObject({ code: "ENOENT" });
+  });
+
+  it("preserves and refuses unknown checkpoints rather than adopting old status fields", async () => {
+    const { root, artifactsDir } = await fixture();
+    const { mkdir } = await import("node:fs/promises");
