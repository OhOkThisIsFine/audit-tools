+/** Fixed prepared evidence through the real audit policy; no model, analyzer or trial audit. */
+import { dirname, join } from "node:path";
+import { mkdir, writeFile, readFile } from "node:fs/promises";
+import { resolveWithinRoot } from "../../../src/shared/io/pathContainment.js";
+import { createRunState, advanceRun, acceptSubmission } from "../../../src/shared/engine/taskLifecycle.js";
+import { createLifecycleIO, createRunStore } from "../../../src/shared/engine/taskLifecycleStore.js";
+import type { IssuedTask, RunStore } from "../../../src/shared/engine/taskLifecycleTypes.js";
+import { createAuditPolicy } from "../../../src/audit/lifecycle/auditPolicy.js";
+import { parseAuditDomain, type AuditDomain } from "../../../src/audit/lifecycle/auditDomain.js";
+import { preparationFacts, preparationTask, PREPARATION_STAGES, type AuditSource } from "../../../src/audit/lifecycle/preparationTasks.js";
+import type { AdvanceAuditOptions } from "../../../src/audit/orchestrator/advanceTypes.js";
+import type { ArtifactBundle } from "../../../src/audit/io/artifacts.js";
+export async function seedPreparation(root: string, bundle: ArtifactBundle, stage: typeof PREPARATION_STAGES[number], artifactsDir = join(root, ".audit-tools", "audit"), sourceOptions: AdvanceAuditOptions = {}, sourceExtras: Pick<AuditSource, "initial_guidance"> = {}) {
+  // The fixtures describe source paths. Materialize absent fixture bodies, never launch analyzers.
+  for (const file of bundle.repo_manifest?.files ?? []) {
+    const path = resolveWithinRoot(root, file.path, { allowRoot: false });
+    if (path === null) throw new Error("Fixture source must remain beneath its temporary root");
+    try { await readFile(path); } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+      await mkdir(dirname(path), { recursive: true });
+      await writeFile(path, `// Fixed test source: ${file.path}\n`);
+    }
+  }
+  const io = createLifecycleIO(artifactsDir);
+  const options: AdvanceAuditOptions = { analyzers: { typescript: "skip" as const, python: "skip" as const, css: "skip" as const, html: "skip" as const, sql: "skip" as const }, externalAcquisition: { enabled: false }, ...sourceOptions };
+  const source = await io.writeArtifact({ ...sourceExtras, repository_root: root, source_root: root, artifacts_dir: artifactsDir, options });
+  const facts = preparationFacts(bundle), bundleRef = await io.writeArtifact(facts);
+  const task = { ...preparationTask(stage), inputs: { bundle: bundleRef } };
+  const policy = createAuditPolicy();
+  const state = createRunState({ run_id: "fixed-preparation", mode: "audit", source, domain: { repository_root: root, source_root: root, artifacts_dir: artifactsDir,
+    preparation: facts, preparation_options: options, line_index: {}, narrative_enabled: false } }, { ...policy, initialTasks: () => [task] });
+  const store = createRunStore({ directory: artifactsDir, initialState: state, parseDomain: parseAuditDomain });
+  await store.read();
+  return { store, policy, artifactsDir };
+}
+export async function issuePreparation(root: string, bundle: ArtifactBundle, stage: typeof PREPARATION_STAGES[number], artifactsDir?: string, sourceOptions: AdvanceAuditOptions = {}, sourceExtras: Pick<AuditSource, "initial_guidance"> = {}) {
+  const fixture = await seedPreparation(root, bundle, stage, artifactsDir, sourceOptions, sourceExtras);
+  const step = await advanceRun(fixture.store, fixture.policy, { draw: "full", maxExecutions: 16 });
+  return { ...fixture, tasks: step.tasks, state: step.state };
+}
+export async function submitPreparation(store: RunStore<AuditDomain>, task: IssuedTask, result: unknown, independent = true) {
+  await mkdir(join(store.io.directory, task.result_path, ".."), { recursive: true });
+  await writeFile(join(store.io.directory, task.result_path), JSON.stringify({ contract_version: "audit-tools-task-result/v1", run_id: task.run_id, task_id: task.spec.id,
+    attempt: task.attempt, binding_sha256: task.binding_sha256, outcome: "complete", payload: independent ? { review: { mode: "independent", reason: "Fixed separate reviewer evidence" }, result } : result }));
+  return acceptSubmission(store, task.result_path, createAuditPolicy());
+}
