diff --git a/tests/shared/fileLockOwnerTestSupport.ts b/tests/shared/fileLockOwnerTestSupport.ts
new file mode 100644
index 00000000..9b17f8cb
--- /dev/null
+++ b/tests/shared/fileLockOwnerTestSupport.ts
@@ -0,0 +1,37 @@
+import { spawnHidden } from '../helpers/spawn.mjs';
+import { readFile, utimes } from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { STALE_LOCK_MS } from '../../src/shared/io/fileLock.js';
+
+/** Only this test's own child creates the abandoned record; await its exit first. */
+export async function abandonedLock(path: string): Promise<string> {
+  const child = spawnHidden(process.execPath, ['--import', 'tsx/esm', fileURLToPath(new URL('./fixtures/file-lock-owner-worker.mjs', import.meta.url)), 'abandon', path], {
+    stdio: ['ignore', 'ignore', 'pipe', 'ipc'],
+  });
+  let stderr = '';
+  child.stderr?.on('data', chunk => { stderr += String(chunk); });
+  const watchdog = setTimeout(() => child.kill(), 10_000);
+  try {
+    const code = await new Promise<number | null>((resolve, reject) => {
+      child.on('error', reject); child.on('exit', resolve);
+    });
+    if (code !== 0) throw new Error(`Owned lock child failed: ${stderr}`);
+    const past = new Date(Date.now() - STALE_LOCK_MS * 2);
+    await utimes(path, past, past);
+    return await readFile(path, 'utf8');
+  } finally { clearTimeout(watchdog); }
+}
+
+/** Independent environment observation: never derive expected recovery from produced metadata. */
+export async function automaticRecoveryAvailable(path: string): Promise<boolean> {
+  if (process.platform !== 'linux') return false;
+  const { statfs, readlink } = await import('node:fs/promises');
+  try {
+    const boot = (await readFile('/proc/sys/kernel/random/boot_id', 'utf8')).trim();
+    const namespace = await readlink('/proc/self/ns/pid');
+    const type = Number((await statfs(path)).type) >>> 0;
+    return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(boot) &&
+      /^pid:\[\d+\]$/.test(namespace) &&
+      new Set([0xEF53, 0x58465342, 0x9123683E, 0x01021994, 0x794c7630]).has(type);
+  } catch { return false; }
+}
